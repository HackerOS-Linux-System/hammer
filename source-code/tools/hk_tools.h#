;; hammer -> tools::hk_tools
;;
;; Port of source-code/tools/hk_tools.rs (Rust) to H#: instalacja i
;; aktualizacja narzedzi HackerOS opisanych plikami `.hk` w
;; /etc/hammer/HackerOS (+ preprocessor wieloliniowych wartosci, `!include`
;; i walidacja schematu: `hammer hk validate`).
;;
;; ── Odejscia od oryginalu (swiadome, udokumentowane) ────────────────────
;; 1. `.hk` czyta biblioteka `hk-parser` z bit.io przez `hkp::HkConfig`
;;    (sciezki kropkowe `sekcja.klucz`), a NIE `IndexMap<String, HkValue>`
;;    z crate'u Rusta. `HkToolSpec::load` szuka klucza plaskiego, a potem w
;;    kazdej sekcji (`cfg.keys("")`) — jak w Rust (`flat`, potem `sectioned`).
;;    Interpolacje (`resolve_interpolations`) robi `cfg.resolve()`.
;; 2. `async`/`HttpClient` -> `curl -fsSL` do pliku. GitHub API:
;;    naglowki `User-Agent: hammer/<wersja>` i `Accept` jak w Rust.
;; 3. `anyhow::Result<T>` -> `string` ("" = OK) albo struktury z polem `err`;
;;    `Ok(bool)` z `update_tool` -> `UpdateResult { updated, err }`.
;; 4. `load_hk_file_full` (include + preprocess + parse) -> `load_hk_full(path)`
;;    zwraca `HkLoad { cfg, err }`; plik tymczasowy usuwany zawsze.
;; 5. Walidacja (`validate_tool_hk`): "pusty klucz" sprawdzany tylko dla
;;    typu string (`cfg.type_of(key) == "string"`), jak `HkValue::String`.
;; 6. ZACHOWANE BLEDY ORYGINALU:
;;    a) `KNOWN_TOOL_KEYS` NIE zawiera kluczy, ktorych uzywa `HkToolSpec::load`
;;       (`releases`, `binaries`, `dirs`, `desc`) — `hammer hk validate` na
;;       prawdziwym pliku narzedzia zglosi je jako "Unknown key", a
;;       `REQUIRED_TOOL_KEYS` wymaga `github_repo`, ktorego `load` nie czyta
;;       (czyta `releases`). Schemat i loader sie rozjezdzaja.
;;    b) `preprocess_hk_source`: licznik nawiasow nie rozroznia nawiasow w
;;       napisach ("(" w opisie) — zlicza `[`/`(` i `]`/`)` w calej linii.
;;    c) `update_tool` porownuje tagi po zdjeciu jednego poczatkowego `v`.
;; 7. Testy z Rusta (`multiline_tests`) przeniesione do `self_test()`.

pub fn hk_tools_dir() -> string is return "/etc/hammer/HackerOS" end
fn hk_versions_dir() -> string is return "/hammer/db/hk_tools" end
fn hk_store_dir() -> string is return "/hammer/hk_store" end
fn hk_hidden_dir() -> string is return "/usr/lib/hammer" end
fn hk_public_bin() -> string is return "/usr/bin" end
fn desktop_dir() -> string is return "/usr/share/applications" end

fn shq(s: string) -> string is
    return "'" + str::replace_all(s, "'", "'\\''") + "'"
end

fn sh_ok(cmd: string) -> bool is
    return str::trim(proc::shell("(" + cmd + ") >/dev/null 2>&1 && echo ok || echo fail")) == "ok"
end

fn mkdir_p(p: string) -> bool is
    proc::shell("mkdir -p " + shq(p))
    return fs::is_dir(p)
end

fn contains_str(xs: [string], s: string) -> bool is
    let mut i: int = 0
    while i < xs.len() is
        if xs[i] == s is return true end
        i += 1
    end
    return false
end

