fn known_tool_keys() -> [string] is
    return ["name", "description", "github_repo", "releases_url", "binary", "binary_glob", "hidden", "is_gui",
        "desktop_file", "default_install_dir", "verify_sha256", "post_install", "pre_install", "depends_on"]
end

fn known_sources_keys() -> [string] is
    return ["name", "baseurl", "suite", "components", "arch", "enabled", "gpgkey", "type", "priority"]
end

fn required_tool_keys() -> [string] is return ["name", "github_repo"] end
fn required_sources_keys() -> [string] is return ["name", "baseurl", "suite", "components"] end

pub struct SchemaError is
    pub file:     string
    pub errors:   [string]
    pub warnings: [string]
    ;; blad ladowania (plik/parser); "" = OK
    pub err:      string
end

pub fn validate_tool_hk(path: string) -> SchemaError is
    let none: [string] = []
    if !fs::exists(path) is return SchemaError { file: path, errors: none, warnings: none, err: "Reading " + path } end
    let normalised: string = preprocess_hk_source(fs::read(path))
    let tmp: string = fs::temp_file("hammer_hk_validate")
    if !fs::write(tmp, normalised) is return SchemaError { file: path, errors: none, warnings: none, err: "Cannot write " + tmp } end
    let cfg: hkp::HkConfig = hkp::parse_file(tmp)
    fs::remove(tmp)
    if !cfg.is_valid() is
        return SchemaError { file: path, errors: none, warnings: none, err: "Parsing .hk: " + hkp::last_error() }
    end

    let mut errors: [string] = []
    let mut warnings: [string] = []
    let keys: [string] = cfg.keys("")
    let req: [string] = required_tool_keys()
    let mut i: int = 0
    while i < req.len() is
        let present: bool = contains_str(keys, req[i])
        let mut missing: bool = !present
        if present && cfg.type_of(req[i]) == "string" is
            missing = str::trim(cfg.get(req[i])) == ""
        end
        if missing is errors.push("Missing required key: '" + req[i] + "'") end
        i += 1
    end
    let known: [string] = known_tool_keys()
    let mut k: int = 0
    while k < keys.len() is
        if !contains_str(known, keys[k]) is warnings.push("Unknown key '" + keys[k] + "' (will be ignored)") end
        k += 1
    end
    return SchemaError { file: path, errors: errors, warnings: warnings, err: "" }
end

fn flush_section(section: string, keys: [string], errors: [string], warnings: [string]) -> [[string]] is
    let mut e: [string] = errors
    let mut w: [string] = warnings
    let req: [string] = required_sources_keys()
    let mut i: int = 0
    while i < req.len() is
        if !contains_str(keys, req[i]) is e.push("[" + section + "] missing required key '" + req[i] + "'") end
        i += 1
    end
    let known: [string] = known_sources_keys()
    let mut k: int = 0
    while k < keys.len() is
        if !contains_str(known, keys[k]) is w.push("[" + section + "] unknown key '" + keys[k] + "' (ignored)") end
        k += 1
    end
    return [e, w]
end

pub fn validate_sources_hk(path: string) -> SchemaError is
    let none: [string] = []
    if !fs::exists(path) is return SchemaError { file: path, errors: none, warnings: none, err: "Reading " + path } end
    let lines: [string] = source_lines(fs::read(path))
    let mut errors: [string] = []
    let mut warnings: [string] = []
    let mut current: string = ""
    let mut have_section: bool = false
    let mut section_keys: [string] = []

    let mut i: int = 0
    while i < lines.len() is
        let line: string = str::trim(lines[i])
        if string_starts_with(line, "!") || line == "" is
            i += 1
        elsif string_starts_with(line, "[") && string_ends_with(line, "]") is
            if have_section is
                let r: [[string]] = flush_section(current, section_keys, errors, warnings)
                errors = r[0]
                warnings = r[1]
            end
            current = str::slice(line, 1, string_len(line) - 1)
            have_section = true
            section_keys = []
            i += 1
        else is
            if compat::str_index_of(line, "=>") >= 0 is
                let left: string = str::trim(str::slice(line, 0, compat::str_index_of(line, "=>")))
                let mut key: string = left
                while string_starts_with(key, "->") is
                    key = str::slice(key, 2, string_len(key))
                end
                let kk: string = str::trim(key)
                if !contains_str(section_keys, kk) is section_keys.push(kk) end
            end
            i += 1
        end
    end
    if have_section is
        let r2: [[string]] = flush_section(current, section_keys, errors, warnings)
        errors = r2[0]
        warnings = r2[1]
    end
    return SchemaError { file: path, errors: errors, warnings: warnings, err: "" }
end

;; `hammer hk validate <file.hk>`
pub fn cmd_validate_hk(args: [string]) -> string is
    if args.len() == 0 is return "Usage: hammer hk validate <file.hk>" end
    let path: string = args[0]
    if !fs::exists(path) is return "No such file: " + path end

    ;; typ pliku wg tresci: linia zaczynajaca sie od `->` => sources-list
    let mut is_sources: bool = false
    let lines: [string] = source_lines(fs::read(path))
    let mut i: int = 0
    while i < lines.len() is
        if string_starts_with(str::trim(lines[i]), "->") is is_sources = true end
        i += 1
    end
    let result: SchemaError = if is_sources then validate_sources_hk(path) else validate_tool_hk(path)
    if result.err != "" is return result.err end

    if result.errors.len() == 0 && result.warnings.len() == 0 is
        write("  " + ui::bright_green_bold("✔") + "  " + path + " — valid")
        return ""
    end
    let mut w: int = 0
    while w < result.warnings.len() is
        write("  " + ui::yellow("⚠") + "  " + ui::yellow(result.warnings[w]))
        w += 1
    end
    let mut e: int = 0
    while e < result.errors.len() is
        write("  " + ui::red_bold("✗") + "  " + ui::red(result.errors[e]))
        e += 1
    end
    if result.errors.len() > 0 is return "Schema validation failed for " + path end
    return ""
end

;; ── Testy (z multiline_tests / include_tests) ────────────────────────────

fn t_text(label: string, got: string, want: string) -> int is
    if got == want is return 0 end
    write("hk_tools::self_test FAIL: " + label + " got [" + got + "] want [" + want + "]")
    return 1
end

fn t_int(label: string, got: int, want: int) -> int is
    if got == want is return 0 end
    write("hk_tools::self_test FAIL: " + label + " got " + to_string(got) + " want " + to_string(want))
    return 1
end

;; Zwraca liczbe niezdanych przypadkow (czyste funkcje; bez plikow i parsera).
pub fn self_test() -> int is
    let mut f: int = 0
    let single: string = "components => [\"main\", \"contrib\"]\n"
    f += t_text("single line unchanged", preprocess_hk_source(single), single)

    let multi: string = preprocess_hk_source("components => [\"main\",\n               \"contrib\",\n               \"non-free\"]\n")
    f += t_int("multiline array -> 1 line", source_lines(multi).len(), 1)
    f += t_int("multiline keeps non-free", if compat::str_index_of(multi, "non-free") >= 0 then 1 else 0, 1)

    let cont: string = preprocess_hk_source("description => very long \\\n              value here\n")
    f += t_int("backslash continuation -> 1 line", source_lines(cont).len(), 1)
    f += t_int("continuation has value here", if compat::str_index_of(cont, "value here") >= 0 then 1 else 0, 1)

    let cm: string = preprocess_hk_source("! comment line\nname => hello\n")
    f += t_int("comment preserved", if compat::str_index_of(cm, "! comment line") >= 0 then 1 else 0, 1)
    f += t_int("name preserved", if compat::str_index_of(cm, "name => hello") >= 0 then 1 else 0, 1)

    let nested: string = preprocess_hk_source("opts => {{\"a\": [1,\n2,\n3]}}\n")
    f += t_int("nested brackets -> 1 line", source_lines(nested).len(), 1)

    f += t_text("github repo", if extract_github_repo("https://github.com/Owner/Repo/releases/") == nil then "nil" else extract_github_repo("https://github.com/Owner/Repo/releases/"), "Owner/Repo")
    f += t_int("github repo non-github", if extract_github_repo("https://example.com/a/b") == nil then 1 else 0, 1)
    f += t_text("blob to raw", github_blob_to_raw("https://github.com/o/r/blob/main/x.desktop"), "https://raw.githubusercontent.com/o/r/main/x.desktop")
    f += t_text("json string", extract_json_string("{{\"tag_name\": \"v1.2.3\", \"x\": 1}}", "tag_name"), "v1.2.3")
    f += t_text("json missing", extract_json_string("{{\"a\": 1}}", "tag_name"), "")
    f += t_text("normalize tag", normalize_tag("v2.0"), "2.0")
    f += t_text("asset url", asset_url("o/r", "v1", "bin"), "https://github.com/o/r/releases/download/v1/bin")
    return f
end
