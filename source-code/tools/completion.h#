;; ── Bash ─────────────────────────────────────────────────────────────────

fn bash_lines(cmds: string, global_flags: string, cmd_spec: string) -> [string] is
    return [
    "# hammer bash completion — auto-generated by `hammer completion bash`",
    "        # Install: source this file or place in /etc/bash_completion.d/hammer",
    "",
    "        _hammer_packages() {{",
    "        # Complete from installed packages via hammer list --installed",
    "        local pkgs",
    "        pkgs=$(hammer list --installed 2>/dev/null | awk '{{print $2}}' | grep -v '^$')",
    "        echo \"$pkgs\"",
    "}}",
    "",
    "_hammer_all_packages() {{",
    "# Complete from cache (may be slow for large repos)",
    "hammer list 2>/dev/null | awk '{{print $2}}' | grep -v '^$'",
    "}}",
    "",
    "_hammer_gens() {{",
    "hammer gen list 2>/dev/null | grep -oP 'gen-\\K[0-9]+' || true",
    "}}",
    "",
    "_hammer_services() {{",
    "hammer service list 2>/dev/null | tail -n +5 | awk '{{print $1}}' | grep '\\.service$'",
    "}}",
    "",
    "_hammer() {{",
    "local cur prev words cword",
    "_init_completion || return",
    "",
    "local commands=\"{cmds}\"",
    "",
    "case \"${{cword}}\" in",
    "1)",
    "        COMPREPLY=( $(compgen -W \"$commands\" -- \"$cur\") )",
    "        return 0",
    "        ;;",
    "        esac",
    "",
    "        case \"${{words[1]}}\" in",
    "        install|reinstall|upgrade|info|show-deps|files|why|why-not|changelog)",
    "        # Complete with all available packages",
    "        COMPREPLY=( $(compgen -W \"$(_hammer_all_packages)\" -- \"$cur\") )",
    "        ;;",
    "        remove|autoremove|pin)",
    "        # Complete with installed packages only",
    "        COMPREPLY=( $(compgen -W \"$(_hammer_packages)\" -- \"$cur\") )",
    "        ;;",
    "        gen)",
    "        case \"${{cword}}\" in",
    "        2) COMPREPLY=( $(compgen -W \"list switch\" -- \"$cur\") ) ;;",
    "        3) COMPREPLY=( $(compgen -W \"$(_hammer_gens)\" -- \"$cur\") ) ;;",
    "        esac",
    "        ;;",
    "        service)",
    "        case \"${{cword}}\" in",
    "        2) COMPREPLY=( $(compgen -W \"list start stop restart reload enable disable status log\" -- \"$cur\") ) ;;",
    "        *) COMPREPLY=( $(compgen -W \"$(_hammer_services)\" -- \"$cur\") ) ;;",
    "        esac",
    "        ;;",
    "        key)",
    "        COMPREPLY=( $(compgen -W \"list add remove\" -- \"$cur\") )",
    "        ;;",
    "        pending)",
    "        COMPREPLY=( $(compgen -W \"show cancel apply-live\" -- \"$cur\") )",
    "        ;;",
    "        immutable)",
    "        COMPREPLY=( $(compgen -W \"status enable disable unlock install-service\" -- \"$cur\") )",
    "        ;;",
    "        etc)",
    "        case \"${{cword}}\" in",
    "        2) COMPREPLY=( $(compgen -W \"diff reset show\" -- \"$cur\") ) ;;",
    "        *) _filedir ;;",
    "        esac",
    "        ;;",
    "        pin)",
    "        case \"${{cword}}\" in",
    "        2) COMPREPLY=( $(compgen -W \"list add remove hold unhold\" -- \"$cur\") ) ;;",
    "        3) COMPREPLY=( $(compgen -W \"$(_hammer_packages)\" -- \"$cur\") ) ;;",
    "        esac",
    "        ;;",
    "        owns)",
    "        _filedir",
    "        ;;",
    "        diff)",
    "        COMPREPLY=( $(compgen -W \"$(_hammer_gens)\" -- \"$cur\") )",
    "        ;;",
    "        completion)",
    "        COMPREPLY=( $(compgen -W \"bash zsh fish install\" -- \"$cur\") )",
    "        ;;",
    "        *)",
    "        COMPREPLY=( $(compgen -W \"{global_flags}\" -- \"$cur\") )",
    "        ;;",
    "        esac",
    "}}",
    "",
    "complete -F _hammer hammer",
    ""]
end


fn bash_completion() -> string is
    let cmds: string = str::join(cmd_names(), " ")
    ;; lokalna zmienna nie moze nazywac sie jak funkcja `global_flags()` (kodegen H# myli wtedy
    ;; wywolanie `str::join(global_flags(), ..)` => "undefined fn: join")
    let gflags: string = str::join(global_flags(), " ")
    return str::join(bash_lines(cmds, gflags, ""), "\n")
end

;; ── Zsh ──────────────────────────────────────────────────────────────────

fn zsh_lines(cmds: string, global_flags: string, cmd_spec: string) -> [string] is
    return [
    "#compdef hammer",
    "        # hammer zsh completion — auto-generated by `hammer completion zsh`",
    "        # Install: place in a directory on $fpath, e.g. /usr/share/zsh/vendor-completions/_hammer",
    "",
    "        _hammer() {{",
    "        local context state state_descr line",
    "        typeset -A opt_args",
    "",
    "        local -a commands",
    "        commands=(",
    "            {cmd_spec}    )",
    "",
    "        local -a global_flags",
    "        global_flags=(",
    "            '--user[Operate on user packages]'",
    "    '--arch=[Target architecture]:arch:(amd64 arm64 armhf i386)'",
    "    '--yes[Assume yes to all prompts]'",
    "    '--no-recommends[Skip recommended packages]'",
    "    '--json[Output in JSON format]'",
    "    )",
    "",
    "        _arguments -C \\",
    "        $global_flags \\",
    "        '1:command:->command' \\",
    "        '*::args:->args' && return 0",
    "",
    "        case $state in",
    "        command)",
    "        _describe 'hammer commands' commands",
    "        ;;",
    "        args)",
    "        case $words[1] in",
    "        install|reinstall|upgrade|info|show-deps|files|why|why-not|changelog)",
    "        local pkgs",
    "        pkgs=(${{(f)\"$(hammer list 2>/dev/null | awk '{{print $2}}')\"}})",
    "        _describe 'packages' pkgs",
    "        ;;",
    "        remove|autoremove)",
    "        local pkgs",
    "        pkgs=(${{(f)\"$(hammer list --installed 2>/dev/null | awk '{{print $2}}')\"}})",
    "        _describe 'installed packages' pkgs",
    "        ;;",
    "        gen)",
    "        local subcmds; subcmds=(list switch)",
    "        if (( CURRENT == 2 )); then",
    "            _describe 'gen subcommands' subcmds",
    "            else",
    "                local gens",
    "                gens=(${{(f)\"$(hammer gen list 2>/dev/null | grep -oP 'gen-\\K[0-9]+')\"}})",
    "        _describe 'generations' gens",
    "        fi",
    "        ;;",
    "        service)",
    "        local subcmds; subcmds=(list start stop restart reload enable disable status log)",
    "        if (( CURRENT == 2 )); then",
    "            _describe 'service subcommands' subcmds",
    "            else",
    "                local svcs",
    "                svcs=(${{(f)\"$(hammer service list 2>/dev/null | tail -n +5 | awk '{{print $1}}')\"}})",
    "        _describe 'services' svcs",
    "        fi",
    "        ;;",
    "        key)",
    "        local subcmds; subcmds=(list add remove)",
    "        _describe 'key subcommands' subcmds",
    "        ;;",
    "        pin)",
    "        local subcmds; subcmds=(list add remove hold unhold)",
    "        if (( CURRENT == 2 )); then",
    "            _describe 'pin subcommands' subcmds",
    "            else",
    "                local pkgs",
    "                pkgs=(${{(f)\"$(hammer list --installed 2>/dev/null | awk '{{print $2}}')\"}})",
    "        _describe 'packages' pkgs",
    "        fi",
    "        ;;",
    "        etc)",
    "        local subcmds; subcmds=(diff reset show)",
    "        if (( CURRENT == 2 )); then",
    "            _describe 'etc subcommands' subcmds",
    "            else",
    "                _files",
    "                fi",
    "                ;;",
    "            owns)",
    "        _files",
    "        ;;",
    "        completion)",
    "        local shells; shells=(bash zsh fish install)",
    "        _describe 'shells' shells",
    "        ;;",
    "        immutable)",
    "        local subcmds; subcmds=(status enable disable unlock install-service)",
    "        _describe 'immutable subcommands' subcmds",
    "        ;;",
    "        pending)",
    "        local subcmds; subcmds=(show cancel apply-live)",
    "        _describe 'pending subcommands' subcmds",
    "        ;;",
    "        esac",
    "        ;;",
    "        esac",
    "}}",
    "",
    "_hammer \"$@\"",
    ""]
end

fn zsh_completion() -> string is
    let mut cmd_spec: string = ""
    let names: [string] = cmd_names()
    let descs: [string] = cmd_descs()
    let mut i: int = 0
    while i < names.len() is
        cmd_spec = cmd_spec + "    '" + names[i] + ":" + descs[i] + "'\n"
        i += 1
    end
    return str::join(zsh_lines("", "", cmd_spec), "\n")
end

;; ── Fish ─────────────────────────────────────────────────────────────────

fn fish_completion() -> string is
    let mut lines: string = ""
    lines = lines + "# hammer fish completion — auto-generated by `hammer completion fish`\n"
    lines = lines + "# Install: place in ~/.config/fish/completions/hammer.fish\n\n"
    lines = lines + "complete -c hammer -f\n\n"

    let names: [string] = cmd_names()
    let descs: [string] = cmd_descs()
    let mut i: int = 0
    while i < names.len() is
        lines = lines + "complete -c hammer -n '__fish_use_subcommand' -a '" + names[i] + "' -d '" + descs[i] + "'\n"
        i += 1
    end
    lines = lines + "\n"

    let pkg_cmds: [string] = ["install", "reinstall", "upgrade", "info", "show-deps", "files", "why", "why-not", "changelog"]
    let mut p: int = 0
    while p < pkg_cmds.len() is
        lines = lines + "complete -c hammer -n '__fish_seen_subcommand_from " + pkg_cmds[p] + "' -a '(hammer list 2>/dev/null | string match -r \"^. (\\S+)\" | string replace -r \"^. \" \"\")'\n"
        p += 1
    end
    lines = lines + "\n"

    let inst_cmds: [string] = ["remove", "autoremove", "pin"]
    let mut q: int = 0
    while q < inst_cmds.len() is
        lines = lines + "complete -c hammer -n '__fish_seen_subcommand_from " + inst_cmds[q] + "' -a '(hammer list --installed 2>/dev/null | string match -r \"^✔ (\\S+)\" | string replace -r \"^✔ \" \"\")'\n"
        q += 1
    end
    lines = lines + "\n"

    lines = lines + "# gen subcommands\n"
    lines = lines + "complete -c hammer -n '__fish_seen_subcommand_from gen' -a 'list switch' -f\n"
    lines = lines + "# service subcommands\n"
    lines = lines + "complete -c hammer -n '__fish_seen_subcommand_from service' -a 'list start stop restart reload enable disable status log' -f\n"
    lines = lines + "# key subcommands\n"
    lines = lines + "complete -c hammer -n '__fish_seen_subcommand_from key' -a 'list add remove' -f\n"
    lines = lines + "# pin subcommands\n"
    lines = lines + "complete -c hammer -n '__fish_seen_subcommand_from pin' -a 'list add remove hold unhold' -f\n"
    lines = lines + "# pending subcommands\n"
    lines = lines + "complete -c hammer -n '__fish_seen_subcommand_from pending' -a 'show cancel apply-live' -f\n"
    lines = lines + "# immutable subcommands\n"
    lines = lines + "complete -c hammer -n '__fish_seen_subcommand_from immutable' -a 'status enable disable unlock install-service' -f\n"
    lines = lines + "# etc subcommands\n"
    lines = lines + "complete -c hammer -n '__fish_seen_subcommand_from etc' -a 'diff reset show' -f\n"
    lines = lines + "# completion subcommands\n"
    lines = lines + "complete -c hammer -n '__fish_seen_subcommand_from completion' -a 'bash zsh fish install' -f\n"
    lines = lines + "\n"

    lines = lines + "# Global flags\n"
    lines = lines + "complete -c hammer -l user         -d 'Operate on user packages'\n"
    lines = lines + "complete -c hammer -l yes  -s y    -d 'Assume yes'\n"
    lines = lines + "complete -c hammer -l json          -d 'JSON output'\n"
    lines = lines + "complete -c hammer -l no-recommends -d 'Skip recommends'\n"
    lines = lines + "complete -c hammer -l arch -a 'amd64 arm64 armhf i386 riscv64' -d 'Target architecture'\n"
    return lines
end

;; ── Wejscie ──────────────────────────────────────────────────────────────

pub fn cmd_completion(args: [string]) -> string is
    let shell: string = if args.len() > 0 then args[0] else "bash"
    if shell == "bash" is
        io::write_no_nl(bash_completion())
        return ""
    end
    if shell == "zsh" is
        io::write_no_nl(zsh_completion())
        return ""
    end
    if shell == "fish" is
        io::write_no_nl(fish_completion())
        return ""
    end
    if shell == "install" is return install_completions(args) end
    return "Unknown shell '" + shell + "'. Supported: bash, zsh, fish, install"
end

fn shq(s: string) -> string is
    return "'" + str::replace_all(s, "'", "'\\''") + "'"
end

fn write_completion(path: string, content: string) -> string is
    proc::shell("mkdir -p " + shq(compat::path_parent(path)))
    if !fs::write(path, content) is return "Cannot write " + path end
    return ""
end

fn install_completions(args: [string]) -> string is
    let mut shell: string = "all"
    let mut i: int = 0
    while i < args.len() is
        if string_starts_with(args[i], "--shell=") is
            shell = str::slice(args[i], 8, string_len(args[i]))
            i = args.len()
        else is
            i += 1
        end
    end
    let shells: [string] = if shell == "all" then ["bash", "zsh", "fish"] else [shell]

    let mut k: int = 0
    while k < shells.len() is
        let s: string = shells[k]
        if s == "bash" is
            let path: string = "/etc/bash_completion.d/hammer"
            let e: string = write_completion(path, bash_completion())
            if e != "" is return e end
            write("  " + ui::bright_green("✔") + " bash completion → " + path)
        elsif s == "zsh" is
            ;; najpierw systemowy katalog zsh, potem lokalny
            let p1: string = "/usr/share/zsh/vendor-completions/_hammer"
            let p2: string = "/usr/local/share/zsh/site-functions/_hammer"
            let path2: string = if fs::exists(compat::path_parent(p1)) then p1 elsif fs::exists(compat::path_parent(p2)) then p2 else p1
            let e2: string = write_completion(path2, zsh_completion())
            if e2 != "" is return e2 end
            write("  " + ui::bright_green("✔") + " zsh completion  → " + path2)
        elsif s == "fish" is
            let home: string = env::get_or("HOME", "/root")
            let path3: string = compat::path_join(home, ".config/fish/completions/hammer.fish")
            let e3: string = write_completion(path3, fish_completion())
            if e3 != "" is return e3 end
            write("  " + ui::bright_green("✔") + " fish completion → " + path3)
        end
        k += 1
    end
    write("")
    write("  Restart your shell or run " + ui::cyan("exec $SHELL") + " to activate.")
    return ""
end
