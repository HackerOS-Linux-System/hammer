;; hammer -> pkg::query
;;
;; Port of source-code/pkg/query.rs (Rust) to H#: komendy odczytu —
;; why, why-not, show-deps, files, owns, changelog, stats, show, depends,
;; rdepends, which, policy.
;;
;; ── Odejscia od oryginalu (swiadome, udokumentowane) ────────────────────
;; 1. `anyhow::Result<()>` -> `string` ("" = OK, inaczej tresc bledu).
;; 2. `walkdir` -> `find` (jedno wywolanie na pakiet). `cmd_files` sortuje
;;    wyjscie `sort` w locale C (Rust: `sort_by_file_name` sortuje rodzenstwo
;;    w kazdym katalogu — dla zwyklych nazw wynik jest ten sam; roznia sie
;;    tylko nazwy zawierajace znaki mniejsze niz `/`, np. `-`).
;; 3. `cmd_changelog` (async, `HttpClient`) -> `curl`; URL z indeksu Sources
;;    (`build_dep::sources_find_for_binary`), a gdy go brak — heurystyczny.
;; 4. `cmd_show(args, flags)` -> `cmd_show(args, json)`: z `GlobalFlags` uzywane
;;    jest tylko `json`.
;; 5. `HashMap`/`HashSet`/`VecDeque` -> mapy `std -> collections` (tylko
;;    LLVM) + tablice z indeksem glowy.
;; 6. `cmd_which`: `read_dir` + `read_to_string` kazdego `.list` -> jedno
;;    `grep -lxF`. Rust bral PIERWSZY plik w kolejnosci `read_dir` (losowej);
;;    tu pierwszy w kolejnosci alfabetycznej.
;; 7. `{:<22}` -> `fmt::pad_right` na tekscie BEZ kolorow (kolumny rowne).
;; 8. ZACHOWANE: `cmd_show` pokazuje `SHA256` jako pierwsze 16 znakow + `…`
;;    (panika w Rust, gdy skrot krotszy niz 16 znakow; tu `slice` ucina).
;; 9. ZACHOWANE: `cmd_owns` uznaje trafienie, gdy sciezka pakietu ZAWIERA
;;    podany tekst (nie tylko rowna sie) — `hammer owns bin` zwroci kazdy
;;    plik z `bin` w sciezce.

fn shq(s: string) -> string is
    return "'" + str::replace_all(s, "'", "'\\''") + "'"
end

fn append_str(a: [string], x: string) -> [string] is
    let mut o: [string] = a
    o.push(x)
    return o
end

fn contains_str(xs: [string], s: string) -> bool is
    let mut i: int = 0
    while i < xs.len() is
        if xs[i] == s is return true end
        i += 1
    end
    return false
end

fn rule(n: int) -> string is
    return "  " + ui::dim(str::repeat("─", n))
end

fn header(title: string) is
    write("")
    write("  " + ui::accent_bold("⬡") + "  " + title)
end

fn constraint_text(alt: package::DepAlternative) -> string is
    if alt.constraint == nil is return "" end
    let c: package::VersionConstraint = alt.constraint
    return " (" + package::op_to_str(c.op) + " " + c.version + ")"
end

pub struct StrList is
    pub items: [string]
end

fn append_list(a: [StrList], x: StrList) -> [StrList] is
    let mut o: [StrList] = a
    o.push(x)
    return o
end

fn line_list(text: string) -> [string] is
    let mut out: [string] = []
    let lines: [string] = str::split(text, "\n")
    let mut i: int = 0
    while i < lines.len() is
        if lines[i] != "" is out.push(lines[i]) end
        i += 1
    end
    return out
end

fn is_user(idb: db::InstalledDb, name: string) -> bool is
    let io: db::InstalledPackage? = idb.get(name)
    if io == nil is return false end
    let p: db::InstalledPackage = io
    return db::reason_to_str(p.reason) == "user"
end

