use "std -> strings"     from "str"
use "std -> collections" from "col"
use "std -> conv" from "conv"

mod package
mod cache
mod db
mod version

;; hammer -> pkg::solver::provides
;;
;; Port of source-code/pkg/solver/provides.rs (Rust) to H#.
;; Mapa "capability -> dostawcy" (Provides:), mapa Replaces: i zbior
;; pakietow czysto wirtualnych.
;;
;; ── Odejscia od oryginalu (swiadome, udokumentowane) ────────────────────
;; 1. `HashMap<String, Vec<Provider>>` -> natywna mapa z `std -> collections`
;;    (klucz = capability, wartosc = indeks w tablicy `lists`, zapisany
;;    jako tekst — mapa trzyma tylko napisy) + tablica `lists`.
;;    `HashSet<String>` -> ta sama mapa uzyta jako zbior.
;; 2. `build(cache, Option<&InstalledDb>)` -> `provides_build(c, idb)` z
;;    `idb: db::InstalledDb?`. Zamiast `cache.all_packages()` (w H# to sort
;;    wstawianie O(n^2), a kolejnosc i tak nic nie zmienia — o wyniku
;;    decyduje komparator dostawcow) iterujemy `c.by_name`.
;; 3. Test "czy istnieje prawdziwy pakiet o tej nazwie" (`cache.get(..)`,
;;    w H# liniowy) zastapiony zbiorem nazw zbudowanym raz — ta sama
;;    semantyka, O(1).
;; 4. `sort_by` (stabilny) -> wstawianie z komparatorem `provider_before`:
;;    zainstalowany > dokladna nazwa > wyzszy priorytet > alfabetycznie.
;;    `dedup_by` (sasiednie duplikaty po nazwie, zostaje pierwszy) jak w Rust.
;; 5. `&'a str` zwracane z `resolve` -> `string`.

pub struct Provider is
    ;; Prawdziwa nazwa pakietu dostarczajacego capability
    pub name:      string
    ;; Wersja, w jakiej dostarcza (nil = dowolna)
    pub version:   string?
    ;; Priorytet repo (wyzszy = lepszy)
    pub priority:  int
    pub arch:      string?
    ;; Czy pakiet jest teraz zainstalowany
    pub installed: bool
    ;; Czy to dokladna nazwa (nie wirtualny provide)
    pub exact:     bool
end

pub struct ProviderList is
    pub items: [Provider]
end

pub struct NameList is
    pub items: [string]
end

pub struct ProvidesMap is
    ;; capability -> indeks w `lists`
    pub index:     any
    pub lists:     [ProviderList]
    ;; pakiet -> indeks w `rep_lists` (kto go zastepuje)
    pub rep_index: any
    pub rep_lists: [NameList]
    ;; zbior nazw czysto wirtualnych
    pub virtuals:  any
end

;; ── strip_arch_suffix ────────────────────────────────────────────────────

fn is_arch_char(c: string) -> bool is
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"
end

;; Zdejmuje `:arch` z nazwy. Prawdziwe nazwy architektur Debiana sa
;; alfanumeryczne i prawie wszystkie zawieraja cyfry (amd64, i386, ...).
pub fn strip_arch_suffix(name: string) -> string is
    let idx: int = string_rfind(name, ":")
    if idx >= 0 is
        let suffix: string = str::slice(name, idx + 1, string_len(name))
        let n: int = string_len(suffix)
        if n > 0 && n <= 12 is
            let mut ok: bool = true
            let mut i: int = 0
            while i < n is
                if !is_arch_char(string_at(suffix, i)) is ok = false end
                i += 1
            end
            if ok is return str::slice(name, 0, idx) end
        end
    end
    return name
end

;; ── Zapytania ────────────────────────────────────────────────────────────

fn lookup(m: ProvidesMap, key: string) -> int is
    if !col::hashmap_contains(m.index, key) is return -1 end
    return conv::str_to_int(col::hashmap_get(m.index, key))
end

;; Najlepszy pojedynczy dostawca capability (zainstalowany > priorytet > alfabet).
pub fn provides_resolve(m: ProvidesMap, name: string) -> string is
    let i: int = lookup(m, name)
    if i >= 0 is
        let l: ProviderList = m.lists[i]
        if l.items.len() > 0 is return l.items[0].name end
    end
    return name
end

fn names_of(l: ProviderList) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i < l.items.len() is
        out.push(l.items[i].name)
        i += 1
    end
    return out
end

;; Wszyscy dostawcy capability, najlepszy pierwszy.
pub fn providers_of(m: ProvidesMap, name: string) -> [string] is
    let bare: string = strip_arch_suffix(name)
    let key: string = if bare != name then bare else name
    let i: int = lookup(m, key)
    if i >= 0 is return names_of(m.lists[i]) end
    ;; Fallback: probuj bez zdejmowania sufiksu
    if key != name is
        let j: int = lookup(m, name)
        if j >= 0 is return names_of(m.lists[j]) end
    end
    let empty: [string] = []
    return empty
end

;; Czy capability ma teraz zainstalowanego dostawce.
pub fn is_satisfied(m: ProvidesMap, name: string) -> bool is
    let i: int = lookup(m, strip_arch_suffix(name))
    if i < 0 is return false end
    let l: ProviderList = m.lists[i]
    let mut k: int = 0
    while k < l.items.len() is
        if l.items[k].installed is return true end
        k += 1
    end
    return false
end

;; Czy `name` jest czysto wirtualnym pakietem.
pub fn is_virtual(m: ProvidesMap, name: string) -> bool is
    return col::hashmap_contains(m.virtuals, strip_arch_suffix(name))
end

;; Pakiety zastepujace `name` (pole `Replaces:`).
pub fn replacers_of(m: ProvidesMap, name: string) -> [string] is
    if !col::hashmap_contains(m.rep_index, name) is
        let empty: [string] = []
        return empty
    end
    let i: int = conv::str_to_int(col::hashmap_get(m.rep_index, name))
    return m.rep_lists[i].items
end

;; Najlepszy dostawca spelniajacy ograniczenie wersji; nil gdy brak.
pub fn resolve_versioned(m: ProvidesMap, name: string, op: string, ver: string) -> string? is
    let i: int = lookup(m, strip_arch_suffix(name))
    if i < 0 is return nil end
    let l: ProviderList = m.lists[i]
    let mut k: int = 0
    while k < l.items.len() is
        let p: Provider = l.items[k]
        ;; dostawca bez wersji spelnia kazde ograniczenie
        if p.version == nil is return p.name end
        let pv: string = p.version
        if version::satisfies(pv, op, ver) is return p.name end
        k += 1
    end
    return nil
end

;; ── Budowanie ────────────────────────────────────────────────────────────

;; Priorytet repo wg URI (jak Pin-Priority w apt).
fn repo_priority_for(uri: string?) -> int is
    if uri == nil is return 100 end
    let u: string = uri
    if compat::str_index_of(u, "hackeros") >= 0 || compat::str_index_of(u, "local") >= 0 is return 600 end
    if compat::str_index_of(u, "security") >= 0 is return 500 end
    if compat::str_index_of(u, "proposed") >= 0 || compat::str_index_of(u, "backports") >= 0 is return 200 end
    return 400
end

;; true gdy `a` ma stac przed `b`.
fn provider_before(a: Provider, b: Provider) -> bool is
    if a.installed != b.installed is return a.installed end
    if a.exact != b.exact is return a.exact end
    if a.priority != b.priority is return a.priority > b.priority end
    return a.name < b.name
end

;; Sortuje stabilnie i usuwa sasiednie duplikaty po nazwie.
fn sort_dedup(items: [Provider]) -> [Provider] is
    let mut a: [Provider] = items
    let mut i: int = 1
    while i < a.len() is
        let cur: Provider = a[i]
        let mut j: int = i - 1
        while j >= 0 && provider_before(cur, a[j]) is
            a[j + 1] = a[j]
            j -= 1
        end
        a[j + 1] = cur
        i += 1
    end
    let mut out: [Provider] = []
    let mut k: int = 0
    while k < a.len() is
        if out.len() == 0 || out[out.len() - 1].name != a[k].name is
            out.push(a[k])
        end
        k += 1
    end
    return out
end

;; UWAGA (semantyka tablic H#): `arr.push(x)` zapisuje (byc moze NOWY, po
;; realokacji) wskaznik tylko do zmiennej, na ktorej je wywolano — stara
;; tablica jest zwalniana. Dlatego dopisywanie do tablicy trzymanej w
;; polu struktury / w innej tablicy MUSI isc przez funkcje zwracajaca nowa
;; tablice i zapis wyniku z powrotem (`lists = add_provider(..)`).
fn append_provider(items: [Provider], p: Provider) -> [Provider] is
    let mut a: [Provider] = items
    a.push(p)
    return a
end

fn append_name(items: [string], s: string) -> [string] is
    let mut a: [string] = items
    a.push(s)
    return a
end

;; Dopisuje dostawce do capability `cap` (tworzy wpis, jesli go nie ma);
;; zwraca zaktualizowana tablice `lists`.
fn add_provider(index: any, lists: [ProviderList], cap: string, p: Provider) -> [ProviderList] is
    let mut out: [ProviderList] = lists
    if col::hashmap_contains(index, cap) is
        let i: int = conv::str_to_int(col::hashmap_get(index, cap))
        out[i] = ProviderList { items: append_provider(out[i].items, p) }
    else is
        col::hashmap_insert(index, cap, to_string(out.len()))
        let first: [Provider] = [p]
        out.push(ProviderList { items: first })
    end
    return out
end

;; Buduje ProvidesMap z cache i (opcjonalnie) bazy zainstalowanych.
pub fn provides_build(c: cache::PackageCache, idb: db::InstalledDb?) -> ProvidesMap is
    let index:     any = col::hashmap_new()
    let rep_index: any = col::hashmap_new()
    let virtuals:  any = col::hashmap_new()
    let installed_names: any = col::hashmap_new()
    let real_names:      any = col::hashmap_new()
    let mut lists:     [ProviderList] = []
    let mut rep_lists: [NameList] = []

    if idb != nil is
        let d: db::InstalledDb = idb
        let all: [db::InstalledPackage] = d.list_all()
        let mut ii: int = 0
        while ii < all.len() is
            col::hashmap_insert(installed_names, all[ii].name, "1")
            ii += 1
        end
    end

    let pkgs: [package::Package] = c.by_name
    let mut n: int = 0
    while n < pkgs.len() is
        col::hashmap_insert(real_names, pkgs[n].name, "1")
        n += 1
    end

    let mut pi: int = 0
    while pi < pkgs.len() is
        let pkg: package::Package = pkgs[pi]
        let is_installed: bool = col::hashmap_contains(installed_names, pkg.name)
        let base_priority: int = repo_priority_for(pkg.repo_base_uri)

        ;; 1. Self-provides (pakiet dostarcza sam siebie w swojej wersji)
        lists = add_provider(index, lists, pkg.name, Provider {
            name: pkg.name, version: pkg.version, priority: base_priority,
            arch: pkg.architecture, installed: is_installed, exact: true })

        ;; 2. Pole Provides: — moze byc z wersja `foo (= 1.2)` albo zwykle `foo`
        if pkg.provides != nil is
            let prov_str: string = pkg.provides
            let groups: [package::DepGroup] = package::parse_dep_field(prov_str)
            let mut gi: int = 0
            while gi < groups.len() is
                let alts: [package::DepAlternative] = groups[gi].alternatives
                let mut ai: int = 0
                while ai < alts.len() is
                    let alt: package::DepAlternative = alts[ai]
                    let cap_name: string = alt.name
                    let mut cap_ver: string? = nil
                    if alt.constraint != nil is
                        let cc: package::VersionConstraint = alt.constraint
                        if package::op_to_str(cc.op) == "=" is cap_ver = cc.version end
                    end
                    lists = add_provider(index, lists, cap_name, Provider {
                        name: pkg.name, version: cap_ver, priority: base_priority,
                        arch: pkg.architecture, installed: is_installed, exact: false })
                    ;; jesli zaden prawdziwy pakiet nie ma tej nazwy — wirtualny
                    if !col::hashmap_contains(real_names, cap_name) is
                        col::hashmap_insert(virtuals, cap_name, "1")
                    end
                    ai += 1
                end
                gi += 1
            end
        end

        ;; 3. Pole Replaces:
        if pkg.replaces != nil is
            let repl_str: string = pkg.replaces
            let rgroups: [package::DepGroup] = package::parse_dep_field(repl_str)
            let mut rg: int = 0
            while rg < rgroups.len() is
                let ralts: [package::DepAlternative] = rgroups[rg].alternatives
                let mut ra: int = 0
                while ra < ralts.len() is
                    let rname: string = ralts[ra].name
                    if col::hashmap_contains(rep_index, rname) is
                        let ri: int = conv::str_to_int(col::hashmap_get(rep_index, rname))
                        rep_lists[ri] = NameList { items: append_name(rep_lists[ri].items, pkg.name) }
                    else is
                        col::hashmap_insert(rep_index, rname, to_string(rep_lists.len()))
                        let first: [string] = [pkg.name]
                        rep_lists.push(NameList { items: first })
                    end
                    ra += 1
                end
                rg += 1
            end
        end
        pi += 1
    end

    ;; Sortowanie dostawcow: zainstalowany, dokladna nazwa, priorytet, alfabet
    let mut li: int = 0
    while li < lists.len() is
        lists[li] = ProviderList { items: sort_dedup(lists[li].items) }
        li += 1
    end

    return ProvidesMap { index: index, lists: lists, rep_index: rep_index, rep_lists: rep_lists, virtuals: virtuals }
end

;; ── Test (z provides.rs) ─────────────────────────────────────────────────

fn t_strip(input: string, want: string) -> int is
    if strip_arch_suffix(input) == want is return 0 end
    write("provides::self_test FAIL: strip_arch_suffix(" + input + ") != " + want)
    return 1
end

;; Zwraca liczbe niezdanych przypadkow.
pub fn self_test() -> int is
    let mut f: int = 0
    f += t_strip("libfoo:amd64", "libfoo")
    f += t_strip("libfoo", "libfoo")
    f += t_strip("libfoo:arm64", "libfoo")
    f += t_strip("python3:i386", "python3")
    return f
end
