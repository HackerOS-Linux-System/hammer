fn iv(s: sat::Sat, name: string) -> sat::Sat is
    return sat::sat_intern(s, name)
end

;; ── sat_tests ────────────────────────────────────────────────────────────

fn t_empty_formula() -> int is
    let s: sat::Sat = sat::sat_solve(sat::sat_new(100000))
    return report("sat_empty_formula", s.status == 1, "empty formula is SAT, status=" + to_string(s.status))
end

fn t_single_unit() -> int is
    let mut s: sat::Sat = sat::sat_new(100000)
    s = iv(s, "pkg-a")
    let a: int = sat::sat_var(s, "pkg-a")
    s = sat::sat_add_clause(s, [a])
    s = sat::sat_solve(s)
    return report("sat_single_unit_clause", s.status == 1 && sat::sat_value(s, "pkg-a") == 1, "status=" + to_string(s.status))
end

fn t_two_variables() -> int is
    ;; (a ∨ b) ∧ (¬a ∨ b)  → b musi byc true
    let mut s: sat::Sat = sat::sat_new(100000)
    s = iv(s, "a")
    s = iv(s, "b")
    let a: int = sat::sat_var(s, "a")
    let b: int = sat::sat_var(s, "b")
    s = sat::sat_add_clause(s, [a, b])
    s = sat::sat_add_clause(s, [0 - a, b])
    s = sat::sat_solve(s)
    return report("sat_two_variables", s.status == 1 && sat::sat_value(s, "b") == 1, "b must be true")
end

fn t_contradiction() -> int is
    ;; a ∧ ¬a — blad najpozniej przy solve() (Rust dopuszcza wykrycie przy add)
    let mut s: sat::Sat = sat::sat_new(100000)
    s = iv(s, "a")
    let a: int = sat::sat_var(s, "a")
    s = sat::sat_add_clause(s, [a])
    s = sat::sat_add_clause(s, [0 - a])
    s = sat::sat_solve(s)
    return report("unsat_contradiction", s.status == -1, "status=" + to_string(s.status))
end

;; nazwa zmiennej "p<i>_<j>"
fn pname(i: int, j: int) -> string is
    return "p" + to_string(i) + "_" + to_string(j)
end

fn t_pigeon_hole() -> int is
    ;; 3 golebie, 2 dziury -> UNSAT
    let mut s: sat::Sat = sat::sat_new(1000000)
    let mut i: int = 0
    while i < 3 is
        s = iv(s, pname(i, 0))
        s = iv(s, pname(i, 1))
        s = sat::sat_add_clause(s, [sat::sat_var(s, pname(i, 0)), sat::sat_var(s, pname(i, 1))])
        i += 1
    end
    let mut j: int = 0
    while j < 2 is
        let mut i1: int = 0
        while i1 < 3 is
            let mut i2: int = i1 + 1
            while i2 < 3 is
                s = sat::sat_add_clause(s, [0 - sat::sat_var(s, pname(i1, j)), 0 - sat::sat_var(s, pname(i2, j))])
                i2 += 1
            end
            i1 += 1
        end
        j += 1
    end
    s = sat::sat_solve(s)
    return report("unsat_3sat_pigeon_hole", s.status == -1, "status=" + to_string(s.status))
end

fn t_budget() -> int is
    let mut s: sat::Sat = sat::sat_new(1)
    s = iv(s, "a")
    s = iv(s, "b")
    s = iv(s, "c")
    let a: int = sat::sat_var(s, "a")
    let b: int = sat::sat_var(s, "b")
    let c: int = sat::sat_var(s, "c")
    s = sat::sat_add_clause(s, [a, b, c])
    s = sat::sat_add_clause(s, [0 - a, b])
    s = sat::sat_add_clause(s, [0 - b, c])
    s = sat::sat_add_clause(s, [0 - c])
    s = sat::sat_solve(s)
    return report("budget_exceeded_returns_false", s.status == 0 || s.status == -1, "status=" + to_string(s.status))
end

fn t_pure_literal() -> int is
    let mut s: sat::Sat = sat::sat_new(100000)
    s = iv(s, "a")
    s = iv(s, "b")
    let a: int = sat::sat_var(s, "a")
    let b: int = sat::sat_var(s, "b")
    s = sat::sat_add_clause(s, [0 - a, b])
    s = sat::sat_preprocess(s)
    s = sat::sat_solve(s)
    let a_true: bool = sat::sat_value(s, "a") == 1
    let b_true: bool = sat::sat_value(s, "b") == 1
    return report("pure_literal_eliminated", s.status == 1 && (!a_true || b_true), "clause (-a v b) violated")
end

fn t_phase_saving() -> int is
    let mut s: sat::Sat = sat::sat_new(100000)
    s = iv(s, "libssl")
    s = iv(s, "myapp")
    let ssl: int = sat::sat_var(s, "libssl")
    let app: int = sat::sat_var(s, "myapp")
    s = sat::sat_add_clause(s, [0 - app, ssl])
    s = sat::sat_add_clause(s, [app])
    s = sat::sat_prefer_installed(s, "libssl")
    s = sat::sat_solve(s)
    return report("phase_saving_prefer_installed",
        s.status == 1 && sat::sat_value(s, "libssl") == 1 && sat::sat_value(s, "myapp") == 1, "libssl/myapp must be true")
end

fn t_tautology() -> int is
    let mut s: sat::Sat = sat::sat_new(100000)
    s = iv(s, "a")
    let a: int = sat::sat_var(s, "a")
    s = sat::sat_add_clause(s, [a, 0 - a])
    s = sat::sat_solve(s)
    return report("tautology_ignored", s.status == 1, "status=" + to_string(s.status))
end

fn t_model_covers_all_vars() -> int is
    let mut s: sat::Sat = sat::sat_new(100000)
    s = iv(s, "a")
    s = iv(s, "b")
    s = iv(s, "c")
    let a: int = sat::sat_var(s, "a")
    let b: int = sat::sat_var(s, "b")
    let c: int = sat::sat_var(s, "c")
    s = sat::sat_add_clause(s, [a])
    s = sat::sat_add_clause(s, [b, c])
    s = sat::sat_solve(s)
    let ok: bool = s.status == 1 && sat::sat_var(s, "a") != 0 && sat::sat_var(s, "b") != 0 && sat::sat_var(s, "c") != 0 && sat::sat_n_vars(s) == 3
    return report("model_covers_all_vars", ok, "a, b, c must all be known to the model")
end

fn t_stats() -> int is
    let mut s: sat::Sat = sat::sat_new(100000)
    s = iv(s, "a")
    s = iv(s, "b")
    let a: int = sat::sat_var(s, "a")
    let b: int = sat::sat_var(s, "b")
    s = sat::sat_add_clause(s, [a, b])
    s = sat::sat_add_clause(s, [0 - a, 0 - b])
    s = sat::sat_solve(s)
    return report("stats_populated_after_solve", s.decisions > 0 || s.conflicts == 0, "decisions=" + to_string(s.decisions) + " conflicts=" + to_string(s.conflicts))
end

;; 5 wspolnych + 500 lisci + 50 wzajemnie wykluczajacych sie "edytorow".
fn t_stress(strict_time: bool) -> int is
    let started: int = compat::time_now_ms()
    let mut s: sat::Sat = sat::sat_new(1000000)

    let mut i: int = 0
    while i < 5 is
        s = iv(s, "shared" + to_string(i))
        i += 1
    end
    let mut w: int = 0
    while w + 1 < 5 is
        s = sat::sat_add_clause(s, [0 - sat::sat_var(s, "shared" + to_string(w)), sat::sat_var(s, "shared" + to_string(w + 1))])
        w += 1
    end
    let shared0: int = sat::sat_var(s, "shared0")

    let mut l: int = 0
    while l < 500 is
        s = iv(s, "leaf" + to_string(l))
        s = sat::sat_add_clause(s, [0 - sat::sat_var(s, "leaf" + to_string(l)), shared0])
        l += 1
    end

    let mut e: int = 0
    while e < 50 is
        s = iv(s, "editor" + to_string(e))
        e += 1
    end
    let mut ei: int = 0
    while ei < 50 is
        let mut ej: int = ei + 1
        while ej < 50 is
            s = sat::sat_add_clause(s, [0 - sat::sat_var(s, "editor" + to_string(ei)), 0 - sat::sat_var(s, "editor" + to_string(ej))])
            ej += 1
        end
        ei += 1
    end
    ;; co najmniej jeden edytor + pierwsze 200 lisci wymuszone
    let mut any_editor: [int] = []
    let mut k: int = 0
    while k < 50 is
        any_editor.push(sat::sat_var(s, "editor" + to_string(k)))
        k += 1
    end
    s = sat::sat_add_clause(s, any_editor)
    let mut f: int = 0
    while f < 200 is
        s = sat::sat_add_clause(s, [sat::sat_var(s, "leaf" + to_string(f))])
        f += 1
    end

    s = sat::sat_solve(s)
    let elapsed_ms: int = compat::time_now_ms() - started
    let mut fails: int = report("stress_large_alternatives_graph", s.status == 1, "synthetic graph is satisfiable, status=" + to_string(s.status))
    if elapsed_ms >= 5000 is
        if strict_time is
            fails += report("stress_large_alternatives_graph", false, "took " + to_string(elapsed_ms) + " ms (limit 5000) — performance regression")
        else
            write("tests::stress_large_alternatives_graph WARN: " + to_string(elapsed_ms) + " ms (interpreter; limit applies to compiled builds)")
        end
    end
    return fails
end

;; Rust: `mod sat_tests`. Zwraca liczbe niezdanych przypadkow.
pub fn sat_tests(include_stress: bool, strict_time: bool) -> int is
    let mut f: int = 0
    f += t_empty_formula()
    f += t_single_unit()
    f += t_two_variables()
    f += t_contradiction()
    f += t_pigeon_hole()
    f += t_budget()
    f += t_pure_literal()
    f += t_phase_saving()
    f += t_tautology()
    f += t_model_covers_all_vars()
    f += t_stats()
    if include_stress is f += t_stress(strict_time) end
    return f
end

