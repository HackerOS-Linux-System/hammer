;; Rust: `pkg(name, version, depends)`.
fn mkpkg(name: string, version: string, depends: string?) -> package::Package is
    let mut p: package::Package = package::empty_package()
    p.name = name
    p.version = version
    p.architecture = "amd64"
    p.depends = depends
    p.installed_size_kb = 100
    p.download_size = 50000
    return p
end

fn pkg_conflicts(name: string, version: string, conflicts: string) -> package::Package is
    let mut p: package::Package = package::empty_package()
    p.name = name
    p.version = version
    p.conflicts = conflicts
    return p
end

fn pkg_provides(name: string, provides: string) -> package::Package is
    let mut p: package::Package = package::empty_package()
    p.name = name
    p.version = "1.0"
    p.provides = provides
    return p
end

fn pkg_recommends(name: string, recommends: string) -> package::Package is
    let mut p: package::Package = package::empty_package()
    p.name = name
    p.version = "1.0"
    p.recommends = recommends
    return p
end

;; Rust: `build_cache`.
fn build_cache(pkgs: [package::Package]) -> cache::PackageCache is
    let mut c: cache::PackageCache = cache::cache_empty()
    let mut i: int = 0
    while i < pkgs.len() is
        c = cache::cache_insert(c, pkgs[i])
        i += 1
    end
    return c
end

;; Rust: `build_db(vec![(name, version)])` — dwie rownolegle tablice.
fn build_db(names: [string], versions: [string]) -> db::InstalledDb is
    let idb: db::InstalledDb = db::InstalledDb::open_in_memory()
    let mut i: int = 0
    while i < names.len() is
        idb.record_install(mkpkg(names[i], versions[i], nil), db::InstallReason::User, "", 0)
        i += 1
    end
    return idb
end

fn no_names() -> [string] is
    let n: [string] = []
    return n
end

fn plan_has(plan: solver::TransactionPlan, name: string) -> bool is
    let mut i: int = 0
    while i < plan.to_install.len() is
        if plan.to_install[i].name == name is return true end
        i += 1
    end
    return false
end

fn list_has(items: [string], name: string) -> bool is
    let mut i: int = 0
    while i < items.len() is
        if items[i] == name is return true end
        i += 1
    end
    return false
end

;; Rozwiazuje `names` na swiezym cache/db i zamyka baze.
fn solve(pkgs: [package::Package], inst_names: [string], inst_versions: [string], want: [string], no_rec: bool) -> solver::PlanResult is
    let c: cache::PackageCache = build_cache(pkgs)
    let idb: db::InstalledDb = build_db(inst_names, inst_versions)
    let sv: solver::Solver = solver::solver_new(c, idb)
    let r: solver::PlanResult = resolve::resolve_install(sv, want, no_rec)
    idb.close()
    return r
end

;; ── resolver_tests ───────────────────────────────────────────────────────

fn r_install_no_deps() -> int is
    let r: solver::PlanResult = solve([mkpkg("curl", "7.0", nil)], no_names(), no_names(), ["curl"], false)
    return report("install_no_deps", r.err == "" && plan_has(r.plan, "curl") && r.plan.to_remove.len() == 0, "err=[" + r.err + "]")
end

fn r_install_with_dependency() -> int is
    let r: solver::PlanResult = solve([mkpkg("wget", "1.0", "libssl"), mkpkg("libssl", "3.0", nil)], no_names(), no_names(), ["wget"], false)
    return report("install_with_dependency", r.err == "" && plan_has(r.plan, "wget") && plan_has(r.plan, "libssl"), "wget + libssl expected, err=[" + r.err + "]")
end

fn r_already_installed_dep() -> int is
    let r: solver::PlanResult = solve([mkpkg("app", "1.0", "libz"), mkpkg("libz", "1.0", nil)], ["libz"], ["1.0"], ["app"], false)
    return report("already_installed_dep_not_re_added", r.err == "" && !plan_has(r.plan, "libz"), "already-installed dep should not be re-added, err=[" + r.err + "]")
end

fn r_conflict_detected() -> int is
    let r: solver::PlanResult = solve([pkg_conflicts("pkg-a", "1.0", "pkg-b"), pkg_conflicts("pkg-b", "1.0", "pkg-a")], no_names(), no_names(), ["pkg-a", "pkg-b"], false)
    return report("conflict_detected_by_cdcl", r.err != "", "conflicting packages must fail resolution")
end

fn r_virtual_package() -> int is
    let mut openssl: package::Package = pkg_provides("openssl", "libssl")
    openssl.version = "3.0"
    let r: solver::PlanResult = solve([mkpkg("myapp", "1.0", "libssl"), openssl], no_names(), no_names(), ["myapp"], false)
    return report("virtual_package_resolved", r.err == "" && plan_has(r.plan, "openssl"), "openssl should provide libssl, err=[" + r.err + "]")
end

fn r_recommends_default() -> int is
    let r: solver::PlanResult = solve([pkg_recommends("git", "git-lfs"), mkpkg("git-lfs", "1.0", nil)], no_names(), no_names(), ["git"], false)
    return report("recommends_included_by_default", r.err == "" && plan_has(r.plan, "git-lfs"), "recommended package should be included, err=[" + r.err + "]")
end

fn r_recommends_excluded() -> int is
    let r: solver::PlanResult = solve([pkg_recommends("git", "git-lfs"), mkpkg("git-lfs", "1.0", nil)], no_names(), no_names(), ["git"], true)
    return report("recommends_excluded_with_flag", r.err == "" && !plan_has(r.plan, "git-lfs"), "git-lfs must be excluded with --no-recommends, err=[" + r.err + "]")
end

fn r_autoremove_recommends() -> int is
    ;; libA jest polecany przez userapp -> NIE moze byc autoremove
    let c: cache::PackageCache = build_cache([pkg_recommends("userapp", "libA"), mkpkg("libA", "1.0", nil)])
    let idb: db::InstalledDb = build_db(["userapp", "libA"], ["1.0", "1.0"])
    idb.set_reason("libA", db::InstallReason::Dependency)
    let sv: solver::Solver = solver::solver_new(c, idb)
    let r: solver::PlanResult = resolve::resolve_autoremove(sv)
    idb.close()
    return report("autoremove_respects_recommends", r.err == "" && !list_has(r.plan.to_autoremove, "libA"), "libA recommended by userapp must NOT be autoremoved, err=[" + r.err + "]")
end

fn r_transitive() -> int is
    let r: solver::PlanResult = solve([mkpkg("app", "1.0", "lib-b"), mkpkg("lib-b", "1.0", "lib-c"), mkpkg("lib-c", "1.0", nil)], no_names(), no_names(), ["app"], false)
    return report("transitive_deps_resolved", r.err == "" && plan_has(r.plan, "app") && plan_has(r.plan, "lib-b") && plan_has(r.plan, "lib-c"), "lib-c must be in plan, err=[" + r.err + "]")
end

fn r_stats() -> int is
    let r: solver::PlanResult = solve([mkpkg("foo", "1.0", nil)], no_names(), no_names(), ["foo"], false)
    return report("cdcl_stats_populated", r.err == "" && r.plan.sat_stats != nil, "sat_stats should be populated, err=[" + r.err + "]")
end

;; Regresja: pakiet z Provides: X i Conflicts: X nie moze kolidowac sam ze soba.
fn r_self_conflict() -> int is
    let mut np: package::Package = pkg_provides("new-pkg", "old-name")
    np.conflicts = "old-name"
    let r: solver::PlanResult = solve([np], no_names(), no_names(), ["new-pkg"], false)
    return report("self_conflict_via_own_provides_is_not_a_conflict", r.err == "", "must still install: " + r.err)
end

;; Regresja: `Conflicts: pkg-b (<< 2.0)` nie dotyczy pkg-b 3.0.
fn r_scoped_newer() -> int is
    let a: package::Package = pkg_conflicts("pkg-a", "1.0", "pkg-b (<< 2.0)")
    let r: solver::PlanResult = solve([a, mkpkg("pkg-b", "3.0", nil)], no_names(), no_names(), ["pkg-a", "pkg-b"], false)
    return report("version_scoped_conflict_does_not_apply_to_newer_version", r.err == "", "pkg-b 3.0 must not trigger '<< 2.0': " + r.err)
end

fn r_scoped_old() -> int is
    let a: package::Package = pkg_conflicts("pkg-a", "1.0", "pkg-b (<< 2.0)")
    let r: solver::PlanResult = solve([a, mkpkg("pkg-b", "1.5", nil)], no_names(), no_names(), ["pkg-a", "pkg-b"], false)
    return report("version_scoped_conflict_still_applies_to_old_version", r.err != "", "pkg-b 1.5 matches '<< 2.0' — must be a real conflict")
end

;; Regresja: duzy zestaw alternatyw nie moze wywrocic procesu (panic w Rust).
;; H# nie ma panic-recovery — sam brak zatrzymania tej funkcji to wynik OK.
fn r_wide_set() -> int is
    let mut pkgs: [package::Package] = []
    let mut i: int = 0
    while i < 80 is
        let mut p: package::Package = pkg_conflicts("alt" + to_string(i), "1.0", "alt" + to_string((i + 1) % 80))
        p.provides = "virtual" + to_string(i)
        pkgs.push(p)
        i += 1
    end
    pkgs.push(mkpkg("root", "1.0", "alt0"))
    let r: solver::PlanResult = solve(pkgs, no_names(), no_names(), ["root"], false)
    write("tests::wide_dependency_set_does_not_panic_on_resolve: finished (err=[" + r.err + "])")
    return 0
end

;; Rust: `mod resolver_tests`. TYLKO pod LLVM (patrz naglowek).
pub fn resolver_tests() -> int is
    let mut f: int = 0
    f += r_install_no_deps()
    f += r_install_with_dependency()
    f += r_already_installed_dep()
    f += r_conflict_detected()
    f += r_virtual_package()
    f += r_recommends_default()
    f += r_recommends_excluded()
    f += r_autoremove_recommends()
    f += r_transitive()
    f += r_stats()
    f += r_self_conflict()
    f += r_scoped_newer()
    f += r_scoped_old()
    f += r_wide_set()
    return f
end

;; Wszystko; zwraca liczbe niezdanych przypadkow (`hammer _selftest`).
pub fn run_all() -> int is
    let a: int = sat_tests(true, true)
    write("tests: sat_tests failures = " + to_string(a))
    let b: int = resolver_tests()
    write("tests: resolver_tests failures = " + to_string(b))
    return a + b
end
