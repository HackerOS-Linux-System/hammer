;; hammer -> pkg::solver::tests   (port source-code/pkg/solver/tests.rs, 546 l.)
;;
;; Rust: `#[cfg(test)] mod sat_tests` + `mod resolver_tests` uruchamiane przez
;; `cargo test`. H# nie ma `#[test]`; konwencja portu (patrz `version.h#`,
;; `sat.h#`): funkcje zwracajace LICZBE NIEZDANYCH przypadkow i wypisujace
;; `tests::<nazwa> FAIL: ...`. Uruchamianie:
;;
;;   * `sat_tests()`      — w interpreterze (`selftest.h#`, bez testu
;;                          obciazeniowego: ~30 s w interpreterze) ORAZ w binarce;
;;   * `resolver_tests()` — TYLKO w binarce skompilowanej przez LLVM
;;                          (`hammer _selftest`): potrzebuje `cache`
;;                          (hashmapy `std -> collections`) i
;;                          `InstalledDb::open_in_memory` (`sqlite3` + `system`),
;;                          ktorych interpreter H# nie obsluguje.
;;
;; ── Odejscia od oryginalu ───────────────────────────────────────────────
;; 1. `CdclSolver` -> DPLL z `sat.h#` (patrz jego naglowek): zamiast `Lit`/
;;    `Var` — liczby calkowite (`+v`/`-v`), model przez `sat_value`.
;; 2. `pure_literal_eliminated`: Rust sprawdza, ze `preprocess()` PRZYPISUJE
;;    `b = true`. DPLL nie ma `preprocess` (no-op), a domyslna faza to
;;    `false`, wiec tej konkretnej wlasnosci nie ma jak sprawdzic. Test
;;    sprawdza to, co jest istotne dla poprawnosci: formula jest SAT, a
;;    klauzula `¬a ∨ b` jest spelniona w zwroconym modelu.
;; 3. `budget_exceeded_returns_false`: Rust asercja `is_ok() || is_err()` jest
;;    zawsze prawdziwa. Tu: formula jest UNSAT, wiec przy limicie 1 wynik to
;;    `-1` (UNSAT wykryty w limicie) albo `0` (limit) — nie `1`.
;; 4. `stats_populated_after_solve`: `propagations` nie istnieje w porcie
;;    (patrz `sat.h#`, pkt 5); sprawdzane `decisions`/`conflicts`.
;; 5. `stress_large_alternatives_graph`: limit czasu 5 s mierzony zegarem
;;    `compat::time_now_ms`; w interpreterze moze byc znacznie wolniejszy od
;;    LLVM, wiec w interpreterze przekroczenie to OSTRZEZENIE, nie porazka
;;    (`strict_time` = true tylko dla `hammer _selftest`).
;; 6. `Package { ..Default::default() }` -> `package::empty_package()` +
;;    przypisania pol (struktury H# nie maja skladni `..`).
;; 7. `assert!(plan.is_ok())` -> `PlanResult.err == ""`.
;; 8. `resolver_tests`: kazdy test tworzy NOWA baze (`open_in_memory` kasuje
;;    plik `/tmp/hammer-mem-<pid>.sqlite`), a na koncu `idb.close()`.

fn report(name: string, ok: bool, msg: string) -> int is
    if ok is return 0 end
    write("tests::" + name + " FAIL: " + msg)
    return 1
end

