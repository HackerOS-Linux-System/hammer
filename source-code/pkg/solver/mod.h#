pub struct Solver is
    pub cache:      cache::PackageCache
    pub idb:        db::InstalledDb
    pub pins:       pins::PinDb
    pub multi_arch: multi_arch::MultiArchDb
end

;; Rust: `Solver::new(cache, db)` (+ `PinDb::load().unwrap_or_default()`).
pub fn solver_new(c: cache::PackageCache, idb: db::InstalledDb) -> Solver is
    return Solver { cache: c, idb: idb, pins: pins::pindb_load(), multi_arch: multi_arch::multi_arch_db_load() }
end

;; Wynik rozwiazywania: plan albo blad ("" = OK). `anyhow::Result<TransactionPlan>`.
pub struct PlanResult is
    pub plan: TransactionPlan
    pub err:  string
end

pub fn plan_ok(p: TransactionPlan) -> PlanResult is
    return PlanResult { plan: p, err: "" }
end

pub fn plan_err(msg: string) -> PlanResult is
    return PlanResult { plan: plan_empty(), err: msg }
end

pub fn solver_resolve_install(s: Solver, names: [string], no_recommends: bool) -> PlanResult is
    return resolve::resolve_install(s, names, no_recommends)
end

pub fn solver_resolve_reinstall(s: Solver, names: [string]) -> PlanResult is
    return resolve::resolve_reinstall(s, names)
end

pub fn solver_resolve_remove(s: Solver, names: [string]) -> PlanResult is
    return resolve::resolve_remove(s, names)
end

pub fn solver_resolve_upgrade(s: Solver) -> PlanResult is
    return resolve::resolve_upgrade(s)
end

pub fn solver_resolve_dist_upgrade(s: Solver) -> PlanResult is
    return resolve::resolve_dist_upgrade(s)
end

pub fn solver_resolve_autoremove(s: Solver) -> PlanResult is
    return resolve::resolve_autoremove(s)
end

pub fn solver_resolve_fix_broken(s: Solver) -> PlanResult is
    return resolve::resolve_fix_broken(s)
end

;; Do 6 podobnych nazw (Rust: `cache.search(lowercase).take(6)`).
pub fn solver_find_similar(s: Solver, name: string) -> [string] is
    let hits: [package::Package] = cache::cache_search(s.cache, str::to_lower(name))
    let mut out: [string] = []
    let mut i: int = 0
    while i < hits.len() && i < 6 is
        out.push(hits[i].name)
        i += 1
    end
    return out
end
