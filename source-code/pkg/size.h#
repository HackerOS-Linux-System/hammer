;; hammer -> pkg::size
;;
;; Port of source-code/pkg/size.rs (Rust) to H#.
;;   hammer size [<pkg>...] [--all] [--sort=size|name] [--deps]
;;
;; ── Odejscia od oryginalu ───────────────────────────────────────────────
;; 1. `crate::store::STORE_DIR` -> `build_mode::store_dir()` (ta sama
;;    sciezka: /hammer/store w atomic, /var/lib/hammer/store w normal-mode).
;; 2. `ui::human_size` -> `ui::human_size` (ui/ui.h# przepisane; ta sama
;;    arytmetyka calkowita zamiast `{:.1}` na f64, zaokraglenie polowek w gore).
;; 3. `walkdir` -> `fs::walk` + `fs::is_file` (H# nie odroznia symlinkow od
;;    plikow; Rust liczyl tylko zwykle pliki, wiec symlinki do plikow
;;    moga byc tu doliczone).
;; 4. `Result<()>` -> `string` ("" = Ok). `owo_colors` -> ANSI lokalnie;
;;    kolumny dopelniane PRZED pokolorowaniem (Rust dopelnial juz
;;    pokolorowany tekst, co przy kodach ANSI rozjezdzalo szerokosc).
;; 5. `--deps` to zaslepka takze w oryginale ("placeholder") — zachowana.


pub fn dir_size_bytes(dir: string) -> int is
    if !fs::exists(dir) is return 0 end
    let files: [string] = fs::walk(dir)
    let mut total: int = 0
    let mut i: int = 0
    while i < files.len() is
        if fs::is_file(files[i]) is total += fs::size(files[i]) end
        i += 1
    end
    return total
end

struct SizeRow is
    pub name:    string
    pub actual:  int
    pub db_size: int
    pub version: string
end

fn has_arg(args: [string], a: string) -> bool is
    let mut i: int = 0
    while i < args.len() is
        if args[i] == a is return true end
        i += 1
    end
    return false
end

fn contains_name(names: [string], n: string) -> bool is
    let mut i: int = 0
    while i < names.len() is
        if names[i] == n is return true end
        i += 1
    end
    return false
end

;; Stabilny sort wstawianie: po rozmiarze malejaco albo po nazwie rosnaco.
fn sort_rows(rows: [SizeRow], by_size: bool) -> [SizeRow] is
    let mut a: [SizeRow] = rows
    let mut i: int = 1
    while i < a.len() is
        let cur: SizeRow = a[i]
        let mut j: int = i - 1
        let mut moving: bool = true
        while j >= 0 && moving is
            let out_of_order: bool = if by_size then a[j].actual < cur.actual else a[j].name > cur.name
            if out_of_order is
                a[j + 1] = a[j]
                j -= 1
            else is
                moving = false
            end
        end
        a[j + 1] = cur
        i += 1
    end
    return a
end

;; "" = Ok, inaczej komunikat bledu.
pub fn cmd_size(args: [string]) -> string is
    let show_all: bool  = has_arg(args, "--all")
    let sort_size: bool = has_arg(args, "--sort=size") || has_arg(args, "--sort")
    let show_deps: bool = has_arg(args, "--deps")
    let mut names: [string] = []
    let mut n: int = 0
    while n < args.len() is
        if !args[n].starts_with("-") is names.push(args[n]) end
        n += 1
    end

    let idb: db::InstalledDb = db::InstalledDb::open()
    let all: [db::InstalledPackage] = idb.list_all()

    write("")
    write("  " + ui::accent_bold("⬡") + "  Rozmiary paczek")
    write("  " + ui::dim(str::repeat("─", 65)))

    let mut selected: [db::InstalledPackage] = []
    let mut i: int = 0
    while i < all.len() is
        if names.len() == 0 || show_all || contains_name(names, all[i].name) is
            selected.push(all[i])
        end
        i += 1
    end

    if selected.len() == 0 is
        write("  " + ui::dim("·") + " Nie znaleziono żądanych paczek.")
        return ""
    end

    ;; Faktyczny rozmiar ze store (moze sie roznic od naglowka deb).
    let mut rows: [SizeRow] = []
    let mut k: int = 0
    while k < selected.len() is
        let inst: db::InstalledPackage = selected[k]
        let db_bytes: int = inst.installed_size_kb * 1024
        let store_path: string = compat::path_join(build_mode::store_dir(),
            inst.name + "-" + inst.version + "-" + inst.store_hash)
        let mut actual: int = db_bytes
        if fs::exists(store_path) is actual = dir_size_bytes(store_path) end
        let display: int = if actual > 0 then actual else db_bytes
        rows.push(SizeRow { name: inst.name, actual: display, db_size: db_bytes, version: inst.version })
        k += 1
    end

    rows = sort_rows(rows, sort_size)

    let col_w: int = 36
    write("  " + ui::bold(fmt::pad_right("Paczka", col_w)) + " " +
          ui::bold(fmt::pad_right("Rozmiar", 12)) + " " +
          ui::bold(fmt::pad_right("Wg deb", 12)) + " " + ui::bold("Wersja"))
    write("  " + ui::dim(str::repeat("─", 80)))

    let mut total: int = 0
    let mut r: int = 0
    while r < rows.len() is
        let row: SizeRow = rows[r]
        let actual_str: string = ui::human_size(row.actual)
        let mut db_str: string = ""
        if row.db_size > 0 && row.db_size != row.actual is
            db_str = "(" + ui::human_size(row.db_size) + ")"
        end
        write("  " + ui::cyan_bold(fmt::pad_right(row.name, col_w)) + " " +
              ui::bright_white(fmt::pad_right(actual_str, 12)) + " " +
              ui::dim(fmt::pad_right(db_str, 12)) + " " + ui::dim(row.version))
        total += row.actual
        r += 1
    end

    write("  " + ui::dim(str::repeat("─", 80)))
    write("  " + ui::bold(fmt::pad_right("Razem (" + to_string(rows.len()) + " paczek):", col_w)) + " " +
          ui::bright_green_bold(ui::human_size(total)))

    if show_deps && names.len() > 0 is
        write("")
        write("  " + ui::dim("·") + " Włącznie z zależnościami:")
        ;; Zaslepka takze w oryginale — pelna implementacja wymaga PackageCache.
        write("  " + ui::dim("→") + " Użyj: " + ui::cyan("hammer size --deps --all"))
    end

    write("")
    return ""
end
