pub struct RcResult is
    pub modified: [string]
    pub err:      string
end

;; Dopisuje linie `source` do .bashrc/.zshrc/.profile (pomija juz zainstalowane).
pub fn install_shell_rc(e: UserEnv) -> RcResult is
    let snippet_path: string = join2(e.hammer_dir, "env.sh")
    let source_line: string = "[ -f \"" + snippet_path + "\" ] && . \"" + snippet_path + "\""
    let mut modified: [string] = []
    let rcs: [string] = [".bashrc", ".zshrc", ".profile"]
    let mut i: int = 0
    while i < rcs.len() is
        let rc_path: string = join2(e.home, rcs[i])
        if fs::exists(rc_path) is
            let content: string = fs::read(rc_path)
            if compat::str_index_of(content, "hammer user environment") < 0 is
                if !fs::write(rc_path, content + "\n" + source_line + "\n") is
                    return RcResult { modified: modified, err: "Cannot write " + rc_path }
                end
                modified.push(rc_path)
            end
        end
        i += 1
    end
    return RcResult { modified: modified, err: "" }
end
