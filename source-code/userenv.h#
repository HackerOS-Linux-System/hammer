pub struct UserStoreResult is
    pub entry: store::StoreEntry
    pub err:   string
end

fn file_hash8(path: string) -> string is
    let out: string = str::trim(proc::shell("sha256sum -- " + shq(path) + " 2>/dev/null"))
    if out == "" is return "" end
    return str::slice(out, 0, 8)
end

;; Instaluje rozpakowany .deb do ~/.hammer/store (patrz odejscie 4).
pub fn user_install_deb(e: UserEnv, pkg: package::Package, d: deb::DebPackage) -> UserStoreResult is
    let blank: store::StoreEntry = store::StoreEntry { name: pkg.name, version: pkg.version, hash: "", path: "", backend: store::StoreBackend::Hardlink }
    if !mkdir_p(e.store_dir) is return UserStoreResult { entry: blank, err: "Cannot create " + e.store_dir } end

    let hash: string = file_hash8(d.data_tar)
    if hash == "" is return UserStoreResult { entry: blank, err: "Cannot hash " + d.data_tar } end
    let entry_path: string = user_store_entry_path(e, pkg.name, pkg.version, hash)
    let entry: store::StoreEntry = store::StoreEntry { name: pkg.name, version: pkg.version, hash: hash,
        path: entry_path, backend: store::StoreBackend::Hardlink }

    if fs::exists(entry_path) is
        log::info("userstore: " + pkg.name + " already present")
        return UserStoreResult { entry: entry, err: "" }
    end

    let tmp_path: string = join2(e.store_dir, ".tmp-" + pkg.name + "-" + pkg.version + "-" + hash)
    if !mkdir_p(tmp_path) is return UserStoreResult { entry: entry, err: "Cannot create " + tmp_path } end
    let xr: deb::ExtractResult = deb::extract_data(d, tmp_path)
    if xr.err != "" is return UserStoreResult { entry: entry, err: xr.err } end
    if !sh_ok("mv -T " + shq(tmp_path) + " " + shq(entry_path)) is
        return UserStoreResult { entry: entry, err: "Renaming " + tmp_path + " → " + entry_path }
    end
    log::info("userstore: installed " + pkg.name)
    return UserStoreResult { entry: entry, err: "" }
end

