;;  UserEnv — sciezki srodowiska uzytkownika
;; ═══════════════════════════════════════════════════════════════════════════

fn shq(s: string) -> string is
    return "'" + str::replace_all(s, "'", "'\\''") + "'"
end

fn sh_ok(cmd: string) -> bool is
    return str::trim(proc::shell("(" + cmd + ") >/dev/null 2>&1 && echo ok || echo fail")) == "ok"
end

fn join2(a: string, b: string) -> string is
    if a == "" is return b end
    if b == "" is return a end
    if string_ends_with(a, "/") is return a + b end
    return a + "/" + b
end

pub struct UserEnv is
    pub home:         string
    pub hammer_dir:   string
    pub store_dir:    string
    pub profiles_dir: string
    pub active_link:  string
    pub pending_link: string
    pub db_dir:       string
    pub db_path:      string
    pub gens_file:    string
    pub postinst_dir: string
end

pub fn user_env_for_home(home: string) -> UserEnv is
    let hd: string = join2(home, ".hammer")
    return UserEnv { home: home, hammer_dir: hd, store_dir: join2(hd, "store"), profiles_dir: join2(hd, "profiles"),
        active_link: join2(hd, "active"), pending_link: join2(hd, "pending"), db_dir: join2(hd, "db"),
        db_path: join2(join2(hd, "db"), "hammer.db"), gens_file: join2(join2(hd, "db"), "generations.json"),
        postinst_dir: join2(join2(hd, "db"), "postinst") }
end

;; Katalog domowy: `$HOME`, potem `getent passwd` (patrz odejscie 2); "" gdy brak.
pub fn dirs_home() -> string is
    let h: string = env::get("HOME")
    if h != "" is return h end
    let line: string = str::trim(proc::shell("getent passwd $(id -u) 2>/dev/null"))
    if line == "" is return "" end
    let parts: [string] = str::split(line, ":")
    if parts.len() >= 6 is return parts[5] end
    return ""
end

pub struct EnvResult is
    pub env: UserEnv
    pub err: string
end

pub fn user_env_current() -> EnvResult is
    let home: string = dirs_home()
    if home == "" is return EnvResult { env: user_env_for_home("/"), err: "Cannot determine home directory" } end
    return EnvResult { env: user_env_for_home(home), err: "" }
end

pub fn user_active_path(e: UserEnv) -> string is
    let t: string = str::trim(proc::shell("readlink -- " + shq(e.active_link) + " 2>/dev/null"))
    if t == "" is return join2(e.profiles_dir, "gen-0") end
    return t
end

pub fn user_bin_dirs(e: UserEnv) -> [string] is
    let a: string = user_active_path(e)
    return [join2(a, "usr/bin"), join2(a, "usr/sbin"), join2(a, "bin")]
end

pub fn user_store_entry_path(e: UserEnv, name: string, version: string, hash: string) -> string is
    return join2(e.store_dir, name + "-" + version + "-" + hash)
end

fn mkdir_p(p: string) -> bool is
    proc::shell("mkdir -p " + shq(p))
    return fs::is_dir(p)
end

;; Tworzy katalogi, gen-0, dowiazanie `active`, integracje z powloka.
pub fn user_env_init(e: UserEnv) -> string is
    let dirs: [string] = [e.store_dir, e.profiles_dir, e.db_dir, e.postinst_dir]
    let mut i: int = 0
    while i < dirs.len() is
        if !mkdir_p(dirs[i]) is return "Creating " + dirs[i] end
        i += 1
    end
    let gen0: string = join2(e.profiles_dir, "gen-0")
    if !fs::exists(gen0) is
        let subs: [string] = ["usr/bin", "usr/lib", "usr/share"]
        let mut k: int = 0
        while k < subs.len() is
            if !mkdir_p(join2(gen0, subs[k])) is return "Creating " + join2(gen0, subs[k]) end
            k += 1
        end
    end
    if !sh_ok("[ -e " + shq(e.active_link) + " ] || [ -L " + shq(e.active_link) + " ]") is
        if !sh_ok("ln -s " + shq(gen0) + " " + shq(e.active_link)) is return "Cannot link " + e.active_link end
    end
    let se: string = write_shell_integration(e)
    if se != "" is return se end
    log::info("userenv: initialised at " + e.hammer_dir)
    return ""
end

fn write_shell_integration(e: UserEnv) -> string is
    let active: string = e.active_link
    let snippet: string = "\n        # hammer user environment — added by `hammer init --user`\n        # Source this file or add to your .bashrc/.zshrc\n        if [ -L \"{{active}}\" ]; then\n            export HAMMER_USER_ACTIVE=\"{{active}}\"\n            export PATH=\"{{active}}/usr/bin:{{active}}/usr/sbin:{{active}}/bin:$PATH\"\n            export LD_LIBRARY_PATH=\"{{active}}/usr/lib:{{active}}/lib:$LD_LIBRARY_PATH\"\n            export XDG_DATA_DIRS=\"{{active}}/usr/share:${{{{XDG_DATA_DIRS:-/usr/local/share:/usr/share}}}}\"\n            fi\n            "
    let path: string = join2(e.hammer_dir, "env.sh")
    if !fs::write(path, snippet) is return "Cannot write " + path end
    log::info("userenv: shell integration at " + path)
    return ""
end

;; Aktywuje oczekujaca generacje natychmiast (bez restartu): atomowa podmiana.
pub fn user_apply_pending(e: UserEnv) -> string is
    if !sh_ok("[ -L " + shq(e.pending_link) + " ]") is return "" end
    let target: string = str::trim(proc::shell("readlink -- " + shq(e.pending_link) + " 2>/dev/null"))
    if target == "" is return "Cannot read " + e.pending_link end
    let tmp: string = join2(e.hammer_dir, ".active.tmp")
    proc::shell("rm -f -- " + shq(tmp))
    if !sh_ok("ln -s " + shq(target) + " " + shq(tmp)) is return "Cannot link " + tmp end
    if !sh_ok("mv -Tf " + shq(tmp) + " " + shq(e.active_link)) is return "Cannot replace " + e.active_link end
    proc::shell("rm -f -- " + shq(e.pending_link))
    log::info("userenv: activated " + target + " immediately")
    return ""
end

