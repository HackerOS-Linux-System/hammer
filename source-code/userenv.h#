pub struct ProfileResult is
    pub path: string
    pub err:  string
end

;; Skladanie wpisu: katalogi tworzone, reszta jako dowiazania do magazynu.
fn compose_entry(profile: string, entry: store::StoreEntry) -> string is
    let script: string = "cd \"$1\" && find . -mindepth 1 \\( -type d -printf 'd\\t%P\\n' -o -printf 'f\\t%P\\n' \\) | while IFS=\"$(printf '\\t')\" read -r t p; do if [ \"$t\" = d ]; then mkdir -p -- \"$2/$p\"; else mkdir -p -- \"$(dirname -- \"$2/$p\")\"; rm -f -- \"$2/$p\"; ln -s -- \"$1/$p\" \"$2/$p\"; fi; done"
    if !sh_ok("sh -c " + shq(script) + " sh " + shq(entry.path) + " " + shq(profile)) is
        return "Composing " + entry.name
    end
    return ""
end

pub fn compose_user_profile(e: UserEnv, gen_number: int, entries: [store::StoreEntry]) -> ProfileResult is
    let profile_path: string = join2(e.profiles_dir, "gen-" + to_string(gen_number))
    if !mkdir_p(profile_path) is return ProfileResult { path: profile_path, err: "Cannot create " + profile_path } end
    let mut i: int = 0
    while i < entries.len() is
        let ce: string = compose_entry(profile_path, entries[i])
        if ce != "" is return ProfileResult { path: profile_path, err: ce + " into user gen-" + to_string(gen_number) } end
        i += 1
    end
    return ProfileResult { path: profile_path, err: "" }
end

