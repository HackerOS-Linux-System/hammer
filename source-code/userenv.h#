;; hammer -> userenv   (CZESCIOWY port source-code/userenv.rs)
;;
;; Przepisane TYLKO funkcje architektur, potrzebne przez `pkg/multi_arch`:
;; `DEBIAN_ARCHES`, `normalise_arch`, `is_native_arch`.
;; Reszta (runda 5): `UserEnv` (current/for_home/init/active_path/bin_dirs/
;; store_entry_path/apply_pending), `UserStore::install_deb`,
;; `compose_user_profile`, `install_shell_rc`, `dirs_home`.
;;
;; `Result<String>` -> `ArchResult { ok, arch, err }`.
;;
;; ── Odejscia od oryginalu (czesc userenv z rundy 5) ─────────────────────
;; 1. `PathBuf` -> `string`; `Result<T>` -> `string` ("" = OK) lub struktura z `err`.
;; 2. `libc::getpwuid` (fallback gdy brak `$HOME`) -> `getent passwd $(id -u)`.
;; 3. `UserStore<'a>` (referencja do `UserEnv`) -> funkcje `user_install_deb(env, ..)`.
;; 4. Skrot wpisu magazynu: Rust brał `sha256(deb.data_bytes)[..4]` (pierwsze 8
;;    znakow hex); tu `sha256sum` pliku `deb.data_tar` (CZLON `data.tar*` z
;;    `ar`, czyli bajty jak w .deb) — ten sam zakres danych.
;; 5. `walkdir` w `compose_entry` -> jedno `find` + petla `sh` (katalogi: `mkdir -p`;
;;    reszta: `rm -f` + `ln -s`). Nazwy plikow z nowa linia nie sa obslugiwane.
;; 6. `write_shell_integration`: szablon `format!(r#"..."#)` przeniesiony 1:1
;;    (`{active}` to zmienna; `${{XDG_DATA_DIRS:-...}}` -> `${XDG_DATA_DIRS:-...}`).

pub fn debian_arches() -> [string] is
    return ["amd64", "arm64", "armhf", "i386", "riscv64", "ppc64el", "s390x", "mipsel"]
end

pub struct ArchResult is
    pub ok:   bool
    pub arch: string
    pub err:  string
end

fn in_list(list: [string], v: string) -> bool is
    let mut i: int = 0
    while i < list.len() is
        if list[i] == v is return true end
        i += 1
    end
    return false
end

;; Waliduje i normalizuje nazwe architektury (aliasy: x86_64, aarch64, armv7l, i686).
pub fn normalise_arch(input: string) -> ArchResult is
    let a0: string = str::to_lower(str::trim(input))
    let mut a: string = a0
    if a0 == "x86_64" is a = "amd64" end
    if a0 == "aarch64" || a0 == "arm64" is a = "arm64" end
    if a0 == "armv7l" || a0 == "armhf" is a = "armhf" end
    if a0 == "i686" || a0 == "i386" is a = "i386" end

    if !in_list(debian_arches(), a) is
        return ArchResult {
            ok: false, arch: "",
            err: "Unknown architecture '" + a + "'. Supported: " + str::join(debian_arches(), ", ")
        }
    end
    return ArchResult { ok: true, arch: a, err: "" }
end

;; Czy biezacy CPU uruchomi `target` bez emulacji.
pub fn is_native_arch(target: string) -> bool is
    let native: string = cache::detect_arch()
    if native == "amd64" && target == "i386" is return true end
    if native == "arm64" && target == "armhf" is return true end
    return native == target
end

