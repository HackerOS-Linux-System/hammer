use "std -> fs"      from "fs"
use "std -> env"     from "env"
use "std -> strings" from "str"
use "bit -> colors"

mod internal
mod ui

;; hammer -> internal::livecheck
;;
;; Port of source-code/internal/livecheck.rs (Rust) to H#.
;; Wykrywanie systemu live oraz kontenerow (Docker/Podman/WSL/nspawn/LXC).
;;
;; ── Odejscia od oryginalu (swiadome, udokumentowane) ────────────────────
;; 1. `Option<String>` -> `string?` (`live_reason`, `container_reason`).
;; 2. `read_to_string(..).unwrap_or_default()` -> `read_or_empty` (brak
;;    pliku = ""), bo `fs::read` na nieistniejacym pliku nie jest
;;    zdefiniowane.
;; 3. `std::process::exit(2)` -> wbudowane `exit(2)` (jak w `cmd_sandbox`).
;; 4. Komunikat o przebudowie: `cargo build --features normal-mode` ->
;;    `bit build-normal` (patrz `Bit.hk` i `internal/build_mode.h#`).
;; 5. BLAD ORYGINALU zachowany celowo: `check_wsl` uznaje kazdy kernel,
;;    ktorego `/proc/version` zawiera "microsoft" (rowniez maszyny Hyper-V
;;    z innym userlandem). Nie zmieniam semantyki w porcie 1:1.
;; 6. `check_hostname`: `to_lowercase` + te same wzorce (`-live` zawarte,
;;    prefiks `live-`).

fn read_or_empty(path: string) -> string is
    if !fs::exists(path) is return "" end
    return fs::read(path)
end

fn has(hay: string, needle: string) -> bool is
    return compat::str_index_of(hay, needle) >= 0
end

;; ── Wykrywanie live ──────────────────────────────────────────────────────

fn check_cmdline() -> bool is
    if !fs::exists("/proc/cmdline") is return false end
    let cmdline: string = fs::read("/proc/cmdline")
    let markers: [string] = ["boot=live", "live-media", "toram", "findiso",
        "fromiso", "live_dir=", "live-config", "USERNAME=user", "LIVE_HOSTNAME="]
    let mut i: int = 0
    while i < markers.len() is
        if has(cmdline, markers[i]) is return true end
        i += 1
    end
    return false
end

fn check_live_dirs() -> bool is
    return fs::exists("/run/live") || fs::exists("/etc/live") ||
        fs::exists("/lib/live") || fs::exists("/run/initramfs/live")
end

fn is_live_fstype(t: string) -> bool is
    return t == "overlay" || t == "overlayfs" || t == "aufs" || t == "tmpfs"
end

fn check_root_filesystem() -> bool is
    if !fs::exists("/proc/mounts") is return false end
    let lines: [string] = str::split(fs::read("/proc/mounts"), "\n")
    let mut i: int = 0
    while i < lines.len() is
        let parts: [string] = str::split_whitespace(lines[i])
        if parts.len() >= 3 && parts[1] == "/" is
            return is_live_fstype(parts[2])
        end
        i += 1
    end
    return false
end

fn is_fstab_nonreal(t: string) -> bool is
    return t == "tmpfs" || t == "overlay" || t == "none"
end

;; Brak /etc/fstab => true (jak w Rust: `else { return true }`).
fn check_fstab() -> bool is
    if !fs::exists("/etc/fstab") is return true end
    let lines: [string] = str::split(fs::read("/etc/fstab"), "\n")
    let mut i: int = 0
    while i < lines.len() is
        let l: string = lines[i]
        let t: string = str::trim(l)
        if t != "" && str::slice(str::trim_start(l), 0, 1) != "#" is
            let parts: [string] = str::split_whitespace(l)
            if parts.len() >= 3 && parts[1] == "/" && !is_fstab_nonreal(parts[2]) is
                return false
            end
        end
        i += 1
    end
    return true
end

fn check_hostname() -> bool is
    let h: string = str::to_lower(str::trim(read_or_empty("/etc/hostname")))
    if h == "" is return false end
    if h == "debian-live" || h == "live" || h == "hackeros-live" || h == "kali" || h == "ubuntu-live" is
        return true
    end
    return has(h, "-live") || str::slice(h, 0, 5) == "live-"
end

pub fn is_live_system() -> bool is
    return check_cmdline() || check_live_dirs() || check_root_filesystem() ||
        check_fstab() || check_hostname()
end

pub fn live_reason() -> string? is
    if check_cmdline() is return "kernel cmdline contains live boot parameters" end
    if check_live_dirs() is return "/run/live or /etc/live/config detected" end
    if check_root_filesystem() is return "root filesystem is overlay/tmpfs (live layer)" end
    if check_fstab() is return "no persistent root entry in /etc/fstab" end
    if check_hostname() is return "hostname matches live system default" end
    return nil
end

;; ── Kontenery ────────────────────────────────────────────────────────────

fn check_docker() -> bool is
    return fs::exists("/.dockerenv") ||
        has(read_or_empty("/proc/1/cgroup"), "docker") ||
        env::get("container") == "docker"
end

fn check_podman() -> bool is
    return fs::exists("/run/.containerenv") || env::get("container") == "podman"
end

fn check_wsl() -> bool is
    return env::get("WSL_DISTRO_NAME") != "" || env::get("WSL_INTEROP") != "" ||
        has(str::to_lower(read_or_empty("/proc/version")), "microsoft")
end

fn check_systemd_nspawn() -> bool is
    return env::get("container") == "systemd-nspawn" || fs::exists("/run/host")
end

fn check_lxc() -> bool is
    return fs::exists("/proc/1/environ") && has(read_or_empty("/proc/1/environ"), "container=lxc")
end

pub fn is_container() -> bool is
    return check_docker() || check_podman() || check_wsl() || check_systemd_nspawn() || check_lxc()
end

pub fn container_reason() -> string? is
    if check_docker() is return "running inside Docker container" end
    if check_podman() is return "running inside Podman container" end
    if check_wsl() is return "running inside WSL (Windows Subsystem for Linux)" end
    if check_systemd_nspawn() is return "running inside systemd-nspawn container" end
    if check_lxc() is return "running inside LXC container" end
    return nil
end

;; Ostrzega (bez przerywania), gdy dziala w kontenerze.
pub fn warn_if_container() is
    let r: string? = container_reason()
    if r != nil is
        let reason: string = r
        ui::eprint_line("")
        ui::eprint_line("  " + colors::bold(colors::yellow("⚠")) + "  hammer in container: " + reason)
        ui::eprint_line("  Some features (immutable FS, GRUB, systemd services) will not work.")
        ui::eprint_line("")
    end
end

;; Konczy proces kodem 2, gdy to system live (Rust: `assert_not_live`).
pub fn assert_not_live() is
    if is_live_system() is
        ui::eprint_line("")
        ui::eprint_line("  " + colors::bold(colors::red("✗")) + "  hammer cannot be used in a live system.")
        ui::eprint_line("")
        ui::eprint_line("  HackerOS must be " + colors::bold("installed to disk") + " before using hammer.")
        ui::eprint_line("  To install HackerOS, use the installer from the live environment.")
        let r: string? = container_reason()
        if r != nil is
            let reason: string = r
            ui::eprint_line("")
            ui::eprint_line("  Detected: " + reason + ".")
            ui::eprint_line("  This binary was built for the " + colors::bold("atomic") + " mode (generations +")
            ui::eprint_line("  immutable store), which needs a real installed root and doesn't apply")
            ui::eprint_line("  inside a container. For classic apt-style package management that works")
            ui::eprint_line("  anywhere — including containers — rebuild with:")
            ui::eprint_line("")
            ui::eprint_line("      bit build-normal")
            ui::eprint_line("")
            ui::eprint_line("  Run 'hammer features' on a binary to check which mode it was built with.")
        end
        ui::eprint_line("")
        exit(2)
    end
end
