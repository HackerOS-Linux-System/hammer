;; hammer -> cli::cli_pkg
;;
;; Port of source-code/cli/pkg.rs (Rust) to H#: komendy pakietowe w trybie
;; systemowym — install, reinstall, remove, upgrade, dist-upgrade, autoremove,
;; fix-broken, sync, self-update, search, info, list, mark, download.
;;
;; ── Odejscia od oryginalu (swiadome, udokumentowane) ────────────────────
;; 1. `async fn` -> zwykle funkcje; `anyhow::Result<()>` -> `string` ("" = OK).
;; 2. `let _lock = lock::system_lock()?` (zwalniany przez `Drop`) -> kazda
;;    komenda to cienka otoczka (`lock_then`), ktora bierze blokade, wola
;;    wlasciwa funkcje `*_inner` i ZAWSZE zwalnia blokade. Kolejnosc jak w
;;    Rust: sprawdzenie uzycia -> blokada -> `print_header`.
;; 3. Tryb `--user` (`run_user`, `cmd_user_*`) jest w `cli/cli_user.h#`.
;; 4. Krok "HackerOS tools" w `cmd_upgrade` (`hk_tools::update_all_tools`)
;;    wola `pending::update_all_tools_stub()` (wypisuje, ze pominieto).
;; 5. `serde_json::json!` w `cmd_list --json` -> `json_output::{jobj,jfield}` z
;;    kluczami ALFABETYCZNIE (serde_json: BTreeMap) i `json_output::pretty`.
;; 6. `cmd_download`: pobieranie `curl -fsSL --retry 3` do pliku (bez
;;    wczytywania calosci w pamiec), skrot `sha256sum`, rozmiar z `fs::size`.
;;    `{:.1}` -> jedno miejsce po przecinku liczone na calkowitych.
;; 7. `results.sort_by(name)` -> `sort_pkgs` (scalanie, stabilne).
;; 8. ZACHOWANE: `cmd_list` bez flag wypisuje WSZYSTKIE pakiety z cache (setki
;;    tysiecy wierszy dla pelnego indeksu Debiana) — bez stronicowania.

fn append_str(a: [string], x: string) -> [string] is
    let mut o: [string] = a
    o.push(x)
    return o
end

fn shq(s: string) -> string is
    return "'" + str::replace_all(s, "'", "'\\''") + "'"
end

fn joined(xs: [string], sep: string) -> string is
    return str::join(xs, sep)
end

;; Architektura: `--arch=...` (znormalizowana) albo wykryta.
pub struct ArchPick is
    pub arch: string
    pub err:  string
end

fn pick_arch(flags: cli_types::GlobalFlags) -> ArchPick is
    if flags.arch != nil is
        let a: string = flags.arch
        let r: userenv::ArchResult = userenv::normalise_arch(a)
        if !r.ok is return ArchPick { arch: "", err: r.err } end
        return ArchPick { arch: r.arch, err: "" }
    end
    return ArchPick { arch: cache::detect_arch(), err: "" }
end

;; Nazwy zainstalowanych pakietow (kontekst dla szybkiego ladowania indeksu).
fn installed_names(idb: db::InstalledDb) -> [string] is
    let all: [db::InstalledPackage] = idb.list_all()
    let mut out: [string] = []
    let mut i: int = 0
    while i < all.len() is
        out.push(all[i].name)
        i += 1
    end
    return out
end

fn reading_lists() is
    write("  " + ui::dim("·") + " Reading package lists…")
end

;; Wola `body(...)` pod systemowa blokada hammera. Zwalnia ja ZAWSZE.
fn with_lock_result(err_before: string, lr: lock::LockResult, body_err: string) -> string is
    lock::lock_release(lr.lock)
    return body_err
end

;; ── Sortowanie ───────────────────────────────────────────────────────────

fn sort_pkgs(items: [package::Package]) -> [package::Package] is
    let n: int = items.len()
    if n < 2 is return items end
    let mut src: [package::Package] = items
    let mut width: int = 1
    while width < n is
        let mut dst: [package::Package] = []
        let mut i: int = 0
        while i < n is
            let mid: int = if i + width < n then i + width else n
            let hi: int = if i + 2 * width < n then i + 2 * width else n
            let mut l: int = i
            let mut r: int = mid
            while l < mid && r < hi is
                if src[r].name < src[l].name is
                    dst.push(src[r])
                    r += 1
                else is
                    dst.push(src[l])
                    l += 1
                end
            end
            while l < mid is
                dst.push(src[l])
                l += 1
            end
            while r < hi is
                dst.push(src[r])
                r += 1
            end
            i += 2 * width
        end
        src = dst
        width = width * 2
    end
    return src
end

;; ── Wspolny krok: pokaz plan, potwierdz, wykonaj ─────────────────────────

fn run_plan(plan: solver::TransactionPlan, idb: db::InstalledDb, arch: string, confirm_msg: string,
        yes: bool, explicit: [string], is_upgrade: bool, note: string) -> string is
    ui::print_transaction_table(plan, arch)
    ui::print_transaction_summary(plan)
    if !yes && !ui::confirm(confirm_msg) is
        write("  Aborted.")
        return ""
    end
    let ctx: transaction::TransactionContext = transaction::context_system(plan, idb, explicit, is_upgrade)
    return transaction::run_transaction(ctx, note)
end

;; ── install ──────────────────────────────────────────────────────────────

pub fn cmd_install(args: [string], flags: cli_types::GlobalFlags) -> string is
    let yes: bool = cli_types::has_flag(args, "-y") || cli_types::has_flag(args, "--yes") || flags.yes
    let names: [string] = cli_types::non_flag_args(args)
    if names.len() == 0 is
        return "Usage: hammer install <package...> [-y] [--arch=ARCH] [--no-recommends]"
    end
    let no_recomm: bool = cli_types::has_flag(args, "--no-recommends")
    let ap: ArchPick = pick_arch(flags)
    if ap.err != "" is return ap.err end

    let lr: lock::LockResult = lock::system_lock()
    if lr.err != "" is return lr.err end
    let e: string = install_inner(names, yes, no_recomm, ap.arch)
    return with_lock_result("", lr, e)
end

fn install_inner(names: [string], yes: bool, no_recomm: bool, arch: string) -> string is
    ui::print_header()
    reading_lists()
    let idb: db::InstalledDb = db::InstalledDb::open()
    ;; Tylko zadane pakiety + ich zaleznosci (natywny awk) — NIE caly indeks
    ;; (~71 tys. pakietow), ktory w H# ladowal sie dziesiatki minut.
    let c: cache::PackageCache = cache::cache_load_for_install(names, installed_names(idb), no_recomm)
    let s: solver::Solver = solver::solver_new(c, idb)
    let pr: solver::PlanResult = solver::solver_resolve_install(s, names, no_recomm)
    if pr.err != "" is return pr.err end
    let plan: solver::TransactionPlan = pr.plan
    if solver::plan_is_empty(plan) is
        ui::nothing_to_do()
        return ""
    end

    let mut i: int = 0
    while i < plan.conflicts.len() is
        write("  " + ui::yellow_bold("warn:") + " " + ui::yellow(plan.conflicts[i]))
        i += 1
    end
    ui::deps_resolved()
    return run_plan(plan, idb, arch, "Proceed with installation?", yes, names, false, "install " + joined(names, " "))
end

