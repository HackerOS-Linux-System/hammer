;; ── mark ─────────────────────────────────────────────────────────────────

pub fn cmd_mark(args: [string]) -> string is
    let reason_str: string = if args.len() > 0 then args[0] else "manual"
    let mut reason: db::InstallReason = db::InstallReason::User
    if reason_str == "auto" || reason_str == "automatic" is
        reason = db::InstallReason::Dependency
    elsif reason_str == "manual" || reason_str == "user" is
        reason = db::InstallReason::User
    else is
        return "Unknown reason '" + reason_str + "'. Use: hammer mark [auto|manual] <pkg…>"
    end

    let mut names: [string] = []
    let mut i: int = 1
    while i < args.len() is
        if string_slice(args[i], 0, 1) != "-" is names.push(args[i]) end
        i += 1
    end
    if names.len() == 0 is return "Usage: hammer mark [auto|manual] <package…>" end

    let idb: db::InstalledDb = db::InstalledDb::open()
    let mut k: int = 0
    while k < names.len() is
        if idb.get(names[k]) == nil is
            ui::eprint_line("  " + ui::yellow("!") + " '" + names[k] + "' is not installed.")
        else is
            let e: string = idb.set_reason(names[k], reason)
            if e != "" is return e end
            audit::record_mark(names[k], reason_str)
            log::info("mark: " + names[k] + " set to " + reason_str)
            write("  " + ui::bright_green("✔") + " " + ui::bold(names[k]) + " → " + ui::cyan(reason_str))
        end
        k += 1
    end
    return ""
end

;; ── download ─────────────────────────────────────────────────────────────

fn format_bytes(b: int) -> string is
    if b < 1024 is return to_string(b) + " B" end
    if b < 1024 * 1024 is return fixed1(b, 1024) + " KiB" end
    if b < 1024 * 1024 * 1024 is return fixed1(b, 1024 * 1024) + " MiB" end
    let hundredths: int = (b * 100) / (1024 * 1024 * 1024)
    return to_string(hundredths / 100) + "." + pad2(hundredths % 100) + " GiB"
end

fn pad2(n: int) -> string is
    if n < 10 is return "0" + to_string(n) end
    return to_string(n)
end

;; `b / unit` z jednym miejscem po przecinku (zaokraglenie jak `{:.1}`).
fn fixed1(b: int, unit: int) -> string is
    let tenths: int = (b * 10 + unit / 2) / unit
    return to_string(tenths / 10) + "." + to_string(tenths % 10)
end

pub fn cmd_download(args: [string]) -> string is
    let names: [string] = cli_types::non_flag_args(args)
    if names.len() == 0 is return "Usage: hammer download <package> [--arch=ARCH] [--no-verify]" end
    let name: string = names[0]
    let no_verify: bool = cli_types::has_flag(args, "--no-verify")
    let arch: string = cache::detect_arch()

    let one: [string] = [name]
    let c: cache::PackageCache = cache::cache_load_names(one)
    let po: package::Package? = cache::cache_get(c, name)
    if po == nil is return "Package '" + name + "' not found. Run 'hammer sync'." end
    let pkg: package::Package = po
    if pkg.filename == nil is return "No Filename field for '" + name + "'" end
    if pkg.repo_base_uri == nil is return "No base URI known for '" + name + "'" end
    let filename: string = pkg.filename
    let base_uri: string = pkg.repo_base_uri

    let mut url: string = ""
    if string_starts_with(filename, "http://") || string_starts_with(filename, "https://") is
        url = filename
    else is
        let mut b: int = string_len(base_uri)
        while b > 0 && string_at(base_uri, b - 1) == "/" is
            b -= 1
        end
        let mut f: int = 0
        while f < string_len(filename) && string_at(filename, f) == "/" is
            f += 1
        end
        url = str::slice(base_uri, 0, b) + "/" + str::slice(filename, f, string_len(filename))
    end

    let out_file: string = name + "_" + str::replace_all(pkg.version, ":", "_") + ".deb"
    write("  " + ui::accent_bold("⬡") + "  Downloading " + ui::bold(out_file) + "…")
    write("  " + ui::dim("·") + "  URL: " + ui::dim(url))

    let dl: string = str::trim(proc::shell("curl -fsSL --retry 3 -o " + shq(out_file) + " " + shq(url) + " >/dev/null 2>&1; echo $?"))
    if dl != "0" is
        fs::remove(out_file)
        return "Downloading " + url + " failed (curl exit " + dl + ")"
    end

    ;; SHA-256
    if pkg.sha256 != nil is
        let expected: string = pkg.sha256
        let out: string = str::trim(proc::shell("sha256sum -- " + shq(out_file) + " 2>/dev/null"))
        let actual: string = if out == "" then "" else str::slice(out, 0, compat::str_index_of(out, " "))
        if actual != expected is
            return "SHA-256 mismatch for '" + name + "'!\n  Expected: " + expected + "\n  Got:      " + actual
        end
        write("  " + ui::bright_green("✔") + " SHA-256 verified.")
    else is
        write("  " + ui::yellow("⚠") + " No expected checksum in cache — skipping verification.")
    end
    write("  " + ui::bright_green_bold("✔") + " Saved: " + ui::cyan(out_file))

    if !no_verify is
        let se: string = audit::verify_package_signature(out_file)
        if se == "" is
            write("  " + ui::bright_green("✔") + " Signature OK.")
        else is
            ui::eprint_line("  " + ui::yellow("⚠") + " Signature warning: " + se)
            ui::eprint_line("  " + ui::dim("·") + " Use " + ui::cyan("--no-verify") + " to skip.")
        end
    end

    write("")
    write("  " + ui::bold("Size:") + "  " + ui::dim(format_bytes(fs::size(out_file))))
    return ""
end
