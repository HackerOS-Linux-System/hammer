;; ── upgrade ──────────────────────────────────────────────────────────────

pub fn cmd_upgrade(args: [string], flags: cli_types::GlobalFlags) -> string is
    let yes: bool = cli_types::has_flag(args, "-y") || flags.yes
    let only_system: bool = cli_types::has_flag(args, "--system")
    let only_hackeros: bool = cli_types::has_flag(args, "--hackeros")
    let only_hammer: bool = cli_types::has_flag(args, "--hammer")
    let pkgs: [string] = cli_types::non_flag_args(args)

    let do_system: bool = only_system || (!only_hackeros && !only_hammer)
    let do_hackeros: bool = only_hackeros || (!only_system && !only_hammer)
    let do_hammer: bool = only_hammer || (!only_system && !only_hackeros)

    ui::print_header()

    if do_system is
        let lr: lock::LockResult = lock::system_lock()
        if lr.err != "" is return lr.err end
        let e: string = upgrade_system(pkgs, yes, flags)
        lock::lock_release(lr.lock)
        if e != "" is return e end
    end

    if do_hackeros is
        let e2: string = hk_tools::update_all_tools()
        if e2 != "" is return e2 end
    end

    if do_hammer is
        write("  " + ui::cyan_bold("⬡") + "  Checking for hammer self-update…")
        let chk: selfupdate::UpdateCheck = selfupdate::check_for_update()
        if chk.err != "" is
            write("  " + ui::yellow("!") + " Self-update check failed: " + chk.err)
        elsif chk.newer != "" is
            write("  " + ui::yellow_bold("↑") + " New hammer version: " + ui::bright_cyan(chk.newer))
            write("  Run " + ui::cyan("hammer self-update") + " to update.")
        else is
            write("  " + ui::bright_green("✔") + " hammer is up to date.")
        end
    end
    return ""
end

fn upgrade_system(pkgs: [string], yes: bool, flags: cli_types::GlobalFlags) -> string is
    let ap: ArchPick = pick_arch(flags)
    if ap.err != "" is return ap.err end
    reading_lists()
    let idb: db::InstalledDb = db::InstalledDb::open()
    let c: cache::PackageCache = cache::cache_load_subset(pkgs, installed_names(idb), true, true)
    let s: solver::Solver = solver::solver_new(c, idb)
    let pr: solver::PlanResult = if pkgs.len() == 0 then solver::solver_resolve_upgrade(s) else solver::solver_resolve_install(s, pkgs, false)
    if pr.err != "" is return pr.err end
    let plan: solver::TransactionPlan = pr.plan

    if solver::plan_is_empty(plan) is
        write("  " + ui::bright_green("✔") + " All Debian packages up to date.")
        return ""
    end
    ui::deps_resolved()
    let mut explicit: [string] = []
    let mut i: int = 0
    while i < plan.to_upgrade.len() is
        explicit.push(plan.to_upgrade[i].name)
        i += 1
    end
    return run_plan(plan, idb, ap.arch, "Proceed with upgrade?", yes, explicit, true, "upgrade")
end

