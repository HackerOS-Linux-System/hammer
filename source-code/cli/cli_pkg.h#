;; ── search / info / list ─────────────────────────────────────────────────

pub fn cmd_search(args: [string], flags: cli_types::GlobalFlags) -> string is
    let installed_only: bool = cli_types::has_flag(args, "--installed")
    let query: string = joined(cli_types::non_flag_args(args), " ")
    if query == "" is return "Usage: hammer search <query> [--installed] [--json]" end
    let ap: ArchPick = pick_arch(flags)
    if ap.err != "" is return ap.err end
    let idb: db::InstalledDb = db::InstalledDb::open()
    let c: cache::PackageCache = cache::cache_load_search(query)

    ;; zbior zainstalowanych nazw budowany RAZ — `idb.is_installed` na kazdy wynik
    ;; uruchamialo sqlite3 i parsowalo dpkg/status od nowa (setki razy przy `search`).
    let inst_set: any = col::hashmap_new()
    let inst_list: [string] = installed_names(idb)
    let mut ni: int = 0
    while ni < inst_list.len() is
        col::hashmap_insert(inst_set, inst_list[ni], "1")
        ni += 1
    end

    let found: [package::Package] = cache::cache_search(c, query)
    let mut filtered: [package::Package] = []
    let mut i: int = 0
    while i < found.len() is
        if !installed_only || col::hashmap_contains(inst_set, found[i].name) is filtered.push(found[i]) end
        i += 1
    end
    let results: [package::Package] = sort_pkgs(filtered)

    if flags.json is
        json_output::print_search_json(results, idb)
        return ""
    end
    ui::print_search_header(query, results.len())
    let mut k: int = 0
    while k < results.len() is
        ui::print_search_result(results[k], col::hashmap_contains(inst_set, results[k].name))
        k += 1
    end
    return ""
end

pub fn cmd_info(args: [string], flags: cli_types::GlobalFlags) -> string is
    if args.len() == 0 is return "Usage: hammer info <package>" end
    let name: string = args[0]
    let ap: ArchPick = pick_arch(flags)
    if ap.err != "" is return ap.err end
    let idb: db::InstalledDb = db::InstalledDb::open()
    let one: [string] = [name]
    let c: cache::PackageCache = cache::cache_load_names(one)
    let po: package::Package? = cache::cache_get(c, name)
    if po == nil is return "Package '" + name + "' not found. Run `hammer sync`." end
    let pkg: package::Package = po
    let inst: db::InstalledPackage? = idb.get(name)
    if flags.json is
        json_output::print_package_json(pkg, inst)
        return ""
    end
    let iv: string? = if inst == nil then nil else inst.version
    ui::print_package_info(pkg, inst != nil, iv)
    return ""
end

fn repo_label(p: package::Package, fallback: string) -> string is
    if p.repo_base_uri == nil is return fallback end
    let uri: string = p.repo_base_uri
    let i: int = string_rfind(uri, "/")
    if i < 0 is return uri end
    let last: string = str::slice(uri, i + 1, string_len(uri))
    if last == "" is return fallback end
    return last
end

pub fn cmd_list(args: [string]) -> string is
    let json_mode: bool = cli_types::has_flag(args, "--json")
    let installed_only: bool = cli_types::has_flag(args, "--installed") || cli_types::has_flag(args, "-i")
    let upgrades_only: bool = cli_types::has_flag(args, "--upgrades") || cli_types::has_flag(args, "-u") || cli_types::has_flag(args, "--upgradable")
    let idb: db::InstalledDb = db::InstalledDb::open()
    ;; --installed / --upgradable potrzebuja tylko wersji z repo dla zainstalowanych pakietow.
    let c: cache::PackageCache = if installed_only || upgrades_only then cache::cache_load_for_installed(installed_names(idb)) else cache::cache_load()

    if json_mode is
        let mut out: [string] = []
        if installed_only || upgrades_only is
            let all: [db::InstalledPackage] = idb.list_all()
            let mut i: int = 0
            while i < all.len() is
                let inst: db::InstalledPackage = all[i]
                let av: package::Package? = cache::cache_get(c, inst.name)
                let mut new_ver: string? = nil
                if av != nil is
                    let ap: package::Package = av
                    if package::version_cmp(ap.version, inst.version) > 0 is new_ver = ap.version end
                end
                if !(upgrades_only && new_ver == nil) is
                    out.push(json_output::jobj([
                        json_output::jfield("arch", json_output::jstr(inst.architecture)),
                        json_output::jfield("installed", "true"),
                        json_output::jfield("name", json_output::jstr(inst.name)),
                        json_output::jfield("new_version", json_output::jstr_opt(new_ver)),
                        json_output::jfield("reason", json_output::jstr(db::reason_to_str(inst.reason))),
                        json_output::jfield("section", json_output::jstr_opt(inst.section)),
                        json_output::jfield("version", json_output::jstr(inst.version))]))
                end
                i += 1
            end
        else is
            let pkgs: [package::Package] = cache::cache_all_packages(c)
            let mut j: int = 0
            while j < pkgs.len() is
                let p: package::Package = pkgs[j]
                out.push(json_output::jobj([
                    json_output::jfield("arch", json_output::jstr(p.architecture)),
                    json_output::jfield("description", json_output::jstr_opt(p.description_short)),
                    json_output::jfield("installed", json_output::jbool(idb.is_installed(p.name))),
                    json_output::jfield("name", json_output::jstr(p.name)),
                    json_output::jfield("new_version", "null"),
                    json_output::jfield("section", json_output::jstr_opt(p.section)),
                    json_output::jfield("version", json_output::jstr(p.version))]))
                j += 1
            end
        end
        write(json_output::pretty(json_output::jarr(out)))
        return ""
    end

    if installed_only || upgrades_only is
        let all2: [db::InstalledPackage] = idb.list_all()
        let mut k: int = 0
        while k < all2.len() is
            let inst2: db::InstalledPackage = all2[k]
            let ao: package::Package? = cache::cache_get(c, inst2.name)
            let mut nv: string? = nil
            let mut repo: string = "installed"
            if ao != nil is
                let a2: package::Package = ao
                if package::version_cmp(a2.version, inst2.version) > 0 is nv = a2.version end
                repo = repo_label(a2, "installed")
            end
            if !(upgrades_only && nv == nil) is
                ui::print_list_entry(inst2.name, inst2.version, inst2.architecture, true, repo, nv)
            end
            k += 1
        end
    else is
        let pkgs2: [package::Package] = cache::cache_all_packages(c)
        let mut m: int = 0
        while m < pkgs2.len() is
            let p2: package::Package = pkgs2[m]
            ui::print_list_entry(p2.name, p2.version, p2.architecture, idb.is_installed(p2.name), repo_label(p2, ""), nil)
            m += 1
        end
    end
    return ""
end

