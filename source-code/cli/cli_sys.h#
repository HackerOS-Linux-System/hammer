;; hammer -> cli::cli_sys
;;
;; Port of source-code/cli/sys.rs (Rust) to H#: komendy systemowe — status,
;; history, service, log, immutable, diff, gen, rollback, pending, verify,
;; doctor, export/import, key, gc, clean, init, relink, store, boot, why,
;; why-not, fsck, check, daemon, db. (Czesc 1: do `doctor`; reszta nizej.)
;;
;; ── Odejscia od oryginalu (swiadome, udokumentowane) ────────────────────
;; 1. `async fn` -> zwykle funkcje; `anyhow::Result<()>` -> `string`.
;; 2. Blokada: `let _lock = lock::system_lock()?` (zwalniana przez `Drop`) ->
;;    kazda komenda bierze blokade i zwalnia ja w KAZDEJ sciezce wyjscia
;;    (`unlock`).
;; 3. `hk_tools::list_tools()` (sekcje "HackerOS tools" w `cmd_status` i
;;    `cmd_doctor`) POMINIETE — `tools/hk_tools.rs` nie jest przepisany.
;; 4. `walkdir` (sprawdzenie zawieszonych dowiazan w `cmd_verify`) -> `find`
;;    ze skryptem `sh`; kryterium jak w Rust: dowiazanie jest OK, jesli jego
;;    cel istnieje lub (`symlink_metadata`) sam jest dowiazaniem. UWAGA: Rust
;;    sprawdza cel wzgledem BIEZACEGO katalogu procesu (nie katalogu
;;    dowiazania) — dla celow wzglednych daje falszywe "dangling"; zachowane.
;; 5. `serde_json::json!(..)` w `history --diff` drukowane kompaktowo (jedna
;;    linia), a `history --json` pretty — klucze alfabetycznie (serde_json).
;; 6. `HashSet::difference` -> petle z `sorting::sorted`.
;; 7. `gdb.generations.retain(..)` w `gen gc/delete` -> przebudowa tablicy.
;; 8. `gpgv --version` sprawdzane przez `command -v gpgv`.
;; 9. ZACHOWANE: `cmd_history -n N` wymaga OSOBNEGO argumentu (`-n 20`); forma
;;    `-n20` (jak w `json_output::cmd_history` i `cmd_log`) jest tu ignorowana.

fn shq(s: string) -> string is
    return "'" + str::replace_all(s, "'", "'\\''") + "'"
end

fn sh_ok(cmd: string) -> bool is
    return str::trim(proc::shell("(" + cmd + ") >/dev/null 2>&1 && echo ok || echo fail")) == "ok"
end

fn contains_str(xs: [string], s: string) -> bool is
    let mut i: int = 0
    while i < xs.len() is
        if xs[i] == s is return true end
        i += 1
    end
    return false
end

fn append_str(a: [string], x: string) -> [string] is
    let mut o: [string] = a
    o.push(x)
    return o
end

fn rule(n: int) -> string is
    return "  " + ui::dim(str::repeat("─", n))
end

fn count_str(n: int, one: string, many: string) -> string is
    if n == 1 is return one end
    return many
end

;; Bierze blokade systemowa; przy bledzie zwraca (lock, err).
fn take_lock() -> lock::LockResult is
    return lock::system_lock()
end

