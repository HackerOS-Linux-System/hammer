fn export_manifest(gdb: profile::GenerationsDb, gen: profile::Generation) -> string is
    let mut pk: [string] = []
    let mut i: int = 0
    while i < gen.packages.len() is
        pk.push(json_output::jobj([
            json_output::jfield("name", json_output::jstr(gen.packages[i].name)),
            json_output::jfield("version", json_output::jstr(gen.packages[i].version)),
            json_output::jfield("store_hash", json_output::jstr(gen.packages[i].store_hash))]))
        i += 1
    end
    return json_output::pretty(json_output::jobj([
        json_output::jfield("generation", json_output::jint(gdb.current)),
        json_output::jfield("hammer_version", json_output::jstr(build_mode::hammer_version())),
        json_output::jfield("note", json_output::jstr_opt(gen.note)),
        json_output::jfield("packages", json_output::jarr(pk))]))
end

pub fn cmd_export(args: [string]) -> string is
    let output: string = if args.len() > 0 then args[0] else "hammer-export.tar.gz"
    let lr: profile::LoadResult = profile::db_load()
    if lr.err != "" is return lr.err end
    let gdb: profile::GenerationsDb = lr.db
    let go: profile::Generation? = profile::db_get(gdb, gdb.current)
    if go == nil is return "No current generation" end
    let gen: profile::Generation = go

    let stage: string = str::trim(proc::shell("mktemp -d /tmp/hammer-export.XXXXXX"))
    if stage == "" is return "Cannot create temp dir" end
    proc::shell("mkdir -p " + shq(stage + "/store"))
    if !fs::write(stage + "/hammer-manifest.json", export_manifest(gdb, gen)) is
        proc::shell("rm -rf -- " + shq(stage))
        return "Cannot write manifest"
    end
    let mut added: int = 0
    let mut i: int = 0
    while i < gen.packages.len() is
        let pkg: profile::GenPackage = gen.packages[i]
        let entry: string = pkg.name + "-" + pkg.version + "-" + pkg.store_hash
        let sp: string = compat::path_join(store::store_dir(), entry)
        if fs::exists(sp) is
            proc::shell("ln -s -- " + shq(sp) + " " + shq(stage + "/store/" + entry))
            added += 1
        end
        i += 1
    end
    let rc: string = str::trim(proc::shell("tar -czhf " + shq(output) + " -C " + shq(stage) + " hammer-manifest.json store >/dev/null 2>&1; echo $?"))
    proc::shell("rm -rf -- " + shq(stage))
    if rc != "0" is return "tar failed creating " + output + " (exit " + rc + ")" end
    write("  " + ui::bright_green("✔") + " Exported " + to_string(added) + " packages to " + ui::bold(output))
    return ""
end

;; Wartosc klucza z JSON-a manifestu (tekst) albo "".
fn manifest_value(json: string, key: string) -> string is
    let toks: [string] = jsonlite::tokenize(json)
    let mut i: int = 0
    while i + 2 < toks.len() is
        if jsonlite::is_string_tok(toks[i]) && jsonlite::tok_text(toks[i]) == key && toks[i + 1] == ":" is
            let v: string = toks[i + 2]
            if jsonlite::is_string_tok(v) is return jsonlite::tok_text(v) end
            return v
        end
        i += 1
    end
    return ""
end

pub fn cmd_import_pkg(args: [string]) -> string is
    if args.len() == 0 is return "Usage: hammer import <file.tar.gz>" end
    let input: string = args[0]
    let lk: lock::LockResult = take_lock()
    if lk.err != "" is return lk.err end
    let e: string = import_inner(input)
    lock::lock_release(lk.lock)
    return e
end

fn import_inner(input: string) -> string is
    if !fs::exists(input) is return "No such file: " + input end
    let manifest: string = proc::shell("tar -xzOf " + shq(input) + " hammer-manifest.json 2>/dev/null")
    proc::shell("mkdir -p " + shq(store::store_dir()))
    let cnt: string = str::trim(proc::shell("tar -tzf " + shq(input) + " 2>/dev/null | grep -c '^store/'"))
    let extracted: int = if str::is_numeric(cnt) then conv::str_to_int(cnt) else 0
    ;; `store/<wpis>` -> STORE_DIR/<wpis> (bez `store/`); bledy pojedynczych wpisow ignorowane
    proc::shell("tar -xzf " + shq(input) + " -C " + shq(store::store_dir()) + " --strip-components=1 --wildcards 'store/*' >/dev/null 2>&1")
    if manifest == "" is return "No manifest found — not a hammer export?" end
    let gen: string = manifest_value(manifest, "generation")
    let ver: string = manifest_value(manifest, "hammer_version")
    write("  " + ui::bright_green("✔") + " Imported from gen-" + (if gen == "" then "0" else gen) + " (hammer " + (if ver == "" then "?" else ver) + ")")
    write("  " + ui::dim("·") + " " + to_string(extracted) + " store entries extracted.")
    return ""
end

;; ── key ──────────────────────────────────────────────────────────────────

pub fn cmd_key(args: [string]) -> string is
    let sub: string = if args.len() > 0 then args[0] else "list"
    if sub == "list" || sub == "ls" is
        let kl: gpg::KeyringLoad = gpg::db_load()
        if kl.err != "" is return kl.err end
        if kl.db.keys.len() == 0 is
            write("  " + ui::dim("·") + " No trusted keys.")
            write("  Add: " + ui::cyan("hammer key add https://ftp-master.debian.org/keys/archive-key-12.gpg"))
            return ""
        end
        let mut i: int = 0
        while i < kl.db.keys.len() is
            let key: gpg::TrustedKey = kl.db.keys[i]
            let fp: string = if string_len(key.fingerprint) >= 16 then str::slice(key.fingerprint, string_len(key.fingerprint) - 16, string_len(key.fingerprint)) else key.fingerprint
            write("  " + ui::cyan_bold(fp) + " " + ui::bold(key.name))
            i += 1
        end
        return ""
    end
    if sub == "add" is
        if args.len() < 2 is return "Usage: hammer key add <url>" end
        let r: gpg::ImportKeyResult = gpg::import_key(args[1], download::client_new())
        if !r.ok is return r.err end
        write("  " + ui::bright_green("✔") + " Imported: " + ui::bold(r.key.name))
        return ""
    end
    if sub == "remove" || sub == "rm" is
        if args.len() < 2 is return "Usage: hammer key remove <fp>" end
        let kl2: gpg::KeyringLoad = gpg::db_load()
        if kl2.err != "" is return kl2.err end
        let rr: gpg::RemoveResult = gpg::db_remove(kl2.db, args[1])
        if rr.removed is
            let se: string = gpg::db_save(rr.db)
            if se != "" is return se end
            write("  " + ui::bright_green("✔") + " Key removed.")
        else is
            write("  " + ui::dim("·") + " Key not found.")
        end
        return ""
    end
    return "Unknown key subcommand: '" + sub + "'. Try: list, add, remove"
end

;; ── gc / clean ───────────────────────────────────────────────────────────

pub fn cmd_gc(args: [string]) -> string is
    ;; `split('=').nth(1)` (patrz odejscie 12)
    let mut keep: int = 3
    let mut i: int = 0
    while i < args.len() is
        if string_starts_with(args[i], "--keep") is
            let parts: [string] = str::split(args[i], "=")
            if parts.len() > 1 && str::is_numeric(parts[1]) is keep = conv::str_to_int(parts[1]) end
            i = args.len()
        else is
            i += 1
        end
    end
    let yes: bool = cli_types::has_flag(args, "-y")

    let lk: lock::LockResult = take_lock()
    if lk.err != "" is return lk.err end
    let e: string = gc_inner(keep, yes)
    lock::lock_release(lk.lock)
    return e
end

fn gc_inner(keep: int, yes: bool) -> string is
    let lr: profile::LoadResult = profile::db_load()
    if lr.err != "" is return lr.err end
    let mut gdb: profile::GenerationsDb = lr.db
    let ao: int? = profile::read_active_gen()
    let active: int = if ao == nil then gdb.current else ao
    let pending: int? = profile::read_pending_gen()

    ;; kandydaci: bez aktywnej i oczekujacej, malejaco po numerze
    let mut cands: [profile::Generation] = []
    let mut i: int = 0
    while i < gdb.generations.len() is
        let g: profile::Generation = gdb.generations[i]
        let is_pending: bool = pending != nil && pending == g.number
        if g.number != active && !is_pending is cands.push(g) end
        i += 1
    end
    let mut sorted_c: [profile::Generation] = []
    let mut used: [bool] = []
    let mut u: int = 0
    while u < cands.len() is
        used.push(false)
        u += 1
    end
    let mut n: int = 0
    while n < cands.len() is
        let mut best: int = -1
        let mut k: int = 0
        while k < cands.len() is
            if !used[k] && (best < 0 || cands[k].number > cands[best].number) is best = k end
            k += 1
        end
        used[best] = true
        sorted_c.push(cands[best])
        n += 1
    end

    let from: int = if keep < sorted_c.len() then keep else sorted_c.len()
    let mut to_del: [profile::Generation] = []
    let mut d: int = from
    while d < sorted_c.len() is
        to_del.push(sorted_c[d])
        d += 1
    end
    if to_del.len() == 0 is
        write("  " + ui::dim("·") + " Nothing to collect.")
        return ""
    end
    let mut m: int = 0
    while m < to_del.len() is
        write("    gen-" + to_string(to_del[m].number))
        m += 1
    end
    if !yes && !ui::confirm("Proceed?") is
        write("  Aborted.")
        return ""
    end

    let mut del_nums: [int] = []
    let mut x: int = 0
    while x < to_del.len() is
        let de: string = profile::delete_profile(to_del[x])
        if de != "" is return de end
        del_nums.push(to_del[x].number)
        x += 1
    end
    let mut kept: [profile::Generation] = []
    let mut y: int = 0
    while y < gdb.generations.len() is
        let mut drop: bool = false
        let mut z: int = 0
        while z < del_nums.len() is
            if del_nums[z] == gdb.generations[y].number is drop = true end
            z += 1
        end
        if !drop is kept.push(gdb.generations[y]) end
        y += 1
    end
    gdb.generations = kept

    let mut referenced: [string] = []
    let mut r: int = 0
    while r < gdb.generations.len() is
        let mut pi: int = 0
        while pi < gdb.generations[r].packages.len() is
            let p: profile::GenPackage = gdb.generations[r].packages[pi]
            referenced.push(p.name + "-" + p.version + "-" + p.store_hash)
            pi += 1
        end
        r += 1
    end
    let ge: string = store::gc_unreferenced_pkgs(referenced)
    if ge != "" is return ge end
    let se: string = profile::db_save(gdb)
    if se != "" is return se end
    grub::update_grub(gdb)
    write("  " + ui::bright_green("✔") + " Garbage collection complete.")
    return ""
end

pub fn cmd_clean() -> string is
    let r: download::CacheResult = download::clean_cache()
    if r.err != "" is return r.err end
    write("  " + ui::bright_green("✔") + " Removed " + to_string(r.count) + " cached archive(s).")
    return ""
end

