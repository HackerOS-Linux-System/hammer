fn count_active_bins() -> int is
    let active: string = store::active_link()
    if !fs::exists(active) is return 0 end
    let subs: [string] = ["usr/bin", "usr/sbin", "usr/local/bin", "bin"]
    let mut count: int = 0
    let mut i: int = 0
    while i < subs.len() is
        let dir: string = compat::path_join(active, subs[i])
        if fs::is_dir(dir) is
            let out: string = str::trim(proc::shell("ls -A1 " + shq(dir) + " 2>/dev/null | wc -l"))
            if str::is_numeric(out) is count += conv::str_to_int(out) end
        end
        i += 1
    end
    return count
end

pub fn cmd_status() -> string is
    let idb: db::InstalledDb = db::InstalledDb::open()
    ui::print_status(idb)
    write("  " + ui::bold(fmt::pad_right("GRUB integration:", 26)) + " " + ui::dim(grub::grub_status()))
    let bg: int? = grub::read_boot_gen()
    if bg != nil is
        let n: int = bg
        write("  " + ui::bold(fmt::pad_right("Booted with:", 26)) + " gen-" + ui::cyan_bold(to_string(n)))
    end
    let active: int? = profile::read_active_gen()
    if active != nil is
        let a: int = active
        write("  " + ui::bold(fmt::pad_right("Active profile:", 26)) + " gen-" + ui::bright_green(to_string(a)))
        write("  " + ui::bold(fmt::pad_right("Binaries in PATH:", 26)) + " " + ui::cyan(to_string(count_active_bins())))
    end
    let imm: bool = immutable::is_immutable_enabled()
    let imm_s: string = if imm then ui::bright_green("enabled") else ui::yellow("disabled (run `hammer immutable enable`)")
    write("  " + ui::bold(fmt::pad_right("Immutable filesystem:", 26)) + " " + imm_s)
    ;; sekcja "HackerOS tools" pominieta (patrz odejscie 3)
    return ""
end

