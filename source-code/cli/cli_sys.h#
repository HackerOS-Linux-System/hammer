pub fn cmd_init(args: [string]) -> string is
    if cli_types::has_flag(args, "--user") is
        let er: userenv::EnvResult = userenv::user_env_current()
        if er.err != "" is return er.err end
        let ie: string = userenv::user_env_init(er.env)
        if ie != "" is return ie end
        return cli_user::cmd_user_shell_init(er.env)
    end
    let sv: string? = cli_types::flag_value(args, "--suite=")
    let suite: string = if sv == nil then "bookworm" else sv
    write("  " + ui::bold(ui::cyan("::")) + " Initialising hammer " + build_mode::hammer_version() + " (suite: " + ui::bold(suite) + ")…")

    let dirs: [string] = ["/hammer/store", "/hammer/profiles", "/hammer/db", "/hammer/db/postinst",
        "/etc/hammer", "/etc/hammer/HackerOS", "/var/cache/hammer/archives",
        "/var/lib/hammer/lists", "/usr/lib/hammer", "/usr/lib/HackerOS/hammer"]
    let mut i: int = 0
    while i < dirs.len() is
        proc::shell("mkdir -p " + shq(dirs[i]))
        if !fs::is_dir(dirs[i]) is return "Cannot create " + dirs[i] end
        write("  " + ui::dim("·") + " " + ui::dim(dirs[i]))
        i += 1
    end
    let arch: string = cache::detect_arch()
    if !fs::exists(repo::sources_hk()) is
        let we: string = repo::write_default(arch, suite)
        if we != "" is return we end
        write("  " + ui::green("✔") + " Wrote " + repo::sources_hk())
    end
    let ae: string = profile::install_activate_service()
    if ae != "" is return ae end
    let ie: string = immutable::install_immutable_service()
    if ie != "" is return ie end
    if !fs::exists(profile::generations_file()) is
        let se: string = profile::db_save(profile::db_empty())
        if se != "" is return se end
    end
    let lr: profile::LoadResult = profile::db_load()
    if lr.err != "" is return lr.err end
    let ge: string = grub::update_grub(lr.db)
    if ge != "" is
        write("  " + ui::yellow("·") + " GRUB: " + ui::dim(ge) + " (non-fatal)")
    end
    write("")
    write("  " + ui::bright_green_bold("✔") + " hammer " + build_mode::hammer_version() + " initialised.")
    write("    1. " + ui::cyan("hammer key add https://ftp-master.debian.org/keys/archive-key-12.gpg"))
    write("    2. " + ui::cyan("hammer sync"))
    write("    3. " + ui::cyan("hammer install <pkg>"))
    return ""
end

pub fn cmd_relink() -> string is
    let lr: profile::LoadResult = profile::db_load()
    if lr.err != "" is return lr.err end
    let gdb: profile::GenerationsDb = lr.db
    let ao: int? = profile::read_active_gen()
    let n: int = if ao == nil then gdb.current else ao
    let go: profile::Generation? = profile::db_get(gdb, n)
    if go == nil is return "Active generation " + to_string(n) + " not found" end
    let gen: profile::Generation = go
    let pp: string = profile::gen_profile_path(gen)
    if !fs::exists(pp) is return "Profile missing: " + pp + "\n  Try: hammer _activate" end

    write("  " + ui::accent_bold("⬡") + "  Relinking binaries for gen-" + to_string(n) + "…")
    let rr: profile::RelinkResult = profile::relink_bins(pp)
    if rr.err != "" is return "relink failed: " + rr.err end
    write("  " + ui::bright_green_bold("✔") + " Linked: " + ui::bold(to_string(rr.linked)) + "  Removed: " + ui::dim(to_string(rr.removed)))
    if rr.linked == 0 is
        write("  " + ui::dim("·") + " No binaries to link.")
    else is
        write("  Packages in PATH. Run " + ui::cyan("hash -r") + " if shell can't find them.")
    end
    return ""
end

pub fn cmd_store() -> string is
    let s: string = "/usr/share/hammer/store"
    if !fs::exists(s) is
        return "Hammer Store not installed. Run: " + ui::cyan("hammer install hammer-store")
    end
    if system(shq(s)) != 0 is return "hammer-store exited with error" end
    return ""
end

pub fn cmd_activate_internal() -> string is
    write("hammer: boot activation starting…")
    let bg: int? = grub::read_boot_gen()
    if bg != nil is
        let n: int = bg
        write("hammer: GRUB selected gen-" + to_string(n))
        let lr: profile::LoadResult = profile::db_load()
        if lr.err != "" is return lr.err end
        let go: profile::Generation? = profile::db_get(lr.db, n)
        if go != nil is
            let g: profile::Generation = go
            let se: string = profile::set_pending(g)
            if se != "" is return se end
        end
    end
    let pn: int? = profile::read_pending_gen()
    if pn != nil is
        let p: int = pn
        let ve: string = gpg::verify_boot_integrity(p)
        if ve != "" is
            ui::eprint_line("hammer: BOOT INTEGRITY FAILED: " + ve)
            exit(1)
        end
    end
    let out: profile::ActivateOutcome = profile::activate_pending()
    if !out.ok is return out.err end
    ui::print_activation_result(out.result)
    if out.result.scripts_failed.len() > 0 is
        ui::eprint_line("hammer: WARNING: postinst failed for: " + str::join(out.result.scripts_failed, ", "))
    end
    return ""
end

;; ── fsck / check ─────────────────────────────────────────────────────────

pub fn cmd_fsck(args: [string]) -> string is
    write("")
    write("  " + ui::accent_bold("⬡") + "  Hammer store filesystem check")
    write(rule(60))

    let idb: db::InstalledDb = db::InstalledDb::open()
    let all: [db::InstalledPackage] = idb.list_all()
    let sdir: string = store::store_dir()
    let mut ok: int = 0
    let mut bad: int = 0
    if !fs::exists(sdir) is
        write("  " + ui::red_bold("!") + " Store directory not found: " + sdir)
        return ""
    end

    let mut i: int = 0
    while i < all.len() is
        let pkg: db::InstalledPackage = all[i]
        let entry_name: string = pkg.name + "-" + pkg.version + "-" + pkg.store_hash
        if fs::exists(compat::path_join(sdir, entry_name)) is
            write("  " + ui::bright_green("✔") + " " + ui::bold(pkg.name) + "  " + ui::dim(pkg.version))
            ok += 1
        else is
            write("  " + ui::red_bold("✗") + " " + ui::red(pkg.name) + " — store entry missing! (" + entry_name + ")")
            bad += 1
        end
        i += 1
    end

    write("")
    if bad == 0 is
        write("  " + ui::bright_green_bold("✔") + " Store OK: " + to_string(ok) + " entries verified.")
    else is
        write("  " + ui::red_bold("✗") + " " + to_string(bad) + " store entr" + count_str(bad, "y", "ies") + " missing. Run: " + ui::cyan("hammer fix-broken"))
    end

    if cli_types::has_flag(args, "--full") || cli_types::has_flag(args, "-f") is
        let mut referenced: [string] = []
        let mut r: int = 0
        while r < all.len() is
            referenced.push(all[r].name + "-" + all[r].version + "-" + all[r].store_hash)
            r += 1
        end
        let mut orphans: int = 0
        let names: [string] = fs::list_dir(sdir)
        let mut k: int = 0
        while k < names.len() is
            if !contains_str(referenced, names[k]) is
                write("  " + ui::yellow("·") + " orphan: " + ui::dim(names[k]))
                orphans += 1
            end
            k += 1
        end
        if orphans > 0 is
            write("  " + ui::yellow("·") + " " + to_string(orphans) + " orphaned store entr" + count_str(orphans, "y", "ies") + ". Run: " + ui::cyan("hammer gc"))
        end
    end
    return ""
end

pub fn cmd_check(args: [string]) -> string is
    write("")
    write("  " + ui::accent_bold("⬡") + "  Package integrity check")
    write(rule(60))

    let idb: db::InstalledDb = db::InstalledDb::open()
    let c: cache::PackageCache = cache::cache_load()
    let all: [db::InstalledPackage] = idb.list_all()
    let names: [string] = cli_types::non_flag_args(args)

    let mut to_check: [db::InstalledPackage] = []
    let mut i: int = 0
    while i < all.len() is
        if names.len() == 0 || contains_str(names, all[i].name) is to_check.push(all[i]) end
        i += 1
    end

    let mut issues: int = 0
    let mut k: int = 0
    while k < to_check.len() is
        let pkg: db::InstalledPackage = to_check[k]
        let mut pkg_issues: [string] = []
        let avail: package::Package? = cache::cache_get(c, pkg.name)
        if avail == nil is pkg_issues.push("not in any configured repository (orphan)") end
        let sd: string = compat::path_join(store::store_dir(), pkg.name + "-" + pkg.version + "-" + pkg.store_hash)
        if !fs::exists(sd) is pkg_issues.push("store entry missing") end
        if avail != nil is
            let a: package::Package = avail
            if version::compare(a.version, pkg.version) > 0 is pkg_issues.push("update available: " + a.version) end
        end
        if pkg_issues.len() == 0 is
            if args.len() > 0 is
                write("  " + ui::bright_green("✔") + " " + ui::bold(pkg.name) + "  " + ui::dim(pkg.version))
            end
        else is
            issues += pkg_issues.len()
            write("  " + ui::yellow_bold("!") + " " + ui::bold(pkg.name) + "  " + ui::dim(pkg.version))
            let mut m: int = 0
            while m < pkg_issues.len() is
                write("      " + ui::dim("·") + " " + ui::yellow(pkg_issues[m]))
                m += 1
            end
        end
        k += 1
    end

    write("")
    if issues == 0 is
        write("  " + ui::bright_green_bold("✔") + " All " + to_string(to_check.len()) + " package(s) OK.")
    else is
        write("  " + ui::yellow_bold("!") + " " + to_string(issues) + " issue(s) found across " + to_string(to_check.len()) + " package(s).")
        write("  Run " + ui::cyan("hammer fix-broken") + " to fix broken dependencies.")
    end
    return ""
end

;; ── boot ─────────────────────────────────────────────────────────────────

pub fn cmd_boot(args: [string]) -> string is
    let sub: string = if args.len() > 0 then args[0] else "status"
    if sub == "status" is
        write("")
        write("  " + ui::accent_bold("⬡") + "  Boot status")
        write(rule(50))
        let lr: profile::LoadResult = profile::db_load()
        if lr.err != "" is return lr.err end
        let active: int? = profile::read_active_gen()
        let pending: int? = profile::read_pending_gen()
        write("  " + ui::bold(fmt::pad_right("Current generation:", 28)) + " " + ui::cyan(if active == nil then "none" else "gen-" + to_string(active)))
        write("  " + ui::bold(fmt::pad_right("Pending (next boot):", 28)) + " " + ui::yellow(if pending == nil then "none" else "gen-" + to_string(pending)))
        write("  " + ui::bold(fmt::pad_right("GRUB status:", 28)) + " " + ui::dim(grub::grub_status()))
        let bg: int? = grub::read_boot_gen()
        if bg != nil is
            let n: int = bg
            write("  " + ui::bold(fmt::pad_right("GRUB selected:", 28)) + " gen-" + ui::cyan(to_string(n)))
        end
        write("")
        return ""
    end
    if sub == "activate" is
        write("  " + ui::accent_bold("⬡") + " Activating pending generation…")
        let out: profile::ActivateOutcome = profile::activate_pending()
        if !out.ok is return out.err end
        ui::print_activation_result(out.result)
        return ""
    end
    if sub == "fallback" is
        write("  " + ui::bright_yellow_bold("⬡") + " Triggering boot fallback…")
        return boot_fallback::apply_fallback()
    end
    if sub == "update-grub" is
        let lr2: profile::LoadResult = profile::db_load()
        if lr2.err != "" is return lr2.err end
        let ge: string = grub::update_grub(lr2.db)
        if ge != "" is return ge end
        write("  " + ui::bright_green("✔") + " GRUB updated.")
        return ""
    end
    return "Unknown boot subcommand: '" + sub + "'\n  Usage: hammer boot [status|activate|fallback|update-grub]"
end

;; ── why / why-not ────────────────────────────────────────────────────────

pub fn cmd_why(args: [string]) -> string is
    if args.len() == 0 is return "Usage: hammer why <package>" end
    let name: string = args[0]
    let c: cache::PackageCache = cache::cache_load()
    let idb: db::InstalledDb = db::InstalledDb::open()
    let s: solver::Solver = solver::solver_new(c, idb)

    write("")
    write("  " + ui::accent_bold("⬡") + "  Why is '" + ui::bold(name) + "' installed?")
    write(rule(60))
    if !idb.is_installed(name) is
        write("  " + ui::dim("·") + " '" + name + "' is not installed.")
        return ""
    end
    let reasons: [string] = explain::why_installed(s, name)
    if reasons.len() == 0 is
        write("  " + ui::dim("·") + " No dependents found — possibly a manually installed package.")
    else is
        let mut i: int = 0
        while i < reasons.len() is
            write("  " + ui::dim("·") + " " + ui::cyan(reasons[i]))
            i += 1
        end
    end
    let io: db::InstalledPackage? = idb.get(name)
    if io != nil is
        let inst: db::InstalledPackage = io
        write("")
        let reason_str: string = if db::reason_to_str(inst.reason) == "user" then ui::green("manually installed") else ui::yellow("installed as dependency")
        write("  " + ui::bold(fmt::pad_right("Install reason:", 28)) + " " + reason_str)
        write("  " + ui::bold(fmt::pad_right("Version:", 28)) + " " + ui::cyan(inst.version))
    end
    return ""
end

pub fn cmd_why_not(args: [string]) -> string is
    if args.len() == 0 is return "Usage: hammer why-not <package>" end
    let name: string = args[0]
    let c: cache::PackageCache = cache::cache_load()
    let idb: db::InstalledDb = db::InstalledDb::open()
    let s: solver::Solver = solver::solver_new(c, idb)

    write("")
    write("  " + ui::accent_bold("⬡") + "  Why not installable: '" + ui::bold(name) + "'")
    write(rule(60))
    if idb.is_installed(name) is
        let io: db::InstalledPackage? = idb.get(name)
        let v: string = if io == nil then "" else io.version
        write("  " + ui::cyan("ℹ") + " '" + name + "' is already installed (" + ui::dim(v) + ")")
        return ""
    end
    write(explain::explain_failure(s, name))
    return ""
end

