fn history_json(entries: [db::HistoryEntry]) -> string is
    let mut items: [string] = []
    let mut i: int = 0
    while i < entries.len() is
        let e: db::HistoryEntry = entries[i]
        items.push(json_output::jobj([
            json_output::jfield("action", json_output::jstr(e.action)),
            json_output::jfield("generation", json_output::jint(e.generation)),
            json_output::jfield("id", json_output::jint(e.id)),
            json_output::jfield("new_ver", json_output::jstr_opt(e.new_ver)),
            json_output::jfield("old_ver", json_output::jstr_opt(e.old_ver)),
            json_output::jfield("package", json_output::jstr(e.package)),
            json_output::jfield("timestamp", json_output::jstr(e.timestamp))]))
        i += 1
    end
    return json_output::pretty(json_output::jarr(items))
end

fn print_history_entry(e: db::HistoryEntry) is
    let mut sym_col: string = ui::dim("·")
    if e.action == "install" is sym_col = ui::bright_green_bold("↓") end
    if e.action == "remove" is sym_col = ui::red_bold("✗") end
    if e.action == "upgrade" is sym_col = ui::bright_yellow_bold("↑") end
    let mut ver_info: string = ""
    if e.old_ver != nil && e.new_ver != nil is
        let o: string = e.old_ver
        let n: string = e.new_ver
        ver_info = ui::dim(o) + " → " + ui::bright_white(n)
    elsif e.new_ver != nil is
        let n2: string = e.new_ver
        ver_info = n2
    elsif e.old_ver != nil is
        let o2: string = e.old_ver
        ver_info = ui::dim(o2)
    end
    write("  " + sym_col + "  " + ui::bold(fmt::pad_right(e.package, 32)) + " " + fmt::pad_right(ver_info, 26) + " gen-" + ui::dim(to_string(e.generation)) + "  " + ui::dim(ui::format_ts(e.timestamp)))
end

fn arg_after(args: [string], flag: string, offset: int) -> string? is
    let mut i: int = 0
    while i < args.len() is
        if args[i] == flag is
            if i + offset < args.len() is return args[i + offset] end
            return nil
        end
        i += 1
    end
    return nil
end

fn parse_gen_arg(s: string) -> int is
    let n: string = if string_starts_with(s, "gen-") then str::slice(s, 4, string_len(s)) else s
    if str::is_numeric(n) is return conv::str_to_int(n) end
    return -1
end

fn gen_found(gdb: profile::GenerationsDb, n: int) -> profile::Generation? is
    return profile::db_get(gdb, n)
end

pub fn cmd_history(args: [string]) -> string is
    let mut limit: int = 50
    let mut w: int = 0
    while w + 1 < args.len() is
        if args[w] == "-n" is
            if str::is_numeric(args[w + 1]) is limit = conv::str_to_int(args[w + 1]) end
            w = args.len()
        else is
            w += 1
        end
    end
    let json_out: bool = cli_types::has_flag(args, "--json")

    ;; hammer history --diff <gen-A> <gen-B>
    if cli_types::has_flag(args, "--diff") is
        let a_s: string? = arg_after(args, "--diff", 1)
        let b_s: string? = arg_after(args, "--diff", 2)
        if a_s == nil || b_s == nil is return "Usage: hammer history --diff <gen-A> <gen-B>" end
        let a_str: string = a_s
        let b_str: string = b_s
        let gen_a: int = parse_gen_arg(a_str)
        if gen_a < 0 is return "Invalid generation: " + a_str end
        let gen_b: int = parse_gen_arg(b_str)
        if gen_b < 0 is return "Invalid generation: " + b_str end

        let lr: profile::LoadResult = profile::db_load()
        if lr.err != "" is return lr.err end
        let ao: profile::Generation? = profile::db_get(lr.db, gen_a)
        if ao == nil is return "Generation gen-" + to_string(gen_a) + " not found" end
        let bo: profile::Generation? = profile::db_get(lr.db, gen_b)
        if bo == nil is return "Generation gen-" + to_string(gen_b) + " not found" end
        let a: profile::Generation = ao
        let b: profile::Generation = bo

        let mut added: [string] = []
        let mut removed: [string] = []
        let mut changed: [string] = []
        let mut i: int = 0
        while i < b.packages.len() is
            let mut found: bool = false
            let mut k: int = 0
            while k < a.packages.len() is
                if a.packages[k].name == b.packages[i].name is found = true end
                k += 1
            end
            if !found && !contains_str(added, b.packages[i].name) is added.push(b.packages[i].name) end
            i += 1
        end
        let mut j: int = 0
        while j < a.packages.len() is
            let mut bp: int = -1
            let mut m: int = 0
            while m < b.packages.len() is
                if b.packages[m].name == a.packages[j].name is bp = m end
                m += 1
            end
            if bp < 0 is
                if !contains_str(removed, a.packages[j].name) is removed.push(a.packages[j].name) end
            elsif b.packages[bp].version != a.packages[j].version is
                changed.push(a.packages[j].name + ": " + a.packages[j].version + " → " + b.packages[bp].version)
            end
            j += 1
        end
        let added_s: [string] = sorting::sorted(added)
        let removed_s: [string] = sorting::sorted(removed)

        if json_out is
            write(json_output::jobj([
                json_output::jfield("added", json_output::jstr_arr(added_s)),
                json_output::jfield("changed", json_output::jstr_arr(changed)),
                json_output::jfield("gen_a", json_output::jint(gen_a)),
                json_output::jfield("gen_b", json_output::jint(gen_b)),
                json_output::jfield("removed", json_output::jstr_arr(removed_s))]))
            return ""
        end

        write("")
        write("  " + ui::accent_bold("⬡") + "  Diff: gen-" + to_string(gen_a) + " → gen-" + to_string(gen_b))
        write(rule(70))
        let mut x: int = 0
        while x < added_s.len() is
            write("  " + ui::bright_green("+") + " " + ui::bright_green(added_s[x]))
            x += 1
        end
        let mut y: int = 0
        while y < removed_s.len() is
            write("  " + ui::red("−") + " " + ui::red(removed_s[y]))
            y += 1
        end
        let mut z: int = 0
        while z < changed.len() is
            write("  " + ui::bright_yellow("↑") + " " + ui::bright_yellow(changed[z]))
            z += 1
        end
        if added_s.len() == 0 && removed_s.len() == 0 && changed.len() == 0 is
            write("  " + ui::dim("·") + " No differences between gen-" + to_string(gen_a) + " and gen-" + to_string(gen_b) + ".")
        end
        write("")
        return ""
    end

    ;; hammer history --search <package>
    if cli_types::has_flag(args, "--search") is
        let pn: string? = arg_after(args, "--search", 1)
        if pn == nil is return "Usage: hammer history --search <package>" end
        let pkg_name: string = pn
        let idb: db::InstalledDb = db::InstalledDb::open()
        let all: [db::HistoryEntry] = idb.history(10000)
        let mut matches: [db::HistoryEntry] = []
        let mut i2: int = 0
        while i2 < all.len() is
            if compat::str_index_of(all[i2].package, pkg_name) >= 0 is matches.push(all[i2]) end
            i2 += 1
        end
        if json_out is
            write(history_json(matches))
            return ""
        end
        write("")
        write("  " + ui::accent_bold("⬡") + "  History for '" + ui::bold(pkg_name) + "'")
        write(rule(70))
        if matches.len() == 0 is
            write("  " + ui::dim("·") + " No history found for '" + pkg_name + "'.")
        else is
            let mut k2: int = 0
            while k2 < matches.len() is
                print_history_entry(matches[k2])
                k2 += 1
            end
        end
        write("")
        return ""
    end

    ;; domyslnie: ostatnie N wpisow
    let idb2: db::InstalledDb = db::InstalledDb::open()
    let entries: [db::HistoryEntry] = idb2.history(limit)
    if json_out is
        write(history_json(entries))
        return ""
    end
    ui::print_history(entries)
    return ""
end

