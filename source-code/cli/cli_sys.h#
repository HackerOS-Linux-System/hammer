;; ── db ───────────────────────────────────────────────────────────────────

pub fn cmd_db(args: [string]) -> string is
    let sub: string = if args.len() > 0 then args[0] else "help"

    if sub == "validate-json" || sub == "validate" is
        let idb: db::InstalledDb = db::InstalledDb::open()
        write("")
        write("  " + ui::accent_bold("⬡") + "  DB Integrity check")
        write(rule(40))
        let r: db::JsonSyncResult = idb.validate_json_sync()
        if r.err != "" is
            write("  " + ui::red("✗") + " Could not validate: " + r.err)
        elsif r.only_sqlite.len() == 0 && r.only_json.len() == 0 is
            write("  " + ui::bright_green("✔") + " SQLite and JSON are in sync (" + ui::bold(to_string(idb.count())) + " packages).")
        else is
            if r.only_sqlite.len() > 0 is
                write("  " + ui::yellow("⚠") + " Only in SQLite (" + to_string(r.only_sqlite.len()) + "):")
                let mut i: int = 0
                while i < r.only_sqlite.len() is
                    write("       " + ui::yellow(r.only_sqlite[i]))
                    i += 1
                end
            end
            if r.only_json.len() > 0 is
                write("  " + ui::yellow("⚠") + " Only in JSON (" + to_string(r.only_json.len()) + "):")
                let mut j: int = 0
                while j < r.only_json.len() is
                    write("       " + ui::yellow(r.only_json[j]))
                    j += 1
                end
            end
            write("")
            write("  Run " + ui::cyan("hammer db export-json") + " to fix.")
        end
        write("")
        return ""
    end

    if sub == "export-json" || sub == "export" is
        let idb2: db::InstalledDb = db::InstalledDb::open()
        let e: string = idb2.export_json()
        if e != "" is return e end
        write("  " + ui::bright_green("✔") + " Exported " + ui::bold(to_string(idb2.count())) + " packages to " + ui::cyan(db::json_path()) + ".")
        return ""
    end

    if sub == "import-json" || sub == "import" is
        let path: string = if args.len() > 1 then args[1] else db::json_path()
        let idb3: db::InstalledDb = db::InstalledDb::open()
        let r2: db::ImportJsonResult = idb3.import_json(path)
        if r2.err != "" is return r2.err end
        write("  " + ui::bright_green("✔") + " Imported " + ui::bold(to_string(r2.count)) + " packages from " + ui::cyan(path) + ".")
        return ""
    end

    if sub == "recover" is
        let rec: db::OpenRecovery = db::recover_from_json()
        if rec.err != "" is return rec.err end
        if rec.recovered == 0 is
            write("  " + ui::bright_green("✔") + " SQLite is healthy — no recovery needed.")
        else is
            write("  " + ui::bright_green("✔") + " Recovered " + ui::bold(to_string(rec.recovered)) + " packages from JSON snapshot.")
        end
        return ""
    end

    write("")
    write("  " + ui::accent_bold("⬡") + "  hammer db — database utilities")
    write("")
    write("  " + ui::cyan("validate-json") + "  Validate SQLite↔JSON sync")
    write("  " + ui::cyan("export-json") + "    Export SQLite → JSON snapshot")
    write("  " + ui::cyan("import-json [path]") + "    Import JSON snapshot → SQLite")
    write("  " + ui::cyan("recover") + "         Recover SQLite from JSON backup")
    write("")
    return ""
end
