pub fn cmd_log(args: [string]) -> string is
    let mut lines: int = 50
    let mut i: int = 0
    while i < args.len() is
        if string_starts_with(args[i], "-n") is
            let rest: string = str::trim(str::slice(args[i], 2, string_len(args[i])))
            if str::is_numeric(rest) is lines = conv::str_to_int(rest) end
            i = args.len()
        else is
            i += 1
        end
    end

    let log_path: string = log::log_file()
    if !fs::exists(log_path) is
        write("  " + ui::dim("·") + " No log file at " + log_path)
        return ""
    end
    write("  " + ui::accent_bold("⬡") + "  hammer log  (last " + to_string(lines) + " lines from " + log_path + ")")
    write(rule(70))

    let all_lines: [string] = str::split(fs::read(log_path), "\n")
    ;; `str.lines()` nie zwraca ostatniej pustej linii po koncowym `\n`
    let mut total: int = all_lines.len()
    if total > 0 && all_lines[total - 1] == "" is total -= 1 end
    let start: int = if total > lines then total - lines else 0
    let mut k: int = start
    while k < total is
        let line: string = all_lines[k]
        if compat::str_index_of(line, "ERROR") >= 0 is
            write("  " + ui::red(line))
        elsif compat::str_index_of(line, "WARN") >= 0 is
            write("  " + ui::yellow(line))
        elsif string_starts_with(line, "──") is
            write("  " + ui::dim(line))
        else is
            write("  " + line)
        end
        k += 1
    end
    return ""
end

