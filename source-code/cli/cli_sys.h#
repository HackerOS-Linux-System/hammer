pub fn cmd_pending(args: [string]) -> string is
    let sub: string = if args.len() > 0 then args[0] else "show"

    if sub == "show" || sub == "status" is
        let lr: profile::LoadResult = profile::db_load()
        if lr.err != "" is return lr.err end
        let pn: int? = profile::read_pending_gen()
        if pn == nil is
            write("  " + ui::dim("·") + " No pending changes.")
            return ""
        end
        let n: int = pn
        write("")
        write("  " + ui::bright_yellow_bold("⬡") + " Pending: gen-" + ui::bright_yellow(ui::bold(to_string(n))))
        let go: profile::Generation? = profile::db_get(lr.db, n)
        if go != nil is
            let gen: profile::Generation = go
            if gen.note != nil is
                let note: string = gen.note
                write("  Operation : " + ui::cyan(note))
            end
            write("  Packages  : " + to_string(profile::gen_package_count(gen)))
        end
        write("")
        write("  Will activate on next reboot.")
        write("  Cancel:     " + ui::cyan("hammer pending cancel"))
        write("  Apply now:  " + ui::cyan("hammer pending apply-live"))
        return ""
    end

    if sub == "cancel" is
        let pn2: int? = profile::read_pending_gen()
        if pn2 == nil is
            write("  " + ui::dim("·") + " No pending changes.")
            return ""
        end
        let n2: int = pn2
        let lk: lock::LockResult = take_lock()
        if lk.err != "" is return lk.err end
        let e: string = cancel_pending(n2)
        lock::lock_release(lk.lock)
        if e != "" is return e end
        write("  " + ui::bright_green("✔") + " Pending gen-" + to_string(n2) + " cancelled.")
        return ""
    end

    if sub == "apply-live" is return cmd_apply_live() end
    return "Unknown pending subcommand: '" + sub + "'. Try: show, cancel, apply-live"
end

fn cancel_pending(n: int) -> string is
    let ce: string = profile::clear_pending()
    if ce != "" is return ce end
    let lr: profile::LoadResult = profile::db_load()
    if lr.err != "" is return lr.err end
    let mut gdb: profile::GenerationsDb = lr.db
    gdb.pending = nil
    let mut gens: [profile::Generation] = []
    let mut i: int = 0
    while i < gdb.generations.len() is
        let mut g: profile::Generation = gdb.generations[i]
        if g.number == n is g.state = "Old" end
        gens.push(g)
        i += 1
    end
    gdb.generations = gens
    let se: string = profile::db_save(gdb)
    if se != "" is return se end
    grub::update_grub(gdb)
    return ""
end

fn cmd_apply_live() -> string is
    let pn: int? = profile::read_pending_gen()
    if pn == nil is
        write("  " + ui::dim("·") + " No pending changes.")
        return ""
    end
    let pending_num: int = pn
    let lr: profile::LoadResult = profile::db_load()
    if lr.err != "" is return lr.err end
    let gdb: profile::GenerationsDb = lr.db
    let go: profile::Generation? = profile::db_get(gdb, pending_num)
    if go == nil is return "Pending gen not in DB" end
    let gen: profile::Generation = go

    ;; pakiety obecne w pending, ale nie w biezacej generacji
    let mut current_pkgs: [string] = []
    let cg: profile::Generation? = profile::db_get(gdb, gdb.current)
    if cg != nil is
        let c: profile::Generation = cg
        let mut ci: int = 0
        while ci < c.packages.len() is
            current_pkgs.push(c.packages[ci].name)
            ci += 1
        end
    end
    let mut new_entries: [store::StoreEntry] = []
    let mut i: int = 0
    while i < gen.packages.len() is
        let p: profile::GenPackage = gen.packages[i]
        if !contains_str(current_pkgs, p.name) is
            let path: string = compat::path_join(store::store_dir(), p.name + "-" + p.version + "-" + p.store_hash)
            if fs::exists(path) is
                new_entries.push(store::StoreEntry { name: p.name, version: p.version, hash: p.store_hash,
                    path: path, backend: store::StoreBackend::Hardlink })
            end
        end
        i += 1
    end

    let analysis: livepatch::PatchAnalysis = livepatch::analyse(livepatch::collect_files(new_entries))
    if !analysis.can_live_patch is
        write("  " + ui::red_bold("✗") + " Cannot apply live — reboot required.")
        write("  Reason(s): " + ui::yellow(str::join(analysis.reboot_reasons, ", ")))
        return ""
    end
    let result: livepatch::LivePatchResult = livepatch::apply_live(new_entries, store::active_link())
    let lk: lock::LockResult = take_lock()
    if lk.err != "" is return lk.err end
    let e: string = finish_apply_live(gen, pending_num)
    lock::lock_release(lk.lock)
    if e != "" is return e end
    write("  " + ui::bright_green_bold("✔") + " Live patch applied (" + ui::bold(to_string(result.updated_files)) + " files, binaries relinked).")
    return ""
end

fn finish_apply_live(gen: profile::Generation, pending_num: int) -> string is
    let se: string = profile::switch_active(gen)
    if se != "" is return se end
    let rr: profile::RelinkResult = profile::relink_bins(profile::gen_profile_path(gen))
    if rr.err != "" is return rr.err end
    let lr2: profile::LoadResult = profile::db_load()
    if lr2.err != "" is return lr2.err end
    let mut gdb2: profile::GenerationsDb = lr2.db
    gdb2.current = pending_num
    gdb2.pending = nil
    let sv: string = profile::db_save(gdb2)
    if sv != "" is return sv end
    return profile::clear_pending()
end

;; ── verify ───────────────────────────────────────────────────────────────

pub fn cmd_verify(args: [string]) -> string is
    let has_filter: bool = args.len() > 0
    ui::print_header()
    write("  " + ui::accent_bold("⬡") + "  Verifying package integrity…")
    write(rule(60))
    let idb: db::InstalledDb = db::InstalledDb::open()
    let mut ok: int = 0
    let mut failed: int = 0
    let mut missing: int = 0
    let packages: [db::InstalledPackage] = idb.list_all()
    let mut checked: int = 0
    let mut i: int = 0
    while i < packages.len() is
        let pkg: db::InstalledPackage = packages[i]
        if !has_filter || pkg.name == args[0] is
            checked += 1
            let store_path: string = compat::path_join(store::store_dir(), pkg.name + "-" + pkg.version + "-" + pkg.store_hash)
            if !fs::exists(store_path) is
                write("  " + ui::red_bold("✗") + " " + ui::bold(pkg.name) + " " + ui::dim(pkg.version) + " — store entry missing")
                missing += 1
            else is
                ;; zawieszone dowiazania (patrz odejscie 4)
                let script: string = "for f in \"$@\"; do t=$(readlink -- \"$f\") || continue; if [ -e \"$t\" ] || [ -L \"$t\" ]; then :; else echo bad; fi; done"
                let bad: string = proc::shell("find " + shq(store_path) + " -mindepth 1 -type l -exec sh -c " + shq(script) + " sh {{}} + 2>/dev/null")
                if compat::str_index_of(bad, "bad") < 0 is
                    ok += 1
                    if has_filter is
                        write("  " + ui::bright_green("✔") + " " + ui::bold(pkg.name) + " " + ui::dim(pkg.version) + " — OK")
                    end
                else is
                    write("  " + ui::red_bold("✗") + " " + ui::bold(pkg.name) + " " + ui::dim(pkg.version) + " — dangling symlinks")
                    failed += 1
                end
            end
        end
        i += 1
    end
    write("")
    write(rule(60))
    write("  " + ui::bold(fmt::pad_right("Checked:", 20)) + " " + to_string(checked))
    write("  " + ui::bold(fmt::pad_right("OK:", 20)) + " " + ui::bright_green(to_string(ok)))
    if missing > 0 is write("  " + ui::bold(fmt::pad_right("Missing:", 20)) + " " + ui::red(to_string(missing))) end
    if failed > 0 is
        write("  " + ui::bold(fmt::pad_right("Failed:", 20)) + " " + ui::red(to_string(failed)))
        write("  Run " + ui::cyan("hammer fix-broken") + " to fix.")
    else is
        write("")
        write("  " + ui::bright_green("✔") + " Store integrity OK.")
    end
    return ""
end

