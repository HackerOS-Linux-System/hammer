pub fn cmd_diff(args: [string]) -> string is
    let lr: profile::LoadResult = profile::db_load()
    if lr.err != "" is return lr.err end
    let gdb: profile::GenerationsDb = lr.db
    let mut a: int = 0
    let mut b: int = 0
    if args.len() == 0 is
        if gdb.pending == nil is return "No pending generation. Use: hammer diff <A> <B>" end
        let p: int = gdb.pending
        a = gdb.current
        b = p
    elsif args.len() == 1 is
        if !str::is_numeric(args[0]) is return "invalid digit found in string" end
        a = conv::str_to_int(args[0])
        b = gdb.current
    else is
        if !str::is_numeric(args[0]) || !str::is_numeric(args[1]) is return "invalid digit found in string" end
        a = conv::str_to_int(args[0])
        b = conv::str_to_int(args[1])
    end
    ui::print_diff(diff::compute_diff(a, b, gdb))
    return ""
end

fn remove_generation_dirs(gens: [profile::Generation]) is
    let mut i: int = 0
    while i < gens.len() is
        proc::shell("rm -rf -- " + shq(profile::gen_profile_path(gens[i])))
        i += 1
    end
end

pub fn cmd_gen(args: [string]) -> string is
    let sub: string = if args.len() > 0 then args[0] else "list"

    if sub == "list" || sub == "ls" is
        let lr: profile::LoadResult = profile::db_load()
        if lr.err != "" is return lr.err end
        ui::print_generations(lr.db)
        return ""
    end

    if sub == "switch" is
        if args.len() < 2 is return "Usage: hammer gen switch <N>" end
        if !str::is_numeric(args[1]) is return "invalid digit found in string" end
        let n: int = conv::str_to_int(args[1])
        let lr: profile::LoadResult = profile::db_load()
        if lr.err != "" is return lr.err end
        let go: profile::Generation? = profile::db_get(lr.db, n)
        if go == nil is return "Generation " + to_string(n) + " not found." end
        let gen: profile::Generation = go

        let lk: lock::LockResult = take_lock()
        if lk.err != "" is return lk.err end
        let e: string = switch_to_generation(gen, n)
        lock::lock_release(lk.lock)
        if e != "" is return e end
        write("  " + ui::bright_green("✔") + " Now running gen-" + to_string(n) + ".")
        return ""
    end

    if sub == "gc" is
        ;; --keep=N albo kolejny argument; domyslnie 20
        let mut keep: int = 20
        let kv: string? = cli_types::flag_value(args, "--keep=")
        if kv != nil is
            let kvs: string = kv
            if str::is_numeric(kvs) is keep = conv::str_to_int(kvs) end
        elsif args.len() > 1 && str::is_numeric(args[1]) is
            keep = conv::str_to_int(args[1])
        end
        return gen_gc(keep)
    end

    if sub == "delete" is
        if args.len() < 2 is return "Usage: hammer gen delete <N>" end
        if !str::is_numeric(args[1]) is return "invalid digit found in string" end
        let n2: int = conv::str_to_int(args[1])
        let lr2: profile::LoadResult = profile::db_load()
        if lr2.err != "" is return lr2.err end
        let mut gdb: profile::GenerationsDb = lr2.db
        if n2 == gdb.current is
            return "Cannot delete the currently active generation (" + to_string(n2) + ")."
        end
        let go2: profile::Generation? = profile::db_get(gdb, n2)
        if go2 == nil is return "Generation " + to_string(n2) + " not found." end
        let g2: profile::Generation = go2
        proc::shell("rm -rf -- " + shq(profile::gen_profile_path(g2)))
        let mut kept: [profile::Generation] = []
        let mut i: int = 0
        while i < gdb.generations.len() is
            if gdb.generations[i].number != n2 is kept.push(gdb.generations[i]) end
            i += 1
        end
        gdb.generations = kept
        let se: string = profile::db_save(gdb)
        if se != "" is return se end
        write("  " + ui::bright_green("✔") + " Deleted gen-" + to_string(n2) + ".")
        return ""
    end

    return "Unknown gen subcommand: '" + sub + "'. Try: list, switch, gc [--keep=N], delete <N>"
end

;; switch_active + relink + aktualizacja bazy + grub (pod blokada).
fn switch_to_generation(gen: profile::Generation, n: int) -> string is
    let se: string = profile::switch_active(gen)
    if se != "" is return se end
    let rr: profile::RelinkResult = profile::relink_bins(profile::gen_profile_path(gen))
    if rr.err != "" is return rr.err end
    let lr2: profile::LoadResult = profile::db_load()
    if lr2.err != "" is return lr2.err end
    let mut gdb2: profile::GenerationsDb = lr2.db
    gdb2.current = n
    gdb2.pending = nil
    profile::clear_pending()
    let sv: string = profile::db_save(gdb2)
    if sv != "" is return sv end
    grub::update_grub(gdb2)
    return ""
end

fn gen_gc(keep: int) -> string is
    let lr: profile::LoadResult = profile::db_load()
    if lr.err != "" is return lr.err end
    let mut gdb: profile::GenerationsDb = lr.db
    let before: int = gdb.generations.len()

    ;; `keep` najnowszych (malejaco po numerze) + biezaca
    let mut keep_nums: [int] = []
    let mut used: [bool] = []
    let mut u: int = 0
    while u < gdb.generations.len() is
        used.push(false)
        u += 1
    end
    let mut taken: int = 0
    while taken < keep && taken < gdb.generations.len() is
        let mut best: int = -1
        let mut g: int = 0
        while g < gdb.generations.len() is
            if !used[g] && (best < 0 || gdb.generations[g].number > gdb.generations[best].number) is best = g end
            g += 1
        end
        used[best] = true
        keep_nums.push(gdb.generations[best].number)
        taken += 1
    end
    keep_nums.push(gdb.current)

    let mut kept: [profile::Generation] = []
    let mut to_remove: [profile::Generation] = []
    let mut i: int = 0
    while i < gdb.generations.len() is
        let mut keep_it: bool = false
        let mut k: int = 0
        while k < keep_nums.len() is
            if keep_nums[k] == gdb.generations[i].number is keep_it = true end
            k += 1
        end
        if keep_it is kept.push(gdb.generations[i]) else is to_remove.push(gdb.generations[i]) end
        i += 1
    end
    remove_generation_dirs(to_remove)
    gdb.generations = kept
    let se: string = profile::db_save(gdb)
    if se != "" is return se end
    let removed: int = if before > gdb.generations.len() then before - gdb.generations.len() else 0
    write("  " + ui::bright_green("✔") + " GC complete: removed " + to_string(removed) + " generation(s), kept " + to_string(gdb.generations.len()) + ".")
    return ""
end

