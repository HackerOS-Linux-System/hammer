pub struct Doctor is
    pub issues: int
end

fn check_item(d: Doctor, label: string, ok: bool, fix: string) -> Doctor is
    if ok is
        write("  " + ui::bright_green("✔") + "  " + label)
        return d
    end
    write("  " + ui::red_bold("✗") + "  " + label + " — " + ui::yellow(fix))
    return Doctor { issues: d.issues + 1 }
end

fn warn_item(label: string, ok: bool, fix: string) is
    if ok is
        write("  " + ui::bright_green("✔") + "  " + label)
    else is
        write("  " + ui::yellow_bold("!") + "  " + label + " — " + ui::yellow(fix))
    end
end

fn dir_nonempty(p: string) -> bool is
    if !fs::is_dir(p) is return false end
    return str::trim(proc::shell("ls -A " + shq(p) + " 2>/dev/null | head -n1")) != ""
end

pub fn cmd_doctor() -> string is
    ui::print_header()
    write("  " + ui::accent_bold("⬡") + "  hammer doctor — system health check")
    write(rule(65))
    write("")
    let mut d: Doctor = Doctor { issues: 0 }

    d = check_item(d, "/hammer directory exists", fs::exists("/hammer"), "run `hammer init`")
    let tgt: string = str::trim(proc::shell("readlink /hammer/active 2>/dev/null"))
    d = check_item(d, "/hammer/active symlink valid", tgt != "" && fs::exists(tgt), "run `hammer _activate` or `hammer relink`")
    let bins: int = count_active_bins()
    if bins > 1 is
        write("  " + ui::bright_green("✔") + "  " + ui::cyan(to_string(bins)) + " binaries linked to PATH")
    else is
        write("  " + ui::red_bold("✗") + "  Only " + to_string(bins) + " binary in PATH — run " + ui::cyan("hammer relink"))
        d = Doctor { issues: d.issues + 1 }
    end
    d = check_item(d, "sources-list.hk exists", fs::exists(repo::sources_hk()), "run `hammer init`")
    d = check_item(d, "Package index populated", dir_nonempty(cache::lists_dir()), "run `hammer sync`")
    d = check_item(d, "hammer-activate.service installed", fs::exists("/etc/systemd/system/hammer-activate.service"), "run `hammer init`")
    d = check_item(d, "/usr/bin in PATH", compat::str_index_of(env::get("PATH"), "/usr/bin") >= 0, "add to /etc/environment")
    d = check_item(d, "hammer database accessible", fs::exists(build_mode::db_dir()), "run `hammer init`")
    if profile::read_pending_gen() != nil is
        write("  " + ui::cyan_bold("ℹ") + "  Pending changes staged — reboot to activate")
    else is
        write("  " + ui::bright_green("✔") + "  No pending changes")
    end
    d = check_item(d, "GRUB generator installed", fs::exists(grub::grub_generator()), "run `hammer init`")
    d = check_item(d, "Running on installed system", livecheck::live_reason() == nil, "hammer cannot run in a live system")
    warn_item("Immutable filesystem enabled", immutable::is_immutable_enabled(), "run `hammer immutable enable`")
    warn_item("Trusted GPG keys configured", dir_nonempty(gpg_verify::keyring_dir()), "add keys: `hammer key add <url>`")
    warn_item("gpgv available", sh_ok("command -v gpgv"), "hammer install gnupg")
    ;; sekcja "HackerOS tools: N/M installed" pominieta (patrz odejscie 3)

    write("")
    write(rule(65))
    if d.issues == 0 is
        write("  " + ui::bright_green_bold("✔") + "  All checks passed.")
    else is
        write("  " + ui::yellow_bold("!") + "  " + to_string(d.issues) + " issue" + count_str(d.issues, "", "s") + " found.")
        if bins <= 1 is
            write("")
            write("  Quick fix: " + ui::bold(ui::cyan("hammer relink")))
        end
    end
    write("")
    return ""
end

