;; "" = Ok.
fn link_store_into_profile(store_path: string, profile_dir: string) -> string is
    if !sys_ok("cp -rsnT -- " + shq(store_path) + " " + shq(profile_dir) + " 2>/dev/null") is
        ;; `cp` zwraca != 0 tez gdy czesc plikow juz istnieje (-n); Rust ignorowal
        ;; bledy symlink (`.ok()`), wiec sprawdzamy tylko, ze profil istnieje
        if !fs::is_dir(profile_dir) is return "Linking " + store_path + " into " + profile_dir + " failed" end
    end
    return ""
end

pub fn compose_profile(gen_num: int, store_entries: [store::StoreEntry], note: string?) -> ComposeResult is
    let none_pk: [GenPackage] = []
    let empty_gen: Generation = Generation { number: gen_num, timestamp: "", packages: none_pk, note: note, state: nil }
    let profile_dir: string = compat::path_join(store::profiles_dir(), "gen-" + to_string(gen_num))
    fs::mkdir(profile_dir)
    if !fs::is_dir(profile_dir) is
        return ComposeResult { generation: empty_gen, err: "Cannot create " + profile_dir }
    end
    let subs: [string] = ["usr/bin", "usr/local/bin", "usr/sbin", "usr/lib", "usr/share", "etc", "var", "lib"]
    let mut s: int = 0
    while s < subs.len() is
        fs::mkdir(compat::path_join(profile_dir, subs[s]))
        s += 1
    end

    let mut pkgs: [GenPackage] = []
    let mut i: int = 0
    while i < store_entries.len() is
        let e: store::StoreEntry = store_entries[i]
        i += 1
        if fs::exists(e.path) is
            let err: string = link_store_into_profile(e.path, profile_dir)
            if err != "" is return ComposeResult { generation: empty_gen, err: err } end
        end
        pkgs.push(GenPackage { name: e.name, version: e.version, store_hash: e.hash })
    end
    return ComposeResult {
        generation: Generation { number: gen_num, timestamp: now_rfc3339(), packages: pkgs, note: note, state: "Pending" },
        err: ""
    }
end

;; ── relink_bins ──────────────────────────────────────────────────────────

pub struct RelinkResult is
    pub linked:  int
    pub removed: int
    pub err:     string
end

;; Decyzja dla jednego pliku (patrz odejscie 6). Wypisuje slowa:
;;   skip | same | removed | linked | failed  (`removed` moze poprzedzac `linked`/`failed`)
fn relink_one_cmd(src: string, link: string) -> string is
    return "src=" + shq(src) + "; link=" + shq(link) + "; " +
        "if [ -d \"$src\" ]; then echo skip; exit 0; fi; " +
        "if [ ! -x \"$src\" ] && [ ! -L \"$src\" ]; then echo skip; exit 0; fi; " +
        "if [ -e \"$link\" ] || [ -L \"$link\" ]; then " +
        "  if [ \"$(readlink \"$link\" 2>/dev/null)\" = \"$src\" ]; then echo same; exit 0; fi; " +
        "  rm -f -- \"$link\"; echo removed; " +
        "fi; " +
        "if ln -s -- \"$src\" \"$link\" 2>/dev/null; then echo linked; else echo failed; fi"
end

fn seen_has(seen: [string], n: string) -> bool is
    let mut i: int = 0
    while i < seen.len() is
        if seen[i] == n is return true end
        i += 1
    end
    return false
end

pub fn relink_bins(profile_path: string) -> RelinkResult is
    let link_dir: string = link_target_dir()
    fs::mkdir(link_dir)
    if !fs::is_dir(link_dir) is
        return RelinkResult { linked: 0, removed: 0, err: "Cannot create " + link_dir }
    end
    let mut linked: int = 0
    let mut removed: int = 0
    let mut seen: [string] = []

    let dirs: [string] = bin_source_dirs()
    let mut d: int = 0
    while d < dirs.len() is
        let src_dir: string = compat::path_join(profile_path, dirs[d])
        d += 1
        if fs::exists(src_dir) is
            let names: [string] = fs::list_dir(src_dir)
            let mut i: int = 0
            while i < names.len() is
                let file_name: string = names[i]
                i += 1
                if file_name != "" && !seen_has(seen, file_name) is
                    let src_path: string = compat::path_join(src_dir, file_name)
                    let link_path: string = compat::path_join(link_dir, file_name)
                    let out: string = proc::shell(relink_one_cmd(src_path, link_path))
                    let words: [string] = str::split(str::trim(out), "\n")
                    let mut w: int = 0
                    while w < words.len() is
                        let word: string = str::trim(words[w])
                        w += 1
                        if word == "removed" is
                            removed += 1
                        elsif word == "same" is
                            seen.push(file_name)
                        elsif word == "linked" is
                            linked += 1
                            seen.push(file_name)
                            log::info("relink: " + link_path + " → " + src_path)
                        end
                    end
                end
            end
        end
    end

    ;; vim wrapper
    let vim_link: string = compat::path_join(link_dir, "vim")
    let vim_basic: string = compat::path_join(profile_path, "usr/bin/vim.basic")
    let vim_exists: bool = sys_ok("test -e " + shq(vim_link) + " -o -L " + shq(vim_link))
    if !vim_exists && fs::exists(vim_basic) is
        if sys_ok("ln -s -- " + shq(vim_basic) + " " + shq(vim_link) + " 2>/dev/null") is linked += 1 end
    end
    return RelinkResult { linked: linked, removed: removed, err: "" }
end

;; ── pending / active ─────────────────────────────────────────────────────

fn symlink_exists(p: string) -> bool is
    return sys_ok("test -L " + shq(p) + " -o -e " + shq(p))
end

pub fn read_pending_gen() -> int? is
    let r: LoadResult = db_load()
    if r.err != "" is return nil end
    return r.db.pending
end

pub fn read_active_gen() -> int? is
    let active: string = store::active_link()
    if !symlink_exists(active) is return nil end
    let target: string = str::trim(proc::shell("readlink " + shq(active) + " 2>/dev/null"))
    if target == "" is return nil end
    let name: string = compat::path_filename(target)
    if !name.starts_with("gen-") is return nil end
    let rest: string = str::slice(name, 4, string_len(name))
    if rest != "" && str::is_numeric(rest) is return conv::str_to_int(rest) end
    return nil
end

;; "" = Ok.
pub fn switch_active(g: Generation) -> string is
    let target: string = gen_profile_path(g)
    let active: string = store::active_link()
    let tmp: string = active + ".tmp"
    if !fs::exists(target) is return "Profile does not exist: " + target end
    if symlink_exists(tmp) is system("rm -f -- " + shq(tmp)) end
    if !sys_ok("ln -s -- " + shq(target) + " " + shq(tmp) + " 2>/dev/null") is
        return "Creating tmp active symlink"
    end
    if !sys_ok("mv -T -- " + shq(tmp) + " " + shq(active) + " 2>/dev/null") is
        return "Atomic rename of active symlink"
    end
    log::info("profile: switched active to gen-" + to_string(g.number))
    return ""
end

pub fn set_pending(g: Generation) -> string is
    let pending: string = pending_link()
    if symlink_exists(pending) is system("rm -f -- " + shq(pending)) end
    system("ln -s -- " + shq(gen_profile_path(g)) + " " + shq(pending) + " 2>/dev/null")
    let r: LoadResult = db_load()
    if r.err != "" is return r.err end
    let mut d: GenerationsDb = r.db
    d.pending = g.number
    return db_save(d)
end

pub fn clear_pending() -> string is
    let pending: string = pending_link()
    if symlink_exists(pending) is system("rm -f -- " + shq(pending)) end
    return ""
end

;; ── run_postinst ─────────────────────────────────────────────────────────

fn join_or_empty(items: [string]) -> string is
    return str::join(items, ", ")
end

;; Wolane tez z transaction.rs. "" = Ok, inaczej blad (lista nieudanych akcji).
pub fn run_postinst(pkg_name: string, script_path: string) -> string is
    if !fs::exists(script_path) is return "Reading " + script_path end
    let script: string = fs::read(script_path)
    let actions: [postinst::Action] = postinst::translate(script)
    let outcome: postinst::RunOutcome = postinst::run(actions)
    let summary: postinst::PostinstResult = outcome.summary

    if summary.services_enabled.len() > 0 is
        log::info("postinst [" + pkg_name + "]: enabled services: " + join_or_empty(summary.services_enabled))
    end
    if summary.services_started.len() > 0 is
        log::info("postinst [" + pkg_name + "]: started services: " + join_or_empty(summary.services_started))
    end
    if summary.conffiles_created.len() > 0 is
        log::info("postinst [" + pkg_name + "]: created conffiles: " + join_or_empty(summary.conffiles_created))
    end
    let mut w: int = 0
    while w < summary.warnings.len() is
        log::warn("postinst [" + pkg_name + "]: " + summary.warnings[w])
        w += 1
    end

    let mut msgs: [string] = []
    let mut i: int = 0
    while i < outcome.results.len() is
        let r: postinst::ActionResult = outcome.results[i]
        if !r.success && r.action != "skip" is
            msgs.push("  " + r.action + " failed: " + r.message)
        end
        i += 1
    end
    if msgs.len() > 0 is
        return "postinst actions failed:\n" + str::join(msgs, "\n")
    end
    return ""
end

;; ── activate_pending ─────────────────────────────────────────────────────

fn no_activation(err: string) -> ActivateOutcome is
    let none: [string] = []
    return ActivateOutcome { ok: false, err: err,
        result: ActivationResult { gen_number: 0, packages_linked: 0, scripts_failed: none, already_active: false } }
end

fn name_in_gen(g: Generation, name: string) -> bool is
    let mut i: int = 0
    while i < g.packages.len() is
        if g.packages[i].name == name is return true end
        i += 1
    end
    return false
end

pub fn activate_pending() -> ActivateOutcome is
    let pending: int? = read_pending_gen()
    let none: [string] = []

    if pending == nil is
        let lr: LoadResult = db_load()
        if lr.err != "" is return no_activation(lr.err) end
        let cur: Generation? = db_current_gen(lr.db)
        if cur == nil is return no_activation("No current generation") end
        let cg: Generation = cur
        let rl: RelinkResult = relink_bins(gen_profile_path(cg))
        if rl.err != "" is return no_activation(rl.err) end
        return ActivateOutcome { ok: true, err: "",
            result: ActivationResult { gen_number: lr.db.current, packages_linked: rl.linked,
                scripts_failed: none, already_active: true } }
    end

    let pending_num: int = pending
    let lr: LoadResult = db_load()
    if lr.err != "" is return no_activation(lr.err) end
    let mut d: GenerationsDb = lr.db
    let found: Generation? = db_get(d, pending_num)
    if found == nil is return no_activation("Pending gen " + to_string(pending_num) + " not in DB") end
    let g: Generation = found

    let profile_path: string = gen_profile_path(g)
    if !fs::exists(profile_path) is return no_activation("Profile path missing: " + profile_path) end

    let sw: string = switch_active(g)
    if sw != "" is return no_activation(sw) end
    let rl: RelinkResult = relink_bins(profile_path)
    if rl.err != "" is return no_activation(rl.err) end
    let linked: int = rl.linked

    ;; pakiety obecne w poprzedniej (current) generacji nie dostaja postinst ponownie
    let prev: Generation? = db_current_gen(d)
    let mut scripts_failed: [string] = []
    let mut i: int = 0
    while i < g.packages.len() is
        let pk: GenPackage = g.packages[i]
        i += 1
        let mut in_prev: bool = false
        if prev != nil is
            let pg: Generation = prev
            in_prev = name_in_gen(pg, pk.name)
        end
        if !in_prev is
            let script_path: string = "/hammer/db/postinst/" + pk.name + ".postinst"
            if fs::exists(script_path) is
                let perr: string = run_postinst(pk.name, script_path)
                if perr != "" is
                    log::warn("postinst " + pk.name + " failed: " + perr)
                    scripts_failed.push(pk.name)
                end
            end
        end
    end

    d.current = pending_num
    d.pending = nil
    let mut k: int = 0
    while k < d.generations.len() is
        if d.generations[k].number == pending_num is d.generations[k].state = "Active" end
        k += 1
    end
    let serr: string = db_save(d)
    if serr != "" is return no_activation(serr) end
    clear_pending()

    ;; dziennik aktywacji
    let log_file: string = activation_log()
    let ldir: string = compat::path_parent(log_file)
    if ldir != "" && !fs::exists(ldir) is fs::mkdir(ldir) end
    let msg: string = "[" + now_rfc3339() + "] activated gen-" + to_string(pending_num) + ", " +
        to_string(linked) + " binaries linked\n"
    fs::append(log_file, msg)

    log::info("activate: gen-" + to_string(pending_num) + " activated, " + to_string(linked) + " binaries linked")
    return ActivateOutcome { ok: true, err: "",
        result: ActivationResult { gen_number: pending_num, packages_linked: linked,
            scripts_failed: scripts_failed, already_active: false } }
end

;; ── usluga systemd / sprzatanie ──────────────────────────────────────────

pub fn install_activate_service() -> string is
    let mut hammer_bin: string = str::trim(proc::shell("readlink /proc/self/exe 2>/dev/null"))
    if hammer_bin == "" is hammer_bin = "/usr/bin/hammer" end
    let symlink_path: string = "/usr/bin/hammer"
    if !symlink_exists(symlink_path) is
        system("ln -s -- " + shq(hammer_bin) + " " + shq(symlink_path) + " 2>/dev/null")
    end
    let unit: string = "[Unit]\n" +
        "Description=Hammer Package Manager — Generation Activation\n" +
        "DefaultDependencies=no\n" +
        "Before=basic.target\n" +
        "After=local-fs.target\n" +
        "ConditionPathExists=/hammer/pending\n" +
        "\n" +
        "[Service]\n" +
        "Type=oneshot\n" +
        "RemainAfterExit=yes\n" +
        "ExecStart=" + hammer_bin + " _activate\n" +
        "StandardOutput=journal\n" +
        "StandardError=journal\n" +
        "\n" +
        "[Install]\n" +
        "WantedBy=sysinit.target\n"
    if !fs::exists("/etc/systemd/system") is
        return "Cannot write /etc/systemd/system/hammer-activate.service: directory missing"
    end
    fs::write("/etc/systemd/system/hammer-activate.service", unit)
    system("systemctl enable hammer-activate.service --no-reload >/dev/null 2>&1")
    log::info("profile: installed hammer-activate.service (" + hammer_bin + ")")
    return ""
end

pub fn delete_profile(g: Generation) -> string is
    let pp: string = gen_profile_path(g)
    if fs::exists(pp) is
        if !sys_ok("rm -rf -- " + shq(pp)) is return "Removing profile " + pp end
        log::info("profile: deleted gen-" + to_string(g.number))
    end
    return ""
end

;; ── tryb uzytkownika ─────────────────────────────────────────────────────

;; Zwraca sciezke profilu; blad: pusty napis (Rust: `Result<PathBuf>`).
pub fn compose_user_profile(hammer_dir: string, gen_num: int, store_entries: [store::StoreEntry]) -> string is
    let profile_dir: string = compat::path_join(compat::path_join(hammer_dir, "profiles"), "gen-" + to_string(gen_num))
    fs::mkdir(compat::path_join(profile_dir, "bin"))
    if !fs::is_dir(profile_dir) is return "" end
    let mut i: int = 0
    while i < store_entries.len() is
        let e: store::StoreEntry = store_entries[i]
        i += 1
        if fs::exists(e.path) is
            let err: string = link_store_into_profile(e.path, profile_dir)
            if err != "" is return "" end
        end
    end
    return profile_dir
end
