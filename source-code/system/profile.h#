pub fn db_get(d: GenerationsDb, number: int) -> Generation? is
    let mut i: int = 0
    while i < d.generations.len() is
        if d.generations[i].number == number is return d.generations[i] end
        i += 1
    end
    return nil
end

pub fn db_current_gen(d: GenerationsDb) -> Generation? is
    return db_get(d, d.current)
end

pub fn db_next_number(d: GenerationsDb) -> int is
    let mut mx: int = 0
    let mut i: int = 0
    while i < d.generations.len() is
        if d.generations[i].number > mx is mx = d.generations[i].number end
        i += 1
    end
    return mx + 1
end

;; Numer aktywnej generacji wg dowiazania `active`.
pub fn db_active_num(d: GenerationsDb) -> int? is
    return read_active_gen()
end

;; ── JSON: czytanie ───────────────────────────────────────────────────────

struct PkgParsed is
    pub pkg: GenPackage
    pub pos: int
    pub ok:  bool
end

struct GenParsed is
    pub gen: Generation
    pub pos: int
    pub ok:  bool
end

fn num_of(tok: string) -> int is
    if !jsonlite::is_word_tok(tok) is return 0 end
    let t: string = jsonlite::tok_text(tok)
    if t != "" && str::is_numeric(t) is return conv::str_to_int(t) end
    return 0
end

fn parse_package(toks: [string], start: int) -> PkgParsed is
    let mut p: GenPackage = GenPackage { name: "", version: "", store_hash: "" }
    let mut pos: int = start
    if pos >= toks.len() || toks[pos] != "{" is return PkgParsed { pkg: p, pos: pos, ok: false } end
    pos += 1
    while pos < toks.len() && toks[pos] != "}" is
        if !jsonlite::is_string_tok(toks[pos]) || pos + 2 >= toks.len() is
            return PkgParsed { pkg: p, pos: pos, ok: false }
        end
        let key: string = jsonlite::tok_text(toks[pos])
        let vpos: int = pos + 2
        let v: string = toks[vpos]
        if key == "name" && jsonlite::is_string_tok(v) is p.name = jsonlite::tok_text(v) end
        if key == "version" && jsonlite::is_string_tok(v) is p.version = jsonlite::tok_text(v) end
        if key == "store_hash" && jsonlite::is_string_tok(v) is p.store_hash = jsonlite::tok_text(v) end
        let next: int = jsonlite::skip_value(toks, vpos)
        if next < 0 is return PkgParsed { pkg: p, pos: pos, ok: false } end
        pos = next
        if pos < toks.len() && toks[pos] == "," is pos += 1 end
    end
    if pos >= toks.len() is return PkgParsed { pkg: p, pos: pos, ok: false } end
    return PkgParsed { pkg: p, pos: pos + 1, ok: true }
end

fn parse_generation(toks: [string], start: int) -> GenParsed is
    let none_pk: [GenPackage] = []
    let mut g: Generation = Generation { number: 0, timestamp: "", packages: none_pk, note: nil, state: nil }
    let mut pos: int = start
    if pos >= toks.len() || toks[pos] != "{" is return GenParsed { gen: g, pos: pos, ok: false } end
    pos += 1
    while pos < toks.len() && toks[pos] != "}" is
        if !jsonlite::is_string_tok(toks[pos]) || pos + 2 >= toks.len() is
            return GenParsed { gen: g, pos: pos, ok: false }
        end
        let key: string = jsonlite::tok_text(toks[pos])
        let vpos: int = pos + 2
        let v: string = toks[vpos]
        if key == "number" is
            g.number = num_of(v)
        elsif key == "timestamp" && jsonlite::is_string_tok(v) is
            g.timestamp = jsonlite::tok_text(v)
        elsif key == "note" && jsonlite::is_string_tok(v) is
            g.note = jsonlite::tok_text(v)
        elsif key == "state" && jsonlite::is_string_tok(v) is
            g.state = jsonlite::tok_text(v)
        elsif key == "packages" && v == "[" is
            let mut pkgs: [GenPackage] = []
            let mut ppos: int = vpos + 1
            while ppos < toks.len() && toks[ppos] != "]" is
                let pr: PkgParsed = parse_package(toks, ppos)
                if !pr.ok is return GenParsed { gen: g, pos: ppos, ok: false } end
                pkgs.push(pr.pkg)
                ppos = pr.pos
                if ppos < toks.len() && toks[ppos] == "," is ppos += 1 end
            end
            g.packages = pkgs
        end
        let next: int = jsonlite::skip_value(toks, vpos)
        if next < 0 is return GenParsed { gen: g, pos: pos, ok: false } end
        pos = next
        if pos < toks.len() && toks[pos] == "," is pos += 1 end
    end
    if pos >= toks.len() is return GenParsed { gen: g, pos: pos, ok: false } end
    return GenParsed { gen: g, pos: pos + 1, ok: true }
end

;; "" = Ok.
pub fn parse_generations_json(text: string) -> LoadResult is
    let toks: [string] = jsonlite::tokenize(text)
    if toks.len() == 0 || toks[0] != "{" is
        return LoadResult { db: db_empty(), err: "Parsing generations.json" }
    end
    let mut d: GenerationsDb = db_empty()
    let mut gens: [Generation] = []
    let mut pos: int = 1
    while pos < toks.len() && toks[pos] != "}" is
        if !jsonlite::is_string_tok(toks[pos]) || pos + 2 >= toks.len() is
            return LoadResult { db: db_empty(), err: "Parsing generations.json" }
        end
        let key: string = jsonlite::tok_text(toks[pos])
        let vpos: int = pos + 2
        let v: string = toks[vpos]
        if key == "current" is
            d.current = num_of(v)
        elsif key == "pending" is
            if jsonlite::is_word_tok(v) && !jsonlite::is_null_tok(v) is d.pending = num_of(v) end
        elsif key == "generations" && v == "[" is
            let mut gpos: int = vpos + 1
            while gpos < toks.len() && toks[gpos] != "]" is
                let gr: GenParsed = parse_generation(toks, gpos)
                if !gr.ok is return LoadResult { db: db_empty(), err: "Parsing generations.json" } end
                gens.push(gr.gen)
                gpos = gr.pos
                if gpos < toks.len() && toks[gpos] == "," is gpos += 1 end
            end
        end
        let next: int = jsonlite::skip_value(toks, vpos)
        if next < 0 is return LoadResult { db: db_empty(), err: "Parsing generations.json" } end
        pos = next
        if pos < toks.len() && toks[pos] == "," is pos += 1 end
    end
    d.generations = gens
    return LoadResult { db: d, err: "" }
end

;; Brak pliku => pusta baza.
pub fn db_load() -> LoadResult is
    let file: string = generations_file()
    if !fs::exists(file) is return LoadResult { db: db_empty(), err: "" } end
    let r: LoadResult = parse_generations_json(fs::read(file))
    if r.err != "" is return LoadResult { db: db_empty(), err: r.err } end
    return r
end

;; Wersja tolerancyjna: zepsuty JSON => pusta baza, bez bledu.
pub fn db_load_from(file: string) -> GenerationsDb is
    if !fs::exists(file) is return db_empty() end
    let r: LoadResult = parse_generations_json(fs::read(file))
    if r.err != "" is return db_empty() end
    return r.db
end

;; ── JSON: zapis (format `serde_json::to_string_pretty`) ──────────────────

fn gen_to_json(g: Generation) -> string is
    let mut out: string = "    {\n"
    out = out + "      \"number\": " + to_string(g.number) + ",\n"
    out = out + "      \"timestamp\": \"" + jsonlite::escape(g.timestamp) + "\",\n"
    if g.packages.len() == 0 is
        out = out + "      \"packages\": [],\n"
    else is
        out = out + "      \"packages\": [\n"
        let mut i: int = 0
        while i < g.packages.len() is
            let p: GenPackage = g.packages[i]
            out = out + "        {\n"
            out = out + "          \"name\": \"" + jsonlite::escape(p.name) + "\",\n"
            out = out + "          \"version\": \"" + jsonlite::escape(p.version) + "\",\n"
            out = out + "          \"store_hash\": \"" + jsonlite::escape(p.store_hash) + "\"\n"
            out = out + "        }"
            if i + 1 < g.packages.len() is out = out + "," end
            out = out + "\n"
            i += 1
        end
        out = out + "      ],\n"
    end
    out = out + "      \"note\": " + jsonlite::str_or_null(g.note) + ",\n"
    out = out + "      \"state\": " + jsonlite::str_or_null(g.state) + "\n"
    out = out + "    }"
    return out
end

pub fn generations_to_json(d: GenerationsDb) -> string is
    let mut out: string = "{\n"
    out = out + "  \"current\": " + to_string(d.current) + ",\n"
    if d.pending == nil is
        out = out + "  \"pending\": null,\n"
    else is
        let pn: int = d.pending
        out = out + "  \"pending\": " + to_string(pn) + ",\n"
    end
    if d.generations.len() == 0 is
        out = out + "  \"generations\": []\n"
    else is
        out = out + "  \"generations\": [\n"
        let mut i: int = 0
        while i < d.generations.len() is
            out = out + gen_to_json(d.generations[i])
            if i + 1 < d.generations.len() is out = out + "," end
            out = out + "\n"
            i += 1
        end
        out = out + "  ]\n"
    end
    out = out + "}"
    return out
end

;; Zapis atomowy: *.tmp + rename. "" = Ok.
pub fn db_save(d: GenerationsDb) -> string is
    let file: string = generations_file()
    let dir: string = compat::path_parent(file)
    if dir != "" && !fs::exists(dir) is fs::mkdir(dir) end
    let tmp: string = file + ".tmp"
    fs::write(tmp, generations_to_json(d))
    fs::rename(tmp, file)
    return ""
end

;; Rust: `path.with_extension("tmp")` (zastepuje rozszerzenie).
pub fn db_save_to(d: GenerationsDb, file: string) -> string is
    let dir: string = compat::path_parent(file)
    if dir != "" && !fs::exists(dir) is fs::mkdir(dir) end
    let tmp: string = compat::path_with_extension(file, "tmp")
    fs::write(tmp, generations_to_json(d))
    fs::rename(tmp, file)
    return ""
end

