pub fn verify_boot_integrity(gen_number: int) -> string is
    let lr: BootLoad = boot_load()
    if lr.err != "" is return lr.err end
    let entry: BootHashEntry? = boot_get_gen(lr.db, gen_number)
    if entry == nil is
        log::warn("boot-integrity: no recorded hash for gen-" + to_string(gen_number) + ", skipping")
        return ""
    end
    let e: BootHashEntry = entry
    let h: HashResult = hash_generation(gen_number)
    if h.err != "" is return h.err end
    if h.hash != e.hash is
        return "BOOT INTEGRITY VIOLATION: gen-" + to_string(gen_number) + " hash mismatch!\n  recorded: " + e.hash +
            "\n  actual:   " + h.hash
    end
    log::info("boot-integrity: gen-" + to_string(gen_number) + " OK (" + str::slice(h.hash, 0, 16) + "…)")
    return ""
end

