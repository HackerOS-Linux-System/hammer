use "std -> strings" from "str"

mod internal
mod ui
mod oci

;; hammer -> oci::cmd::oci_cmd_install   (port cmd/install.rs)
;; Odejscia: jak w deploy (lock_release na kazdej sciezce); sesja overlay
;; jest niemutowalna — `end_session`/`discard_session` zwracaja nowa.
;; DODANE wzgledem Rust: gdy `flatten_to`/commit zawiodą po zamontowaniu,
;; sesja jest odmontowywana (Rust zostawial zamontowany overlay do `cleanup
;; --repair`).

fn install_locked(names: [string], cfg: oci_types::Config, lock: oci_transaction_lock::TransactionLock) -> string is
    let sr: oci_sysroot::SysrootResult = oci_sysroot::sysroot_open(cfg.sysroot_path, cfg.ostree_repo_path, cfg.osname)
    if sr.err != "" is return sr.err end
    let sysroot: oci_sysroot::Sysroot = sr.sysroot
    let booted: oci_sysroot::BootedResult = oci_sysroot::booted_deployment(sysroot)
    if booted.err != "" is return booted.err end
    if !booted.found is return "No booted deployment. Run 'hammer oci deploy <image-ref>' first." end
    let current: oci_types::Deployment = booted.dep
    let lm: oci_sysroot::LayerMeta = oci_sysroot::read_layer_metadata(sysroot, current.checksum)
    let origin: string = if lm.origin == "" then current.origin_refspec else lm.origin
    let mut existing: [oci_types::PackageLayer] = lm.layers

    write("  " + ui::dim("·") + " Checking out current deployment…")
    let lower_dir: string = compat::path_join(cfg.overlay_work_dir, "lower-checkout")
    let rr: oci_ostree_repo::RepoResult = oci_ostree_repo::repo_open(cfg.ostree_repo_path)
    if rr.err != "" is return rr.err end
    let ce: string = oci_ostree_repo::checkout_commit(rr.repo, current.checksum, lower_dir)
    if ce != "" is return ce end

    let bs: oci_overlay::SessionResult = oci_overlay::begin_session(cfg.overlay_work_dir, lower_dir)
    if bs.err != "" is return bs.err end
    let mut session: oci_overlay::OverlaySession = bs.session
    let be: string = oci_overlay::bind_mount_virtual_fs(session)
    if be != "" is
        oci_overlay::unbind_virtual_fs(session)
        oci_overlay::discard_session(session)
        return be
    end

    write("  " + ui::bright_cyan_bold("↓") + " Resolving and installing: " + ui::bold(str::join(names, ", ")))
    let ir: oci_deb_layer::InstallResult = oci_deb_layer::install_packages(cfg, session, names)
    oci_overlay::unbind_virtual_fs(session)

    if ir.err != "" is
        oci_overlay::discard_session(session)
        oci_transaction_lock::mark_complete(lock)
        return ir.err
    end

    write("  " + ui::dim("·") + " Committing new layer to OSTree…")
    let flat_dir: string = compat::path_join(cfg.overlay_work_dir, "flat-commit")
    let fe: string = oci_overlay::flatten_to(session, flat_dir)
    if fe != "" is
        oci_overlay::discard_session(session)
        return fe
    end
    let es: oci_overlay::SessionResult = oci_overlay::end_session(session)
    if es.err != "" is return es.err end
    session = es.session

    let cr: oci_ostree_repo::CommitResult = oci_ostree_repo::commit_directory(rr.repo, flat_dir, oci_types::layer_ref(origin), "Install: " + str::join(names, ", "), "")
    if cr.err != "" is return cr.err end
    oci_process::run_capture("rm", ["-rf", flat_dir, lower_dir])

    let mut i: int = 0
    while i < ir.layers.len() is
        let mut known: bool = false
        let mut k: int = 0
        while k < existing.len() is
            if existing[k].name == ir.layers[i].name is known = true end
            k += 1
        end
        if !known is existing.push(ir.layers[i]) end
        i += 1
    end

    let result: oci_types::TransactionResult = oci_sysroot::deploy_commit(sysroot, cr.checksum, origin, existing)
    oci_transaction_lock::mark_complete(lock)
    if !result.success is return "Install failed: " + result.error_message end
    write("  " + ui::bright_green_bold("✔") + " Installed " + ui::bold(str::join(names, ", ")) + " — reboot to activate.")
    return ""
end

pub fn run(args: [string], cfg: oci_types::Config) -> string is
    if args.len() == 0 is return "Usage: hammer oci install <pkg> [pkg...]" end
    let lr: oci_transaction_lock::LockResult = oci_transaction_lock::lock_acquire(cfg.overlay_work_dir)
    if lr.err != "" is return lr.err end
    let e: string = install_locked(args, cfg, lr.lock)
    oci_transaction_lock::lock_release(lr.lock)
    return e
end
