;; hammer -> oci::cmd::oci_cmd_rebase   (port cmd/rebase.rs)
;; Odejscia: jak w install/deploy.

fn rebase_locked(new_image_ref: string, cfg: oci_types::Config, lock: oci_transaction_lock::TransactionLock) -> string is
    let sr: oci_sysroot::SysrootResult = oci_sysroot::sysroot_open(cfg.sysroot_path, cfg.ostree_repo_path, cfg.osname)
    if sr.err != "" is return sr.err end
    let sysroot: oci_sysroot::Sysroot = sr.sysroot
    let booted: oci_sysroot::BootedResult = oci_sysroot::booted_deployment(sysroot)
    if booted.err != "" is return booted.err end
    if !booted.found is return "No booted deployment. Use 'hammer oci deploy' for the first install." end
    let lm: oci_sysroot::LayerMeta = oci_sysroot::read_layer_metadata(sysroot, booted.dep.checksum)
    let mut names: [string] = []
    let mut k: int = 0
    while k < lm.layers.len() is
        names.push(lm.layers[k].name)
        k += 1
    end

    write("  " + ui::bright_cyan_bold("↓") + " Pulling new base " + ui::bold(new_image_ref) + "…")
    let pull: oci_puller::PullResult = oci_puller::pull_and_unpack(compat::path_join(cfg.overlay_work_dir, "pull"), new_image_ref)
    if pull.err != "" is return pull.err end
    let base: string = pull.rootfs

    let rr: oci_ostree_repo::RepoResult = oci_ostree_repo::repo_open(cfg.ostree_repo_path)
    if rr.err != "" is return rr.err end
    let new_origin: string = "hammer-oci:" + new_image_ref

    if names.len() == 0 is
        let cr: oci_ostree_repo::CommitResult = oci_ostree_repo::commit_directory(rr.repo, base, oci_types::layer_ref(new_origin), "Rebase to " + new_image_ref, "")
        if cr.err != "" is return cr.err end
        oci_process::run_capture("rm", ["-rf", base])
        let none: [oci_types::PackageLayer] = []
        let result: oci_types::TransactionResult = oci_sysroot::deploy_commit(sysroot, cr.checksum, new_origin, none)
        oci_transaction_lock::mark_complete(lock)
        if !result.success is return "Rebase failed: " + result.error_message end
        write("  " + ui::bright_green_bold("✔") + " Rebased to " + ui::bold(new_image_ref) + " — reboot to activate.")
        return ""
    end

    write("  " + ui::dim("·") + " Re-applying " + to_string(names.len()) + " layered package(s): " + str::join(names, ", "))
    let bs: oci_overlay::SessionResult = oci_overlay::begin_session(cfg.overlay_work_dir, base)
    if bs.err != "" is return bs.err end
    let mut session: oci_overlay::OverlaySession = bs.session
    let be: string = oci_overlay::bind_mount_virtual_fs(session)
    if be != "" is
        oci_overlay::unbind_virtual_fs(session)
        oci_overlay::discard_session(session)
        return be
    end

    let ir: oci_deb_layer::InstallResult = oci_deb_layer::install_packages(cfg, session, names)
    oci_overlay::unbind_virtual_fs(session)
    if ir.err != "" is
        oci_overlay::discard_session(session)
        oci_process::run_capture("rm", ["-rf", base])
        oci_transaction_lock::mark_complete(lock)
        return ir.err
    end

    let flat_dir: string = compat::path_join(cfg.overlay_work_dir, "flat-commit")
    let fe: string = oci_overlay::flatten_to(session, flat_dir)
    if fe != "" is
        oci_overlay::discard_session(session)
        return fe
    end
    let es: oci_overlay::SessionResult = oci_overlay::end_session(session)
    if es.err != "" is return es.err end
    session = es.session
    oci_process::run_capture("rm", ["-rf", base])

    let cr2: oci_ostree_repo::CommitResult = oci_ostree_repo::commit_directory(rr.repo, flat_dir, oci_types::layer_ref(new_origin), "Rebase to " + new_image_ref + " (+" + to_string(ir.layers.len()) + " layers)", "")
    if cr2.err != "" is return cr2.err end
    oci_process::run_capture("rm", ["-rf", flat_dir])

    let result2: oci_types::TransactionResult = oci_sysroot::deploy_commit(sysroot, cr2.checksum, new_origin, ir.layers)
    oci_transaction_lock::mark_complete(lock)
    if !result2.success is return "Rebase failed: " + result2.error_message end
    write("  " + ui::bright_green_bold("✔") + " Rebased to " + ui::bold(new_image_ref) + " with " + to_string(ir.layers.len()) + " layer(s) — reboot to activate.")
    return ""
end

pub fn run(args: [string], cfg: oci_types::Config) -> string is
    if args.len() == 0 is return "Usage: hammer oci rebase <new-image-ref>" end
    let lr: oci_transaction_lock::LockResult = oci_transaction_lock::lock_acquire(cfg.overlay_work_dir)
    if lr.err != "" is return lr.err end
    let e: string = rebase_locked(args[0], cfg, lr.lock)
    oci_transaction_lock::lock_release(lr.lock)
    return e
end
