use "std -> fs" from "fs"

mod internal
mod ui
mod oci

;; hammer -> oci::cmd::oci_cmd_initramfs   (port cmd/initramfs.rs)

pub fn run(args: [string], cfg: oci_types::Config) -> string is
    let sr: oci_sysroot::SysrootResult = oci_sysroot::sysroot_open(cfg.sysroot_path, cfg.ostree_repo_path, cfg.osname)
    if sr.err != "" is return sr.err end
    let booted: oci_sysroot::BootedResult = oci_sysroot::booted_deployment(sr.sysroot)
    if booted.err != "" is return booted.err end
    if !booted.found is return "No booted deployment." end
    let dep_path: string = oci_sysroot::deployment_path(sr.sysroot, booted.dep)
    if !fs::exists(dep_path) is return "Deployment path " + dep_path + " does not exist on disk." end

    write("  " + ui::dim("·") + " Regenerating initramfs in " + dep_path + "…")
    let e: string = oci_process::run_inherit("chroot", [dep_path, "update-initramfs", "-u", "-k", "all"])
    if e != "" is return e end
    write("  " + ui::bright_green_bold("✔") + " initramfs regenerated. Note: OSTree deployments are content-addressed —")
    write("    this changes files in place on the *existing* deployment checkout; run")
    write("    'hammer oci install <noop-pkg>' or re-deploy to persist it as a new, committed generation.")
    return ""
end
