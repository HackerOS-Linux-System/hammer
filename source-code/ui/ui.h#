;; hammer -> ui::ui
;;
;; Port of source-code/ui/ui.rs (Rust) to H#: naglowek, bledy, potwierdzenie,
;; rozmiary, wyszukiwanie, info o pakiecie, historia, wpis listy.
;; To tez centralny zestaw KOLOROW ANSI (`bold`, `dim`, `cyan`, ...), ktory
;; zastepuje lokalne helpery w `pkg/*.h#` (przy okazji kolejnej
;; przerobki tych plikow: `ui::cyan(..)` zamiast lokalnego `cyan(..)`).
;;
;; ── NIE przepisane (czekaja na moduly, ktorych typy biora w argumentach) ─
;;   (wszystko przepisane: `print_transaction_table/summary` i `print_diff` sa
;;   na koncu pliku, po przepisaniu `pkg/solver/` i `diff`.)
;; (print_activation_result / print_generations / print_status — juz sa,
;;  po przepisaniu `system/profile`.)
;;
;; ── Odejscia od oryginalu ───────────────────────────────────────────────
;; 1. `owo_colors` -> kody ANSI; jak w Rust (owo-colors przekazuje
;;    specyfikator szerokosci do wartosci), kolumny dopelniamy WIDOCZNYM
;;    tekstem, a dopiero potem kolorujemy: `cyan(pad_right(x, 16))`.
;;    `fmt::pad_right` liczy `len()` (bajty) — dla nazw ASCII to samo co
;;    znaki; dla UTF-8 (np. opis) kolumny moga sie przesunac.
;; 2. `env!("CARGO_PKG_VERSION")` -> `log::hammer_version()`.
;; 3. `Result<bool>` (confirm) -> `bool`; blad czytania stdin == odpowiedz
;;    pusta (czyli "tak", jak Enter w oryginale).
;; 4. `eprintln!` -> `eprint_line` przez `printf ... >&2` (std nie ma
;;    stderr). `io::read_line` jest LLVM-owe, ale `read_char` nie — uzywam
;;    tylko `read_line`.
;; 5. Znacznik czasu w historii: baza trzyma RFC3339 ("YYYY-MM-DDTHH:MM:SSZ"),
;;    `format("%Y-%m-%d %H:%M")` -> wyciecie znakow 0..10 i 11..16.
;; 6. `take(n)` po znakach -> `take_chars` po bajtach (opisy sa glownie ASCII).

;; ── Kolory ───────────────────────────────────────────────────────────────

;; Wszystkie kolory przechodza przez biblioteke `colors` (bit): automatyczne
;; wykrywanie terminala (NO_COLOR, CLICOLOR, FORCE_COLOR, TERM=dumb,
;; COLORTERM), zubazanie truecolor -> 256 -> 16 i poprawne zagniezdzanie.
;; Nazwy funkcji zostaly bez zmian, wiec reszta portu (`ui::cyan(..)` itd.)
;; dziala jak dotad.

;; Surowy kod SGR — TYLKO dla kodow, ktorych `colors` nie wystawia; uwzglednia
;; wykrycie terminala (przy NO_COLOR zwraca tekst bez zmian).
pub fn c(code: string, s: string) -> string is
    if !colors::support::enabled() is return s end
    return "\x1b[" + code + "m" + s + "\x1b[0m"
end

