;; Puste/Enter, "y", "yes" => true.
pub fn confirm(prompt: string) -> bool is
    let line: string = io::read_line("\n  " + bold(prompt) + " [Y/n] ")
    let t: string = str::to_lower(str::trim(line))
    return t == "" || t == "y" || t == "yes"
end

;; 0 -> "" (jak w Rust). Arytmetyka calkowita, wyniki zgodne z `{:.1}`/`{:.0}`
;; na zaokragleniu polowek w gore (sprawdzone na 7 wartosciach).
pub fn human_size(nbytes: int) -> string is
    if nbytes >= 1073741824 is return tenths(nbytes, 1073741824) + " GiB" end
    if nbytes >= 1048576 is return tenths(nbytes, 1048576) + " MiB" end
    if nbytes >= 1024 is return to_string((nbytes + 512) / 1024) + " KiB" end
    if nbytes > 0 is return to_string(nbytes) + " B" end
    return ""
end

fn tenths(nbytes: int, div: int) -> string is
    let t: int = (nbytes * 10 + div / 2) / div
    return to_string(t / 10) + "." + to_string(t % 10)
end

