;; ── Aktywacja ────────────────────────────────────────────────────────────

pub fn print_activation_result(r: profile::ActivationResult) is
    write("")
    write("  " + bright_cyan_bold("⬡") + "  Boot activation complete")
    write("  " + rule(60))

    if r.already_active is
        write("  " + dim("·") + "  gen-" + to_string(r.gen_number) + " already active — relinking binaries")
    else is
        write("  " + bold(pad("Activated generation:", 28)) + " gen-" + bright_green_bold(to_string(r.gen_number)))
    end

    if r.packages_linked > 0 is
        write("  " + bold(pad("Binaries linked to PATH:", 28)) + " " + bright_green(to_string(r.packages_linked)))
    else is
        write("  " + bold(pad("Binaries linked to PATH:", 28)) + " " +
              yellow("0 — run `hammer relink` if commands are missing"))
    end

    if r.scripts_failed.len() > 0 is
        write("")
        write("  " + yellow_bold("!") + " " + to_string(r.scripts_failed.len()) + " postinst script(s) failed:")
        let mut i: int = 0
        while i < r.scripts_failed.len() is
            write("    " + yellow("·") + " " + yellow(r.scripts_failed[i]))
            i += 1
        end
        write("  Try: " + cyan("hammer fix-broken"))
    end
    write("")
end

;; ── Status ───────────────────────────────────────────────────────────────

pub fn print_status(idb: db::InstalledDb) is
    write("")
    write("  " + bright_cyan_bold("⬡") + "  hammer status")
    write("  " + rule(60))
    write("  " + bold(pad("Installed packages:", 26)) + " " + cyan_bold(to_string(idb.count())))
    let lr: profile::LoadResult = profile::db_load()
    if lr.err == "" is
        let gdb: profile::GenerationsDb = lr.db
        write("  " + bold(pad("Current generation:", 26)) + " gen-" + bright_green(to_string(gdb.current)))
        if gdb.pending != nil is
            let n: int = gdb.pending
            write("  " + bold(pad("Pending (on reboot):", 26)) + " gen-" + yellow(to_string(n)) + " " +
                  dim("(run `hammer diff` to see changes)"))
        end
        write("  " + bold(pad("Total generations:", 26)) + " " + dim(to_string(gdb.generations.len())))
    end
end

;; ── Generacje ────────────────────────────────────────────────────────────

;; Sortowanie malejaco po numerze (wstawianie, stabilne).
fn sort_gens_desc(items: [profile::Generation]) -> [profile::Generation] is
    let mut a: [profile::Generation] = items
    let mut i: int = 1
    while i < a.len() is
        let cur: profile::Generation = a[i]
        let mut j: int = i - 1
        while j >= 0 && a[j].number < cur.number is
            a[j + 1] = a[j]
            j -= 1
        end
        a[j + 1] = cur
        i += 1
    end
    return a
end

pub fn print_generations(gdb: profile::GenerationsDb) is
    write("")
    write("  " + bright_cyan_bold("⬡") + "  Generations")
    write("  " + rule(70))
    write("  " + bold(pad("Gen", 8)) + " " + bold(pad("Date", 22)) + " " + bold(pad("Pkgs", 8)) + " " + bold("Note"))
    write("  " + rule(70))
    let gens: [profile::Generation] = sort_gens_desc(gdb.generations)
    let mut i: int = 0
    while i < gens.len() is
        let g: profile::Generation = gens[i]
        i += 1
        let active: bool = g.number == gdb.current
        let pending: bool = gdb.pending != nil && gdb.pending == g.number
        let mut marker: string = ""
        if active is
            marker = bright_green(" ← active")
        elsif pending is
            marker = yellow(" ← pending")
        end
        let ts: string = format_ts(g.timestamp)
        let mut note: string = ""
        if g.note != nil is
            let nt: string = g.note
            note = take_chars(nt, 36)
        end
        let gen_label: string = pad("gen-" + to_string(g.number), 8)
        let gen_str: string = if active then c("1;92", gen_label) else dim(gen_label)
        write("  " + gen_str + " " + dim(pad(ts, 22)) + " " + cyan(pad(to_string(g.packages.len()), 8)) + " " + dim(note) + marker)
    end
    write("  " + rule(70))
    write("")
    write("  Rollback: " + cyan("hammer rollback") + "     Switch: " + cyan("hammer gen switch <N>"))
end


;; ── Diff (ui.rs::print_diff — wariant skrocony; pelny jest w internal/diff.h#) ──

fn diff_ver_or_q(v: string?) -> string is
    if v == nil is return "?" end
    let s: string = v
    return s
end

pub fn print_diff(d: diff::GenDiff) is
    if diff::diff_is_empty(d) is
        write("  " + dim("·") + " No changes between gen-" + to_string(d.from_gen) + " and gen-" + to_string(d.to_gen) + ".")
        return
    end
    let mut i: int = 0
    while i < d.pkg_changes.len() is
        let c: diff::PkgChange = d.pkg_changes[i]
        ;; Wzorce `match` nie przyjmuja kwalifikatora modulu (`diff::ChangeKind::X`
        ;; to 3 segmenty), wiec rozrozniamy po etykiecie z `diff::kind_label`.
        let k: string = diff::kind_label(c.kind)
        if k == "added" is
            write("  " + bright_green("++") + " " + bold(c.name) + "  " + green(diff_ver_or_q(c.to_ver)))
        elsif k == "removed" is
            write("  " + red("--") + " " + bold(c.name) + "  " + dim(diff_ver_or_q(c.from_ver)))
        elsif k == "upgraded" is
            write("  " + bright_yellow("~~") + " " + bold(c.name) + ":  " + dim(diff_ver_or_q(c.from_ver)) + " → " + bright_yellow(diff_ver_or_q(c.to_ver)))
        else is
            write("  " + red("↓↓") + " " + bold(c.name) + ":  " + dim(diff_ver_or_q(c.from_ver)) + " → " + red(diff_ver_or_q(c.to_ver)))
        end
        i += 1
    end
    write("")
    write("  " + bold("Summary:") + " +" + green(to_string(diff::n_added(d))) + "  ↑" + yellow(to_string(diff::n_upgraded(d))) + "  -" + red(to_string(diff::n_removed(d))))
end

;; ── Tabela transakcji (ui.rs::print_transaction_table / _summary) ────────

fn tx_rule(n: int) -> string is
    return "  " + dim(str::repeat("─", n))
end

fn dl_size(p: package::Package) -> string is
    let n: int = if p.download_size == nil then 0 else p.download_size
    return human_size(n)
end

;; Kolumny jak `{:<36} {:<16} {:<10} {}` — dopelnienie na tekscie BEZ kolorow.
pub fn print_transaction_table(plan: solver::TransactionPlan, arch: string) is
    if plan.to_install.len() > 0 is
        write("")
        write("  " + bold("Packages to install:"))
        write(tx_rule(80))
        let mut i: int = 0
        while i < plan.to_install.len() is
            let pkg: package::Package = plan.to_install[i]
            write("  " + bright_green_bold(fmt::pad_right(pkg.name, 36)) + " " + cyan(fmt::pad_right(pkg.version, 16)) + " " + dim(fmt::pad_right(pkg.architecture, 10)) + " " + dim(dl_size(pkg)))
            i += 1
        end
    end

    if plan.to_upgrade.len() > 0 is
        write("")
        write("  " + bold("Packages to upgrade:"))
        write(tx_rule(80))
        let mut u: int = 0
        while u < plan.to_upgrade.len() is
            let pkg2: package::Package = plan.to_upgrade[u]
            let old_o: string? = solver::plan_upgrade_from(plan, pkg2.name)
            let old: string = if old_o == nil then "?" else old_o
            write("  " + yellow_bold(fmt::pad_right(pkg2.name, 36)) + " " + dim(old) + " → " + bright_yellow(pkg2.version) + " " + dim(dl_size(pkg2)))
            u += 1
        end
    end

    if plan.to_remove.len() > 0 is
        write("")
        write("  " + bold("Packages to remove:"))
        write(tx_rule(80))
        let mut r: int = 0
        while r < plan.to_remove.len() is
            write("  " + red_bold(plan.to_remove[r]))
            r += 1
        end
    end

    if plan.to_autoremove.len() > 0 is
        write("")
        write("  " + bold("Auto-remove (no longer needed):"))
        write(tx_rule(80))
        let mut parts: [string] = []
        let mut a: int = 0
        while a < plan.to_autoremove.len() is
            parts.push(dim(plan.to_autoremove[a]))
            a += 1
        end
        write("  " + str::join(parts, "  "))
    end
end

pub fn print_transaction_summary(plan: solver::TransactionPlan) is
    write("")
    write(tx_rule(60))
    let install: int = plan.to_install.len() + plan.to_upgrade.len()
    let remove: int = plan.to_remove.len() + plan.to_autoremove.len()
    if install > 0 is write("  " + bold(fmt::pad_right("Install/upgrade:", 28)) + " " + bright_green(to_string(install))) end
    if remove > 0 is write("  " + bold(fmt::pad_right("Remove:", 28)) + " " + red(to_string(remove))) end
    if plan.download_bytes > 0 is write("  " + bold(fmt::pad_right("Download:", 28)) + " " + cyan(human_size(plan.download_bytes))) end
    if plan.install_bytes > 0 is write("  " + bold(fmt::pad_right("Installed size:", 28)) + " " + cyan(human_size(plan.install_bytes))) end
    if plan.freed_bytes > 0 is write("  " + bold(fmt::pad_right("Freed:", 28)) + " " + green(human_size(plan.freed_bytes))) end
    let mut w: int = 0
    while w < plan.warnings.len() is
        write("  " + yellow_bold("warn:") + " " + yellow(plan.warnings[w]))
        w += 1
    end
    write("")
end
