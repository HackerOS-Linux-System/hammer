end

;; stderr (std nie ma eprintln).
;; Diagnostyka: `HAMMER_TRACE=1 hammer <cmd>` wypisuje na stderr kolejne etapy (znacznik `[trace]`),
;; zeby bylo widac, gdzie program staje. Bez zmiennej nic nie robi (i nic nie kosztuje poza `sh`).
pub fn trace(stage: string) is
    proc::shell("[ \"$HAMMER_TRACE\" = 1 ] && printf '[trace] %s\\n' '" + str::replace_all(stage, "'", "'\\''") + "' >&2; true")
end

pub fn eprint_line(line: string) is
    proc::shell("printf '%s\n' '" + str::replace_all(line, "'", "'\\''") + "' >&2")
end

;; stderr bez nowej linii (kody ANSI/kursor) — `printf '%s'`, bez interpretacji `\\`.
pub fn eprint_raw(s: string) is
    proc::shell("printf '%s' '" + str::replace_all(s, "'", "'\\''") + "' >&2")
end

fn take_chars(s: string, n: int) -> string is
    if string_len(s) <= n is return s end
    return str::slice(s, 0, n)
end

