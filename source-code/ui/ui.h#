;; ── Wyszukiwanie ─────────────────────────────────────────────────────────

pub fn print_search_header(query: string, count: int) is
    write("")
    if count == 0 is
        write("  " + dim("·") + " No packages found matching '" + bold(query) + "'.")
        write("  Run " + cyan("hammer sync") + " to refresh the index.")
    else is
        let plural: string = if count == 1 then "" else "s"
        write("  " + bright_green("✔") + " " + bold(to_string(count)) + " package" + plural +
              " matching '" + bold(query) + "'")
    end
    write("  " + rule(70))
end

pub fn print_search_result(pkg: package::Package, installed: bool) is
    let inst_mark: string = if installed then bright_green("✔") else dim("·")
    let name_pad: string = pad(pkg.name, 36)
    let name_col: string = if installed then c("1;92", name_pad) else bold(name_pad)
    let mut desc: string = ""
    if pkg.description_short != nil is
        let d: string = pkg.description_short
        desc = take_chars(d, 52)
    end
    write("  " + inst_mark + " " + name_col + " " + cyan(pad(pkg.version, 16)) + "  " + dim(desc))
end

;; ── Info o pakiecie ──────────────────────────────────────────────────────

fn label(s: string) -> string is return bold(pad(s, 20)) end

pub fn print_package_info(pkg: package::Package, installed: bool, installed_version: string?) is
    write("")
    write("  " + c("1;96", pkg.name) + " " + cyan(pkg.version))
    write("  " + rule(60))

    let mut status: string = dim("not installed")
    if installed is
        let up_to_date: bool = installed_version == nil || installed_version == pkg.version
        if up_to_date is
            status = bright_green("installed (up to date)")
        else is
            let iv: string = if installed_version == nil then "?" else installed_version
            status = yellow("installed (" + iv + ") — upgrade available")
        end
    end

    write("  " + label("Status:") + " " + status)
    write("  " + label("Architecture:") + " " + dim(pkg.architecture))
    if pkg.section != nil is
        let s: string = pkg.section
        write("  " + label("Section:") + " " + dim(s))
    end
    if pkg.maintainer != nil is
        let m: string = pkg.maintainer
        write("  " + label("Maintainer:") + " " + dim(m))
    end
    if pkg.installed_size_kb != nil is
        let sz: int = pkg.installed_size_kb
        write("  " + label("Installed size:") + " " + cyan(human_size(sz * 1024)))
    end
    if pkg.description_short != nil is
        let d: string = pkg.description_short
        write("")
        write("  " + bold(d))
    end
    if pkg.description_long != nil is
        let d: string = pkg.description_long
        write("")
        let lines: [string] = str::split(d, "\n")
        let mut i: int = 0
        while i < lines.len() && i < 8 is
            write("  " + dim(str::trim(lines[i])))
            i += 1
        end
    end
    if pkg.depends != nil is
        let deps: string = pkg.depends
        write("")
        write("  " + bold("Depends:"))
        write("  " + dim(deps))
    end
    write("")
end

;; ── Historia ─────────────────────────────────────────────────────────────

;; "2026-09-30T18:13:29Z" -> "2026-09-30 18:13"; inny format zostaje bez zmian.
pub fn format_ts(ts: string) -> string is
    if string_len(ts) >= 16 && string_at(ts, 10) == "T" is
        return str::slice(ts, 0, 10) + " " + str::slice(ts, 11, 16)
    end
    return ts
end

pub fn print_history(entries: [db::HistoryEntry]) is
    write("")
    write("  " + bright_cyan_bold("⬡") + "  Transaction history")
    write("  " + rule(70))
    if entries.len() == 0 is
        write("  " + dim("·") + " No transaction history.")
        return
    end
    let mut i: int = 0
    while i < entries.len() is
        let e: db::HistoryEntry = entries[i]
        i += 1
        let ts: string = format_ts(e.timestamp)
        let op: string = pad(e.action, 12)
        let mut op_col: string = cyan(op)
        if e.action == "install" is
            op_col = bright_green(op)
        elsif e.action == "remove" is
            op_col = red(op)
        elsif e.action == "upgrade" is
            op_col = yellow(op)
        end
        write("  " + dim(ts) + "  " + op_col + " " + bold(pad(e.package, 36)) + " gen-" + cyan(to_string(e.generation)))
    end
end

