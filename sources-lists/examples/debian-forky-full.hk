! Hammer sources list  —  format: .hk  (HackerOS key-value format)
! ─────────────────────────────────────────────────────────────────────
! Przykład: pełna konfiguracja Debian Forky (testing/next stable)
! Zawiera: main + security + updates + backports
!
! Użycie:
!   hammer sources --add debian-forky-full.hk
!   hammer sync

[debian-forky]
-> name       => debian-forky
-> baseurl    => http://deb.debian.org/debian
-> suite      => forky
-> components => ["main", "contrib", "non-free", "non-free-firmware"]
-> arch       => ["amd64"]
-> enabled    => true

[debian-forky-security]
-> name       => debian-forky-security
-> baseurl    => http://security.debian.org/debian-security
-> suite      => forky-security
-> components => ["main", "contrib", "non-free", "non-free-firmware"]
-> arch       => ["amd64"]
-> enabled    => true

[debian-forky-updates]
-> name       => debian-forky-updates
-> baseurl    => http://deb.debian.org/debian
-> suite      => forky-updates
-> components => ["main", "contrib"]
-> arch       => ["amd64"]
-> enabled    => true

[debian-forky-backports]
-> name       => debian-forky-backports
-> baseurl    => http://deb.debian.org/debian
-> suite      => forky-backports
-> components => ["main", "contrib"]
-> arch       => ["amd64"]
-> enabled    => false
