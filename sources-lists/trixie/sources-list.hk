! Hammer sources list  —  format: .hk  (HackerOS key-value format)
! ─────────────────────────────────────────────────────────────────────
! Dokumentacja formatu: https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/hk.html
! Składnia:
!   [section-name]          — jedna sekcja = jedno repozytorium
!   -> klucz => wartość     — para klucz/wartość
!   ! komentarz             — linie zaczynające się od ! są ignorowane
!
! Dostępne klucze:
!   name       — nazwa wyświetlana (opcjonalna)
!   baseurl    — bazowy URL repozytorium (wymagany)
!   suite      — nazwa dystrybucji, np. trixie (wymagany)
!   components — lista składowych, np. ["main", "contrib"] (wymagany)
!   arch       — lista architektur, np. ["amd64"] (opcjonalny — domyślnie arch hosta)
!   enabled    — true/false (opcjonalny — domyślnie true)
!   gpgkey     — URL lub ścieżka do klucza GPG (opcjonalny)
!   type       — "deb" lub "deb-src" (opcjonalny — domyślnie deb)
!
! Po edycji uruchom:  hammer sync

[debian-trixie]
-> name       => debian-trixie
-> baseurl    => http://deb.debian.org/debian
-> suite      => trixie
-> components => ["main", "contrib", "non-free", "non-free-firmware"]
-> arch       => ["amd64"]
-> enabled    => true

[debian-trixie-security]
-> name       => debian-trixie-security
-> baseurl    => http://security.debian.org/debian-security
-> suite      => trixie-security
-> components => ["main", "contrib", "non-free", "non-free-firmware"]
-> arch       => ["amd64"]
-> enabled    => true

! Backports — domyślnie wyłączone
! Odkomentuj enabled => true aby włączyć
[debian-trixie-backports]
-> name       => debian-trixie-backports
-> baseurl    => http://deb.debian.org/debian
-> suite      => trixie-backports
-> components => ["main", "contrib", "non-free", "non-free-firmware"]
-> arch       => ["amd64"]
-> enabled    => false
