;; libhammer -> solver
;;
;; DELIBERATE DEVIATION FROM 1:1 PORTING. The Rust original
;; (`libhammer/src/solver.rs`, 772 lines) hand-rolls its own CDCL SAT
;; solver: VSIDS branching, two-watched-literal propagation, 1UIP
;; conflict analysis, LBD-based clause deletion, Luby restarts — a
;; serious, from-scratch implementation that would be pure liability to
;; re-derive by hand in a brand-new language without the Rust version's
;; years of fuzzing/property-test coverage behind it.
;;
;; Per instructions, hammer's H# port uses `satsolv` (H# bindings to the
;; real, battle-tested `libsolv` — the same solver core behind
;; `zypper`/`dnf`/`conda`) instead. This module is therefore a genuine
;; *port of behaviour*, not of source text: it re-expresses "given
;; installed + available packages and a set of install/remove requests,
;; produce an install plan or a conflict report" on top of `satsolv`'s
;; pool/repo/job/solver/transaction API rather than on top of a
;; hand-written clause database. `solver_error.h#`'s `SolverError`/
;; `SolverProblem` types are kept unchanged so every *caller* in the
;; rest of libhammer/hammer still sees the exact same error shape the
;; Rust original produced.
;;
;; KNOWN SIMPLIFICATIONS (documented rather than silently glossed over):
;;   1. OR-alternatives inside one dependency group (`DepGroup.alternatives`,
;;      e.g. Depends: "libcurl4 | libcurl3") collapse to their *first*
;;      alternative. libsolv itself fully supports rich/boolean deps
;;      (`SOLVABLE_PREREQMARKER`, `rel2id` with `REL_OR`), but wiring
;;      that through `satsolv`'s testtags-based `Pkg.requires: [string]`
;;      needs either a `satsolv` API addition or hand-built `rel2id`
;;      calls bypassing testtags — a follow-up, not done here.
;;   2. `resolve()` takes plain package *names* to install/remove
;;      (`job::install_name`/`erase_name`), not version-pinned
;;      requests (`job::install_name_version` exists in `satsolv`
;;      for that and is the natural next step for `hammer install
;;      pkg=1.2.3`).
;;   3. `satsolv::solver::all_problems_as_strings` returns free-text
;;      messages, not structured package lists — every `SolverProblem`
;;      built here has `packages: []` (see solver_error.h#'s doc comment
;;      on that field).

;; One resolved step of an install plan: a concrete package (name,
;; version, arch) the solver decided must end up installed.
pub struct ResolvedStep is
    pub name:    string
    pub version: string
    pub arch:    string
end

;; Outcome of `resolve()` — `Ok` carries the full install plan (existing
;; + newly-pulled-in packages the transaction says must be installed);
;; `Err` carries the same `SolverError` type every other libhammer
;; caller already expects.
pub enum SolveOutcome is
    Ok([ResolvedStep])
    Err(solver_error::SolverError)
end

;; Resolves an install/removal request against a package universe.
;;   - `installed`      packages considered already present (`installed` repo)
;;   - `available`      the full candidate pool from synced repo indices
;;   - `install_names`  package names requested for installation
;;   - `remove_names`   package names requested for removal
;;   - `arch`           target architecture, e.g. "x86_64"/"amd64"
;;   - `allow_downgrade` mirrors `satsolv::solver::allow_downgrade` — hammer
;;                        defaults this to `false` at every call site,
;;                        same as apt/dpkg's default policy.
pub fn resolve(installed: [lhpackage::Package], available: [lhpackage::Package],
                install_names: [string], remove_names: [string],
                arch: string, allow_downgrade: bool) -> SolveOutcome is

    let p: int = pool::new()
    ;; Debian: porownywanie wersji (epoch:upstream-rev) i polityka architektur dpkg — MUSI byc przed set_arch
    if pool::set_disttype(p, pool::DISTTYPE_DEB) < 0 is
        pool::destroy(p)
        return SolveOutcome::Err(solver_error::SolverError::unsat(
            "libsolv zbudowany bez MULTI_SEMANTICS: nie obsluguje semantyki Debiana (przebuduj satsolv: bit upgrade satsolv)"))
    end
    ;; pakiety `Architecture: all` (dokumentacja, skrypty, wiekszosc bibliotek perl/python) musza byc widoczne obok `amd64`:
    ;; libsolv w trybie DEB bierze arch dosłownie, wiec dopisujemy polityke "arch:all"
    let mut pool_arch: string = arch
    if string_find(arch, ":") < 0 is pool_arch = arch + ":all" end
    pool::set_arch(p, pool_arch)

    let known: map::Map<string, string> = known_names(installed, available)
    let system: int = repo::new(p, "installed")
    pool::set_installed_repo(p, system)
    if installed.len() > 0 is
        let sys_pkgs: [repo::Pkg] = to_satsolv_pkgs(installed, known)
        match repo::add_packages(p, system, sys_pkgs) is
            SatResult::Err(msg) => is
                repo::destroy(system, false)
                pool::destroy(p)
                return SolveOutcome::Err(solver_error::SolverError::unsat(
                    "failed to load installed-package state: " + msg))
            end
            SatResult::Ok(rc) => is end
        end
    end
    repo::finalize(system)

    let avail: int = repo::new(p, "available")
    repo::set_priority(avail, 0, 0)
    if available.len() > 0 is
        let avail_pkgs: [repo::Pkg] = to_satsolv_pkgs(available, known)
        match repo::add_packages(p, avail, avail_pkgs) is
            SatResult::Err(msg) => is
                repo::destroy(avail, false)
                repo::destroy(system, false)
                pool::destroy(p)
                return SolveOutcome::Err(solver_error::SolverError::unsat(
                    "failed to load available-package index: " + msg))
            end
            SatResult::Ok(rc) => is end
        end
    end
    repo::finalize(avail)

    pool::create_whatprovides(p)

    let jobs: int = queue::new()
    let mut i: int = 0
    while i < install_names.len() is
        job::install_name(jobs, p, install_names[i])
        i += 1
    end
    i = 0
    while i < remove_names.len() is
        job::erase_name(jobs, p, remove_names[i])
        i += 1
    end

    let s: int = solver::new(p)
    solver::allow_downgrade(s, allow_downgrade)

    let problems: i32 = solver::run(s, jobs)

    if problems > 0 is
        let msgs: [string] = solver::all_problems_as_strings(s)
        let mut probs: [solver_error::SolverProblem] = []
        let mut pi: int = 0
        while pi < array_len(msgs) is
            probs.push(solver_error::SolverProblem { message: msgs[pi], packages: [] })
            pi += 1
        end
        queue::destroy(jobs)
        solver::destroy(s)
        repo::destroy(avail, false)
        repo::destroy(system, false)
        pool::destroy(p)
        return SolveOutcome::Err(solver_error::SolverError::Problems(probs))
    end

    let t: int = transaction::create_from_solver(s)
    let ids: [i32] = transaction::installed_result(t)
    let mut steps: [ResolvedStep] = []
    let mut si: int = 0
    while si < array_len(ids) is
        ;; nazwa / evr / arch wprost z solvable (etykieta "name-evr.arch" jest dla Debiana niejednoznaczna)
        steps.push(ResolvedStep { name: pool::solvable_name(p, ids[si]), version: pool::solvable_evr(p, ids[si]),
                                  arch: pool::solvable_arch(p, ids[si]) })
        si += 1
    end
    transaction::destroy(t)

    queue::destroy(jobs)
    solver::destroy(s)
    repo::destroy(avail, false)
    repo::destroy(system, false)
    pool::destroy(p)

    return SolveOutcome::Ok(steps)
end

;; `pool::solvable_to_str` prints libsolv's conventional
;; `name-version.arch` label (e.g. `"nginx-1.24.0-2.x86_64"`). Splitting
;; it back apart is inherently a little fragile (a package name itself
;; could in principle contain a `-`, which is exactly why libsolv keeps
;; name/version/release/arch as separate solvable fields internally
;; rather than round-tripping through this string) — so this parser is
;; deliberately permissive: on anything it can't confidently split, it
;; keeps the whole label as `name` and leaves `version`/`arch` empty
;; rather than guessing wrong or crashing. A future revision of
;; `satsolv` exposing `solvable_lookup_str`-style structured accessors
;; would let this go away entirely.
fn parse_solvable_label(label: string) -> ResolvedStep is
    let dot: int = string_rfind(label, ".")
    let arch: string = if dot >= 0 then string_slice(label, dot + 1, string_len(label)) else ""
    let head: string = if dot >= 0 then string_slice(label, 0, dot) else label

    let dash: int = string_rfind(head, "-")
    if dash < 0 is
        return ResolvedStep { name: head, version: "", arch: arch }
    end
    let name:    string = string_slice(head, 0, dash)
    let version: string = string_slice(head, dash + 1, string_len(head))
    return ResolvedStep { name: name, version: version, arch: arch }
end

;; Converts hammer `Package`s into `satsolv::repo::Pkg`s for
;; `repo::add_packages`. See the module doc comment's simplification #1
;; for the OR-alternative collapsing.
;; Nazwy znane solverowi: nazwy pakietow + nazwy z `Provides` (do wyboru alternatywy w zaleznosciach).
fn known_names(installed: [lhpackage::Package], available: [lhpackage::Package]) -> map::Map<string, string> is
    let known: map::Map<string, string> = map::Map::new()
    let mut round: int = 0
    while round < 2 is
        let pkgs: [lhpackage::Package] = if round == 0 then installed else available
        let mut i: int = 0
        while i < pkgs.len() is
            known.put(pkgs[i].name, "1")
            let pl: [string] = pkgs[i].provides_list
            let mut k: int = 0
            while k < pl.len() is
                known.put(pl[k], "1")
                k += 1
            end
            i += 1
        end
        round += 1
    end
    return known
end


fn to_satsolv_pkgs(pkgs: [lhpackage::Package], known: map::Map<string, string>) -> [repo::Pkg] is
    let mut out: [repo::Pkg] = []
    let mut i: int = 0
    while i < pkgs.len() is
        out.push(to_satsolv_pkg(pkgs[i], known))
        i += 1
    end
    return out
end

fn to_satsolv_pkg(pkg: lhpackage::Package, known: map::Map<string, string>) -> repo::Pkg is
    ;; release "" => `version` to pelny Debianowy EVR ("1:2.3-4"); satsolv nie dokleja drugiego "-release"
    let mut p: repo::Pkg = repo::new_pkg(pkg.name, pkg.version, "", pkg.architecture)

    p.requires  = dep_field_to_tokens(pkg.depends, known) + dep_field_to_tokens(pkg.pre_depends, known)
    p.provides  = provides_to_tokens(pkg)
    ;; `Breaks` (Debian) dziala dla solvera jak `Conflicts`
    p.conflicts = dep_field_to_tokens(pkg.conflicts, known) + dep_field_to_tokens(pkg.breaks, known)
    p.obsoletes = dep_field_to_tokens(pkg.replaces, known)
    p.recommends = dep_field_to_tokens(pkg.recommends, known)
    p.suggests   = dep_field_to_tokens(pkg.suggests, known)
    return p
end

;; Debian versions are `[epoch:]upstream[-revision]`; libsolv's
;; `Pkg.release` is its own separate field (unlike Debian, which folds
;; the revision into the same version string). We don't actually need
;; a *correct* Debian→RPM-style epoch/release split for solving purposes
;; here — `satsolv`'s `new_pkg` just needs *some* non-empty release
;; token, and the full Debian version string is already carried
;; verbatim in `version` for comparisons — so this only peels off a
;; trailing `-revision` when present, and falls back to `"0"` (never an
;; empty string — `add_packages` rejects empty NVRA tokens, see
;; satsolv's own input validation).
fn extract_release(version: string) -> string is
    let dash: int = string_rfind(version, "-")
    if dash < 0 is return "0" end
    let rev: string = string_slice(version, dash + 1, string_len(version))
    if rev == "" is return "0" end
    return rev
end

;; `Depends: "libssl3 (>= 3.0), libz1g | zlib1g"` → `["libssl3 >= 3.0", "libz1g"]`
;; (see this module's doc comment, simplification #1, for the OR collapse).
fn dep_field_to_tokens(field: string?, known: map::Map<string, string>) -> [string] is
    if field == nil is return [] end
    let f: string = field
    let groups: [lhpackage::DepGroup] = dep::parse_dep_field(f)
    let mut out: [string] = []
    let mut i: int = 0
    while i < groups.len() is
        let alts: [lhpackage::DepAlternative] = groups[i].alternatives
        if alts.len() > 0 is
            ;; grupa `a | b | c`: jak apt — pierwsza alternatywa, KTORA ISTNIEJE w indeksie (nazwa albo provides);
            ;; gdy zadnej nie ma, pierwsza (libsolv zglosi wtedy prawdziwy "nothing provides").
            ;; Podanie libsolv-owi calego OR dawalo inny wybor niz apt (np. pinentry-gnome3 zamiast pinentry-curses
            ;; => ciagnie gtk/gstreamer/mesa) — libsolv nie zna kolejnosci alternatyw.
            let mut pick: int = 0
            let mut a: int = 0
            while a < alts.len() is
                if known.has(alts[a].name) is
                    pick = a
                    a = alts.len()
                else is
                    a += 1
                end
            end
            out.push(alt_to_token(alts[pick]))
        end
        i += 1
    end
    return out
end

;; Operatory wersji Debiana -> skladnia libsolv: `<<` = `<`, `>>` = `>` (`<=`, `>=`, `=` bez zmian).
fn solv_op(op: string) -> string is
    if op == "<<" is return "<" end
    if op == ">>" is return ">" end
    return op
end

fn alt_to_token(alt: lhpackage::DepAlternative) -> string is
    let c: lhpackage::VersionConstraint? = alt.constraint
    if c == nil is return alt.name end
    let c2: lhpackage::VersionConstraint = c
    return alt.name + " " + solv_op(c2.op) + " " + c2.version
end

;; `Provides: foo (= 1.2), bar` -> ["foo = 1.2", "bar"]. Wersjonowane provides sa potrzebne, gdy cos zalezy od
;; `foo (>= 1.0)` spelnianego przez wirtualny pakiet; wczesniej wersje byly gubione (provides_list).
fn provides_to_tokens(pkg: lhpackage::Package) -> [string] is
    if pkg.provides == nil is return pkg.provides_list end
    let raw: string = pkg.provides
    let groups: [lhpackage::DepGroup] = dep::parse_dep_field(raw)
    let mut out: [string] = []
    let mut i: int = 0
    while i < groups.len() is
        let alts: [lhpackage::DepAlternative] = groups[i].alternatives
        if alts.len() > 0 is out.push(alt_to_token(alts[0])) end
        i += 1
    end
    return out
end

;; ── Wygodna struktura wyniku (dla innych pakietow) ───────────────────────
;;
;; `SolveOutcome` to enum zdefiniowany tutaj — rozpakowanie go w innym pakiecie
;; wymaga sciezek typu `solver::SolveOutcome::Ok(..)`. Ta struktura
;; robi `match` TUTAJ i oddaje zwykle pola, zeby hammer (`pkg/solver/libsolv.h#`)
;; mogl z niej korzystac bez dopasowywania wariantow miedzy pakietami.

pub struct SolveSummary is
    ;; true = libsolv rozwiazal zadanie
    pub ok:          bool
    ;; true = NIE udalo sie zaladowac danych do libsolv (to nie jest konflikt
    ;; zaleznosci — wolajacy powinien zostac przy swoim solverze)
    pub load_failed: bool
    ;; zainstalowane wg transakcji (przy ok): nazwa / wersja / architektura
    pub names:       [string]
    pub versions:    [string]
    pub arches:      [string]
    ;; opisy problemow (przy !ok i !load_failed)
    pub problems:    [string]
end

pub fn resolve_summary(installed: [lhpackage::Package], available: [lhpackage::Package],
                       install_names: [string], remove_names: [string],
                       arch: string, allow_downgrade: bool) -> SolveSummary is
    let mut names: [string] = []
    let mut versions: [string] = []
    let mut arches: [string] = []
    let mut problems: [string] = []
    let out: SolveOutcome = resolve(installed, available, install_names, remove_names, arch, allow_downgrade)
    match out is
        SolveOutcome::Ok(steps) => is
            let mut i: int = 0
            while i < steps.len() is
                names.push(steps[i].name)
                versions.push(steps[i].version)
                arches.push(steps[i].arch)
                i += 1
            end
            return SolveSummary { ok: true, load_failed: false, names: names, versions: versions, arches: arches, problems: problems }
        end
        SolveOutcome::Err(e) => is
            match e is
                SolverError::Unsatisfiable(msg) => is
                    let failed: bool = string_starts_with(msg, "failed to load")
                    problems.push(msg)
                    return SolveSummary { ok: false, load_failed: failed, names: names, versions: versions, arches: arches, problems: problems }
                end
                SolverError::Problems(list) => is
                    let mut k: int = 0
                    while k < list.len() is
                        problems.push(list[k].message)
                        k += 1
                    end
                    return SolveSummary { ok: false, load_failed: false, names: names, versions: versions, arches: arches, problems: problems }
                end
            end
        end
    end
end
