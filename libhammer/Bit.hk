[package]
-> name        => libhammer
-> version     => 0.5.0
-> description => Rdzen hammer (parsowanie wersji/zaleznosci/control/.deb, solver, digest, baza zainstalowanych) jako biblioteka H#. Status modul-po-module: PORT_STATUS.md w korzeniu repo.
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => Apache-2.0
-> lang        => h#

[layout]
-> src => src

[lib]
-> output => hlib

[build]
-> link => static

[dependencies]
-> satsolv.version      => newest
-> progress-bar.version => newest
